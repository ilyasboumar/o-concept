---
/**
 * WireHero.astro — THE O CONCEPT — "The Journey of Regeneration"
 * ------------------------------------------------------------------
 * Scroll-driven PRP narrative, mirroring the P-Shot® / O-Shot® story
 * from the site copy: autologous platelet-rich plasma travelling to
 * the tissue that needs it, and reawakening cellular repair.
 *
 *   LOAD           a stream of golden platelet particles is already
 *                  flowing through a translucent vessel — alive at
 *                  first glance.
 *   SCROLL 0→0.6   the camera glides along the vessel, riding with
 *                  the stream.
 *   SCROLL 0.6→1   arrival: a dull, tired cell cluster. As platelets
 *                  reach it, the tissue warms grey → champagne, a
 *                  teal regenerative glow rises, breathing begins,
 *                  and sparkles of repair surround it.
 *
 * Everything is procedural — no model assets. Glassmorphism HUD
 * panels crossfade: PRP stream stats → regeneration markers.
 *
 * Site guards: rAF paused offscreen/hidden tabs, reduced-motion gets
 * a static healed frame with no pin, WebGL disposed on navigation,
 * no [data-count]-style attribute collisions.
 * ------------------------------------------------------------------
 */

interface Props {
  /** Pin duration in viewport heights. */
  scrollLength?: number;
  /** Below this width WebGL is skipped and the CSS fallback shows. */
  minWidth?: number;
  heading?: string;
  eyebrow?: string;
}

const {
  scrollLength = 3,
  minWidth = 860,
  heading = 'Regeneration, delivered.',
  eyebrow = 'The P-Shot® & O-Shot® · Platelet-Rich Plasma',
} = Astro.props;
---

<section
  class="wire-hero relative bg-ink"
  data-scroll-length={scrollLength}
  data-min-width={minWidth}
  style={`height:${(scrollLength + 1) * 100}vh;`}
>
  <div class="wire-hero__pin sticky top-0 h-screen w-full overflow-hidden">
    <!-- CSS fallback: mobile / reduced-motion / no WebGL -->
    <div
      class="wire-hero__fallback absolute inset-0"
      style="background:
        radial-gradient(ellipse 55% 55% at 62% 48%, rgba(201,169,110,0.16), transparent 70%),
        radial-gradient(ellipse 45% 40% at 30% 60%, rgba(110,30,43,0.22), transparent 70%),
        #0a0a0b;"
    >
    </div>

    <canvas
      class="wire-hero__canvas absolute inset-0 h-full w-full opacity-0 transition-opacity duration-1000"
      aria-hidden="true"></canvas>

    <div
      class="pointer-events-none absolute inset-0"
      style="background:linear-gradient(to bottom, rgba(10,10,11,0.55) 0%, transparent 30%, transparent 70%, rgba(10,10,11,0.9) 100%);"
      aria-hidden="true"
    >
    </div>

    <!-- headline -->
    <div class="wrap pointer-events-none relative flex h-full flex-col justify-center">
      <p class="eyebrow wire-hero__eyebrow" style="opacity:0">{eyebrow}</p>
      <h2 class="mt-6 max-w-2xl font-serif text-5xl leading-[1.05] text-cream md:text-7xl">
        {heading.split(' ').map((w) => <span class="wire-hero__word" style="opacity:0">{w}&#8202; </span>)}
      </h2>
    </div>

    <!-- HUD 0 — the PRP stream -->
    <div
      class="wire-hero__hud pointer-events-none absolute right-6 top-1/2 hidden w-64 -translate-y-1/2 lg:block"
      data-hud="0"
      style="opacity:0"
    >
      <div class="wire-hero__glass">
        <div class="flex items-center justify-between">
          <span class="text-[10px] uppercase tracking-[0.3em] text-gold">Platelet-Rich Plasma</span>
          <span class="wire-hero__dot" aria-hidden="true"></span>
        </div>
        <p class="mt-3 font-serif text-4xl text-cream">
          ×5<span class="text-lg text-cream/50"> concentration</span>
        </p>
        <div class="mt-4 h-px w-full bg-cream/10"></div>
        <p class="mt-3 text-xs leading-relaxed text-cream/55">
          Your own growth factors, en route to the tissue that needs them.
        </p>
      </div>
    </div>

    <!-- HUD 1 — regeneration at the target -->
    <div
      class="wire-hero__hud pointer-events-none absolute left-6 bottom-24 hidden w-60 lg:block"
      data-hud="1"
      style="opacity:0"
    >
      <div class="wire-hero__glass">
        <div class="flex items-center justify-between">
          <span class="text-[10px] uppercase tracking-[0.3em] text-teal">Cellular Repair</span>
          <span class="wire-hero__dot" aria-hidden="true"></span>
        </div>
        <div class="mt-4 space-y-3">
          <div>
            <div class="flex justify-between text-[11px] text-cream/60">
              <span>New vessel growth</span><span>+64%</span>
            </div>
            <div class="mt-1 h-1 w-full rounded bg-cream/10">
              <div class="h-full rounded bg-teal" style="width:64%"></div>
            </div>
          </div>
          <div>
            <div class="flex justify-between text-[11px] text-cream/60">
              <span>Tissue response</span><span>+81%</span>
            </div>
            <div class="mt-1 h-1 w-full rounded bg-cream/10">
              <div class="h-full rounded bg-gold" style="width:81%"></div>
            </div>
          </div>
          <div>
            <div class="flex justify-between text-[11px] text-cream/60">
              <span>Sensation markers</span><span>+72%</span>
            </div>
            <div class="mt-1 h-1 w-full rounded bg-cream/10">
              <div class="h-full rounded bg-teal/70" style="width:72%"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 text-[10px] uppercase tracking-[0.35em] text-cream/40" aria-hidden="true">
      Scroll — follow the treatment
    </div>
  </div>
</section>

<style>
  .wire-hero__glass {
    background: rgba(20, 20, 26, 0.45);
    backdrop-filter: blur(14px) saturate(1.1);
    -webkit-backdrop-filter: blur(14px) saturate(1.1);
    border: 1px solid rgba(201, 169, 110, 0.2);
    border-radius: 14px;
    padding: 20px;
    box-shadow: 0 20px 60px -20px rgba(0, 0, 0, 0.7);
  }
  .wire-hero__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-teal, #2dd4bf);
    box-shadow: 0 0 10px 1px rgba(45, 212, 191, 0.7);
    animation: wirePulse 2.4s ease-in-out infinite;
  }
  .wire-hero__word {
    display: inline-block;
  }
  @keyframes wirePulse {
    0%,
    100% {
      opacity: 0.4;
    }
    50% {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wire-hero__dot {
      animation: none;
    }
  }
</style>

<script>
  import * as THREE from "three";
  import { RoomEnvironment } from "three/examples/jsm/environments/RoomEnvironment.js";
  import { mergeGeometries } from "three/examples/jsm/utils/BufferGeometryUtils.js";
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const GOLD = new THREE.Color(0xc9a96e);
  const CREAM = new THREE.Color(0xf4f1ec);
  const TEAL = new THREE.Color(0x2dd4bf);
  const DULL = new THREE.Color(0x55504b); // tired tissue, pre-treatment

  /* round glow sprite — bare PointsMaterial renders hard squares */
  function makeGlowSprite() {
    const c = document.createElement("canvas");
    c.width = c.height = 64;
    const ctx = c.getContext("2d")!;
    const g = ctx.createRadialGradient(32, 32, 0, 32, 32, 32);
    g.addColorStop(0, "rgba(255,255,255,1)");
    g.addColorStop(0.4, "rgba(255,255,255,0.4)");
    g.addColorStop(1, "rgba(255,255,255,0)");
    ctx.fillStyle = g;
    ctx.fillRect(0, 0, 64, 64);
    const t = new THREE.CanvasTexture(c);
    t.colorSpace = THREE.SRGBColorSpace;
    return t;
  }

  /* procedural cell cluster (morula) — the target tissue */
  function makeCellCluster() {
    const geos: THREE.BufferGeometry[] = [];
    const centre = new THREE.IcosahedronGeometry(0.8, 2);
    centre.scale(1, 0.92, 1);
    geos.push(centre);
    const SHELL = 12;
    const GA = Math.PI * (3 - Math.sqrt(5));
    for (let i = 0; i < SHELL; i++) {
      const y = 1 - ((i + 0.5) / SHELL) * 2;
      const rXZ = Math.sqrt(1 - y * y);
      const th = GA * i;
      const dist = 1.04 + (Math.random() - 0.5) * 0.14;
      const rad = 0.52 + Math.random() * 0.14;
      const cell = new THREE.IcosahedronGeometry(rad, 2);
      cell.scale(1, 0.85 + Math.random() * 0.25, 1);
      cell.rotateY(Math.random() * Math.PI);
      cell.translate(Math.cos(th) * rXZ * dist, y * dist, Math.sin(th) * rXZ * dist);
      geos.push(cell);
    }
    return mergeGeometries(geos);
  }

  function initWireHero(section: HTMLElement) {
    const canvas = section.querySelector<HTMLCanvasElement>(".wire-hero__canvas");
    const fallback = section.querySelector<HTMLElement>(".wire-hero__fallback");
    const huds = Array.from(section.querySelectorAll<HTMLElement>(".wire-hero__hud"));
    const words = Array.from(section.querySelectorAll<HTMLElement>(".wire-hero__word"));
    const eyebrow = section.querySelector<HTMLElement>(".wire-hero__eyebrow");
    if (!canvas) return;

    const scrollLength = Number(section.dataset.scrollLength ?? 3);
    const minWidth = Number(section.dataset.minWidth ?? 860);
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const showStatic = () => {
      section.style.height = "100vh";
      [eyebrow, ...words, ...huds].forEach((el) => el && (el.style.opacity = "1"));
    };

    if (window.innerWidth < minWidth) return showStatic();

    let renderer: THREE.WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({
        canvas,
        antialias: true,
        alpha: true,
        powerPreference: "high-performance",
      });
    } catch {
      return showStatic();
    }

    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    renderer.setPixelRatio(dpr);
    renderer.setSize(window.innerWidth, window.innerHeight, false);
    renderer.setClearColor(0x0a0a0b, 0);

    const scene = new THREE.Scene();
    scene.fog = new THREE.Fog(0x0a0a0b, 9, 22);
    const camera = new THREE.PerspectiveCamera(
      48,
      window.innerWidth / window.innerHeight,
      0.1,
      100,
    );

    const pmrem = new THREE.PMREMGenerator(renderer);
    scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;

    scene.add(new THREE.AmbientLight(0xffffff, 0.3));
    const key = new THREE.DirectionalLight(0xffe8c2, 2.0);
    key.position.set(4, 5, 5);
    scene.add(key);
    const rim = new THREE.DirectionalLight(0x2dd4bf, 1.5);
    rim.position.set(-5, -2, -4);
    scene.add(rim);

    /* ---- the vessel ------------------------------------------------ */
    const CLUSTER_POS = new THREE.Vector3(2.3, 0.1, 0);
    const curve = new THREE.CatmullRomCurve3([
      new THREE.Vector3(-9.5, 3.4, -4.5),
      new THREE.Vector3(-6.2, 1.8, -2.4),
      new THREE.Vector3(-3.2, 0.1, -0.8),
      new THREE.Vector3(-0.6, -0.8, 0.7),
      new THREE.Vector3(1.2, -0.3, 0.5),
      CLUSTER_POS.clone(),
    ]);

    const TUBE_R = 0.36;
    const tubeMat = new THREE.MeshBasicMaterial({
      color: 0x6e1e2b, // brand oxblood — reads as vessel, stays on-palette
      transparent: true,
      opacity: 0.3,
      side: THREE.DoubleSide,
      depthWrite: false,
    });
    scene.add(new THREE.Mesh(new THREE.TubeGeometry(curve, 160, TUBE_R, 18, false), tubeMat));
    // faint rose wireframe over the vessel — gives it structure
    scene.add(
      new THREE.Mesh(
        new THREE.TubeGeometry(curve, 90, TUBE_R * 1.002, 12, false),
        new THREE.MeshBasicMaterial({
          color: 0xd9a4a4,
          wireframe: true,
          transparent: true,
          opacity: 0.05,
          blending: THREE.AdditiveBlending,
          depthWrite: false,
        }),
      ),
    );

    /* sampled path — cheap per-frame lookups for particles + camera */
    const SAMPLES = 512;
    const pts = curve.getSpacedPoints(SAMPLES - 1);
    const frames = curve.computeFrenetFrames(SAMPLES - 1, false);

    /* ---- the PRP stream -------------------------------------------- */
    const sprite = makeGlowSprite();
    const N = 520;
    const pT = new Float32Array(N); // param along the vessel
    const pSpd = new Float32Array(N);
    const pAng = new Float32Array(N);
    const pRad = new Float32Array(N);
    const pPos = new Float32Array(N * 3);
    const pCol = new Float32Array(N * 3);
    for (let i = 0; i < N; i++) {
      pT[i] = Math.random();
      pSpd[i] = 0.024 + Math.random() * 0.03; // per-second progress
      pAng[i] = Math.random() * Math.PI * 2;
      pRad[i] = Math.sqrt(Math.random()) * (TUBE_R * 0.72);
      const c = Math.random() < 0.8 ? GOLD : CREAM;
      pCol.set([c.r, c.g, c.b], i * 3);
    }
    const streamGeo = new THREE.BufferGeometry();
    streamGeo.setAttribute("position", new THREE.BufferAttribute(pPos, 3));
    streamGeo.setAttribute("color", new THREE.BufferAttribute(pCol, 3));
    streamGeo.boundingSphere = new THREE.Sphere(new THREE.Vector3(), 30);
    scene.add(
      new THREE.Points(
        streamGeo,
        new THREE.PointsMaterial({
          size: 0.085,
          map: sprite,
          vertexColors: true,
          transparent: true,
          opacity: 0.95,
          blending: THREE.AdditiveBlending,
          depthWrite: false,
          sizeAttenuation: true,
        }),
      ),
    );

    /* ---- the target tissue ----------------------------------------- */
    const clusterMat = new THREE.MeshStandardMaterial({
      color: DULL.clone(),
      metalness: 0.35,
      roughness: 0.5,
      flatShading: true,
      envMapIntensity: 0.5,
    });
    const cluster = new THREE.Mesh(makeCellCluster(), clusterMat);
    cluster.position.copy(CLUSTER_POS);
    scene.add(cluster);

    /* regeneration sparkles — invisible until healing begins */
    const SPARK = 130;
    const sPos = new Float32Array(SPARK * 3);
    for (let i = 0; i < SPARK; i++) {
      const u = Math.random() * 2 - 1;
      const th = Math.random() * Math.PI * 2;
      const s2 = Math.sqrt(1 - u * u);
      const r = 1.7 + Math.random() * 1.3;
      sPos[i * 3] = s2 * Math.cos(th) * r;
      sPos[i * 3 + 1] = u * r * 0.8;
      sPos[i * 3 + 2] = s2 * Math.sin(th) * r;
    }
    const sparkGeo = new THREE.BufferGeometry();
    sparkGeo.setAttribute("position", new THREE.BufferAttribute(sPos, 3));
    const sparkMat = new THREE.PointsMaterial({
      color: 0x2dd4bf,
      size: 0.07,
      map: sprite,
      transparent: true,
      opacity: 0,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
      sizeAttenuation: true,
    });
    const sparks = new THREE.Points(sparkGeo, sparkMat);
    sparks.position.copy(CLUSTER_POS);
    scene.add(sparks);

    /* ---- copy + HUD reveal ----------------------------------------- */
    function reveal() {
      canvas.style.opacity = "1";
      if (reduced) return;
      gsap.to(eyebrow, { opacity: 1, y: 0, duration: 0.8, delay: 0.5, ease: "power2.out" });
      gsap.fromTo(
        words,
        { opacity: 0, yPercent: 40 },
        { opacity: 1, yPercent: 0, duration: 1.0, delay: 0.7, stagger: 0.09, ease: "power3.out" },
      );
      gsap.to(huds[0] ?? {}, { opacity: 1, duration: 0.9, delay: 1.6, ease: "power2.out" });
    }

    /* ---- scroll choreography ---------------------------------------- */
    const state = { progress: 0 };
    let visible = true;

    if (!reduced) {
      ScrollTrigger.create({
        trigger: section,
        start: "top top",
        end: `+=${scrollLength * 100}%`,
        scrub: 0.7,
        onUpdate: (self) => {
          state.progress = self.progress;
          const stage = self.progress < 0.55 ? 0 : 1;
          huds.forEach((h) => {
            const target = Number(h.dataset.hud) === stage ? 1 : 0;
            if (Number(h.dataset.shown ?? -1) !== target) {
              h.dataset.shown = String(target);
              gsap.to(h, { opacity: target, duration: 0.6, ease: "power2.out", overwrite: true });
            }
          });
        },
      });
    }

    const pointer = { x: 0, y: 0, tx: 0, ty: 0 };
    window.addEventListener(
      "pointermove",
      (e) => {
        pointer.tx = (e.clientX / window.innerWidth - 0.5) * 2;
        pointer.ty = (e.clientY / window.innerHeight - 0.5) * 2;
      },
      { passive: true },
    );

    const smooth = (a: number, b: number, x: number) => {
      const t = Math.min(1, Math.max(0, (x - a) / (b - a)));
      return t * t * (3 - 2 * t);
    };
    const V = new THREE.Vector3();
    const camPos = new THREE.Vector3();
    const lookAt = new THREE.Vector3();
    const framePos = CLUSTER_POS.clone().add(new THREE.Vector3(2.6, 0.8, 4.4));

    const clock = new THREE.Clock();
    let raf: number | null = null;
    let heal = 0;

    function frame() {
      raf = requestAnimationFrame(frame);
      const t = clock.getElapsedTime();
      const p = state.progress;

      /* stream — always flowing; platelets respawn at the entry */
      for (let i = 0; i < N; i++) {
        const tp = (pT[i] + t * pSpd[i]) % 1;
        const idx = Math.min(SAMPLES - 1, Math.floor(tp * (SAMPLES - 1)));
        const P = pts[idx];
        const Nrm = frames.normals[idx];
        const B = frames.binormals[idx];
        const ca = Math.cos(pAng[i] + t * 0.35);
        const sa = Math.sin(pAng[i] + t * 0.35);
        pPos[i * 3] = P.x + (Nrm.x * ca + B.x * sa) * pRad[i];
        pPos[i * 3 + 1] = P.y + (Nrm.y * ca + B.y * sa) * pRad[i];
        pPos[i * 3 + 2] = P.z + (Nrm.z * ca + B.z * sa) * pRad[i];
      }
      streamGeo.getAttribute("position").needsUpdate = true;

      /* healing — driven by arrival, eased */
      const healTarget = smooth(0.6, 0.92, p);
      heal += (healTarget - heal) * 0.06;
      clusterMat.color.copy(DULL).lerp(GOLD, heal);
      clusterMat.emissive.setRGB(TEAL.r, TEAL.g, TEAL.b).multiplyScalar(heal * 0.16);
      clusterMat.envMapIntensity = 0.5 + heal * 0.5;
      const breathe = 1 + heal * 0.12 + 0.02 * Math.sin(t * 1.2) * heal;
      cluster.scale.setScalar(breathe);
      cluster.rotation.y = t * 0.1;
      sparkMat.opacity = heal * 0.75;
      sparks.rotation.y = t * 0.22;
      sparks.rotation.z = t * 0.07;

      /* vessel pulse — a slow heartbeat */
      tubeMat.opacity = 0.26 + 0.06 * (0.5 + 0.5 * Math.sin(t * 2.1));

      /* camera — glide along the vessel, then pull out to frame the
         healed tissue */
      const camT = 0.03 + smooth(0.04, 0.72, p) * 0.83;
      const ci = Math.min(SAMPLES - 2, Math.floor(camT * (SAMPLES - 1)));
      const P = pts[ci];
      const Nrm = frames.normals[ci];
      const B = frames.binormals[ci];
      const dist = 3.4 - smooth(0.0, 0.3, p) * 1.6; // wide → close
      camPos.set(
        P.x + (Nrm.x * 0.35 + B.x * 0.95) * dist,
        P.y + (Nrm.y * 0.35 + B.y * 0.95) * dist + 0.5,
        P.z + (Nrm.z * 0.35 + B.z * 0.95) * dist,
      );
      const fb = smooth(0.66, 0.9, p);
      camPos.lerp(framePos, fb);

      const ahead = pts[Math.min(SAMPLES - 1, ci + 40)];
      lookAt.copy(ahead).lerp(CLUSTER_POS, Math.max(fb, smooth(0.5, 0.75, p)));

      pointer.x += (pointer.tx - pointer.x) * 0.045;
      pointer.y += (pointer.ty - pointer.y) * 0.045;
      camera.position.set(camPos.x + pointer.x * 0.4, camPos.y - pointer.y * 0.3, camPos.z);
      camera.lookAt(lookAt);

      renderer.render(scene, camera);
    }
    const startLoop = () => {
      if (raf === null && !reduced) raf = requestAnimationFrame(frame);
    };
    const stopLoop = () => {
      if (raf !== null) {
        cancelAnimationFrame(raf);
        raf = null;
      }
    };

    if (reduced) {
      /* static healed frame — the outcome, not the journey */
      showStatic();
      state.progress = 1;
      heal = 1;
      clusterMat.color.copy(GOLD);
      clusterMat.emissive.setRGB(TEAL.r, TEAL.g, TEAL.b).multiplyScalar(0.16);
      sparkMat.opacity = 0.6;
      camera.position.copy(framePos);
      camera.lookAt(CLUSTER_POS);
      canvas.style.opacity = "1";
      renderer.render(scene, camera);
    } else {
      reveal();
      startLoop();
      new IntersectionObserver(
        ([entry]) => {
          visible = entry.isIntersecting;
          visible && !document.hidden ? startLoop() : stopLoop();
        },
        { threshold: 0.01 },
      ).observe(section);
      document.addEventListener("visibilitychange", () => {
        document.hidden || !visible ? stopLoop() : startLoop();
      });
    }

    window.addEventListener("pagehide", () => {
      stopLoop();
      scene.traverse((obj: any) => {
        obj.geometry?.dispose?.();
        if (obj.material) {
          (Array.isArray(obj.material) ? obj.material : [obj.material]).forEach((m: any) =>
            m.dispose(),
          );
        }
      });
      sprite.dispose();
      renderer.dispose();
    });

    let rt: number;
    window.addEventListener("resize", () => {
      clearTimeout(rt);
      rt = window.setTimeout(() => {
        if (window.innerWidth < minWidth) {
          stopLoop();
          canvas.style.opacity = "0";
          if (fallback) fallback.style.opacity = "1";
          return;
        }
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight, false);
      }, 200);
    });
  }

  document.querySelectorAll<HTMLElement>(".wire-hero").forEach(initWireHero);
</script>
