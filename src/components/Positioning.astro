---
/**
 * "More than 25,000 cases worldwide" — the authority band under the awards.
 *
 * Content: src/content/home/positioning.json. The paragraphs and the stats are
 * arrays, so the column can run to three paragraphs or one, and the stat row to
 * three figures or six.
 *
 * The stats are the interesting part. Each is a single field typed the way it
 * should read — "25,000+", "20+", "1st", "2025" — and the count-up animation is
 * derived from it (src/lib/copy.ts). There is no separate "number to count to",
 * no "suffix", no "format as year" switch: four fields the owner would have had
 * to keep consistent with each other collapse into the one he actually cares
 * about. A value that does not start with a number ("IAAGSW") simply doesn't
 * animate, and an ordinal ("1st") keeps its superscript instead of counting —
 * counting from zero to one is not an animation worth having.
 */
import { positioning } from '../data/home';
import { imageUrl } from '../lib/url';
import { statParts, ordinal } from '../lib/copy';
import Copy from './Copy.astro';

const stats = positioning.stats.map((s) => ({ ...s, count: statParts(s.value), ord: ordinal(s.value) }));
/* 4 stats sit on one row at lg, as set by hand; more wrap in threes. */
const statCols = positioning.stats.length === 4 ? 'lg:grid-cols-4' : positioning.stats.length === 3 ? 'lg:grid-cols-3' : 'lg:grid-cols-4';
---

<section class="relative bg-ink py-24 md:py-32">
  <div class="pointer-events-none absolute inset-0 glow-gold" aria-hidden="true"></div>
  <div class="wrap relative">
    <div class="grid grid-cols-1 gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-6" data-reveal>
        <blockquote class="font-serif text-4xl leading-[1.15] text-cream md:text-5xl">
          <Copy text={positioning.quote} em="text-gold" sup="text-[0.45em]" />
        </blockquote>
        <div class="mt-12 flex flex-wrap items-end gap-8">
          {
            positioning.photo?.image && (
              <figure class="hairline max-w-[260px] flex-1 p-2">
                <div class="overflow-hidden">
                  <img
                    src={imageUrl(positioning.photo.image)}
                    alt={positioning.photo.alt}
                    class="aspect-[4/5] w-full scale-[1.08] object-cover"
                    loading="lazy"
                    data-parallax="-4"
                  />
                </div>
                {positioning.photo.caption && (
                  <figcaption class="px-2 pt-3 pb-1 text-[11px] font-semibold tracking-[0.18em] text-cream/62 uppercase">
                    {positioning.photo.caption}
                  </figcaption>
                )}
              </figure>
            )
          }
          {
            positioning.pressBadge?.image && (
              <div class="hairline shrink-0 rounded-md bg-cream/95 p-3">
                <img
                  src={imageUrl(positioning.pressBadge.image)}
                  alt={positioning.pressBadge.alt}
                  class="h-24 w-auto object-contain"
                  loading="lazy"
                />
              </div>
            )
          }
        </div>
      </div>
      <div class="lg:col-span-6" data-reveal data-delay="0.15">
        <p class="eyebrow mb-7">{positioning.eyebrow}</p>
        <div class="space-y-6 text-[16px] leading-[1.9] text-cream/75">
          {
            positioning.paragraphs.map((para) => (
              <p>
                <Copy text={para} em="text-gold" />
              </p>
            ))
          }
        </div>
      </div>
    </div>

    {
      stats.length > 0 && (
        <dl class:list={['hairline-t mt-20 grid grid-cols-2 gap-x-8 gap-y-12 pt-16', statCols]} data-reveal-child>
          {stats.map((s) => (
            <div class="flex flex-col">
              {/* full-size ™ and ®: an 11px uppercase label has no room to shrink one */}
              <dt class="order-2 text-[11px] font-semibold tracking-[0.18em] text-cream/62 uppercase">{s.label}</dt>
              <dd
                class="order-1 mb-3 font-serif text-5xl text-gold md:text-6xl"
                data-count={!s.ord && s.count ? s.count.count : undefined}
                data-suffix={!s.ord && s.count?.suffix ? s.count.suffix : undefined}
                data-plain={!s.ord && s.count?.plain ? '' : undefined}
              >
                {s.ord ? (
                  <>
                    {s.ord.number}
                    <sup class="text-[0.5em]">{s.ord.suffix}</sup>
                  </>
                ) : (
                  s.value
                )}
              </dd>
            </div>
          ))}
        </dl>
      )
    }
  </div>
</section>
