---
/**
 * A form, built from content.
 *
 * Reads a definition from src/content/forms/*.json and renders it: nine field
 * types, half or full width, required or not, with whatever the clinic decided
 * to call each answer. There is no per-form markup anywhere on the site — the
 * membership application and the international travel form are this component
 * twice, and the next one is a JSON file rather than a component.
 *
 * Submission is handled by main.js, with the rest of the demo forms: it
 * validates, and then either posts to the form's endpoint or — as it ships,
 * with no endpoint set — shows the thank-you without sending anything. The
 * markup below carries both outcomes so the message the patient reads is the
 * clinic's wording rather than the browser's.
 */
import { getForm, choicesFor, type FormField } from '../data/forms';

interface Props {
  /** File name in src/content/forms, without .json */
  form: string;
  /** Rendered inside a modal? Then the heading is the dialog's title. */
  headingId?: string;
  compact?: boolean;
}

const { form: slug, headingId, compact = false } = Astro.props;
const def = getForm(slug);

/* One id per control, per form, so two forms on a page can't collide. */
const idFor = (f: FormField) => `${slug}-${f.name}`.replace(/[^a-z0-9-]/gi, '-').toLowerCase();
const half = (f: FormField) => f.width === 'half';
---

{
  def && def.fields.length > 0 && (
    <form class:list={['oc-form', compact && 'oc-form--compact']} data-demo data-form={slug} data-endpoint={def.endpoint || undefined}>
      <div class="form-fields">
        {def.eyebrow && <p class="eyebrow">{def.eyebrow}</p>}
        <h2 id={headingId} class="oc-form__heading font-serif text-cream">
          {def.heading}
        </h2>
        {def.intro && <p class="oc-form__intro">{def.intro}</p>}

        <div class="oc-form__grid">
          {def.fields.map((f) => {
            const id = idFor(f);
            const choices = choicesFor(f);
            const described = f.help ? `${id}-help` : undefined;

            /* a single tick — consent, opt-in — is its own shape: the label
               sits beside the box, not above it */
            if (f.type === 'checkbox') {
              return (
                <div class="oc-field oc-field--full">
                  <label class="oc-tick" for={id}>
                    <input
                      class="oc-tick__box"
                      type="checkbox"
                      id={id}
                      name={f.name}
                      value="yes"
                      required={f.required}
                      aria-describedby={described}
                    />
                    <span>
                      {f.label}
                      {f.required && <span class="oc-req" aria-hidden="true"> *</span>}
                    </span>
                  </label>
                  {f.help && (
                    <p class="oc-help" id={described}>
                      {f.help}
                    </p>
                  )}
                </div>
              );
            }

            return (
              <div class:list={['oc-field', half(f) ? 'oc-field--half' : 'oc-field--full']}>
                {/* radio and checkbox groups are labelled by a legend, not a <label> */}
                {f.type === 'radio' || f.type === 'checkboxes' ? (
                  <fieldset class="oc-group" aria-describedby={described}>
                    <legend class="field-label">
                      {f.label}
                      {f.required && <span class="oc-req" aria-hidden="true"> *</span>}
                    </legend>
                    <div class="oc-choices">
                      {choices.map((choice, i) => (
                        <label class="oc-choice">
                          <input
                            type={f.type === 'radio' ? 'radio' : 'checkbox'}
                            name={f.type === 'radio' ? f.name : `${f.name}[]`}
                            value={choice}
                            id={`${id}-${i}`}
                            required={f.required && f.type === 'radio' && i === 0}
                          />
                          <span>{choice}</span>
                        </label>
                      ))}
                    </div>
                  </fieldset>
                ) : (
                  <>
                    <label class="field-label" for={id}>
                      {f.label}
                      {f.required && <span class="oc-req" aria-hidden="true"> *</span>}
                    </label>

                    {f.type === 'textarea' && (
                      <textarea
                        class="field oc-textarea"
                        id={id}
                        name={f.name}
                        rows={4}
                        required={f.required}
                        placeholder={f.placeholder}
                        aria-describedby={described}
                      />
                    )}

                    {f.type === 'select' && (
                      <select
                        class="field oc-select"
                        id={id}
                        name={f.name}
                        required={f.required}
                        aria-describedby={described}
                      >
                        <option value="" disabled selected>
                          {f.placeholder || 'Please choose…'}
                        </option>
                        {choices.map((choice) => (
                          <option value={choice}>{choice}</option>
                        ))}
                      </select>
                    )}

                    {!['textarea', 'select', 'radio', 'checkboxes', 'checkbox'].includes(f.type) && (
                      <input
                        class="field"
                        type={f.type}
                        id={id}
                        name={f.name}
                        required={f.required}
                        placeholder={f.placeholder}
                        autocomplete={f.autocomplete}
                        aria-describedby={described}
                      />
                    )}
                  </>
                )}

                {f.help && (
                  <p class="oc-help" id={described}>
                    {f.help}
                  </p>
                )}
              </div>
            );
          })}
        </div>

        <button type="submit" class="btn btn-gold oc-form__submit">
          {def.submitLabel}
        </button>
        {def.note && <p class="oc-form__note">{def.note}</p>}
      </div>

      <div class="form-success" role="status">
        <p class="oc-form__tick" aria-hidden="true">✓</p>
        <p class="oc-form__success-heading font-serif text-cream">{def.success.heading}</p>
        <p class="oc-form__intro">{def.success.text}</p>
      </div>

      {def.error && (
        <div class="oc-form__error" role="alert" hidden>
          <p class="oc-form__success-heading font-serif text-cream">{def.error.heading}</p>
          <p class="oc-form__intro">{def.error.text}</p>
        </div>
      )}
    </form>
  )
}

<style>
  .oc-form__heading {
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    line-height: 1.12;
    margin-top: 0.85rem;
  }
  .oc-form--compact .oc-form__heading {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }
  .oc-form__intro {
    margin-top: 1rem;
    max-width: 46rem;
    font-size: 15px;
    line-height: 1.8;
    color: rgba(244, 241, 236, 0.75);
  }

  .oc-form__grid {
    margin-top: 2.25rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 640px) {
    .oc-form__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .oc-field--full {
      grid-column: 1 / -1;
    }
  }

  .oc-help {
    margin-top: 0.5rem;
    font-size: 12px;
    line-height: 1.6;
    color: rgba(244, 241, 236, 0.62);
  }
  .oc-req {
    color: var(--color-gold);
  }

  .oc-textarea {
    resize: vertical;
    min-height: 7rem;
  }
  .oc-select {
    cursor: pointer;
    background-color: var(--color-ink2);
  }

  /* choice groups ---------------------------------------------------- */
  .oc-group {
    border: 0;
    margin: 0;
    padding: 0;
  }
  .oc-choices {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .oc-choice {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    cursor: pointer;
    border: 1px solid rgba(244, 241, 236, 0.15);
    padding: 0.65rem 1rem;
    font-size: 14px;
    color: rgba(244, 241, 236, 0.9);
    transition: border-color 0.3s ease, background-color 0.3s ease;
  }
  .oc-choice:hover {
    border-color: rgba(201, 169, 110, 0.5);
  }
  .oc-choice:has(input:checked) {
    border-color: rgba(201, 169, 110, 0.75);
    background: rgba(201, 169, 110, 0.08);
  }
  .oc-choice input {
    height: 1rem;
    width: 1rem;
    flex-shrink: 0;
    cursor: pointer;
    appearance: none;
    border: 1px solid rgba(244, 241, 236, 0.35);
    background: transparent;
    transition: border-color 0.3s ease, background-color 0.3s ease;
  }
  .oc-choice input[type='radio'] {
    border-radius: 9999px;
  }
  .oc-choice input:checked {
    border-color: var(--color-gold);
    background: var(--color-gold);
  }

  /* single tick ------------------------------------------------------- */
  .oc-tick {
    display: flex;
    cursor: pointer;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 13px;
    line-height: 1.65;
    color: rgba(244, 241, 236, 0.75);
  }
  .oc-tick__box {
    margin-top: 0.15rem;
    height: 1rem;
    width: 1rem;
    flex-shrink: 0;
    cursor: pointer;
    appearance: none;
    border: 1px solid rgba(244, 241, 236, 0.25);
    background: transparent;
    transition: border-color 0.3s ease, background-color 0.3s ease;
  }
  .oc-tick__box:checked {
    border-color: var(--color-gold);
    background: var(--color-gold);
  }

  .oc-form__submit {
    margin-top: 2rem;
    width: 100%;
  }
  @media (min-width: 640px) {
    .oc-form__submit {
      width: auto;
    }
  }
  .oc-form__note {
    margin-top: 1.1rem;
    font-size: 12px;
    line-height: 1.7;
    color: rgba(244, 241, 236, 0.62);
  }

  /* outcomes ---------------------------------------------------------- */
  .oc-form__tick {
    font-size: 2rem;
    color: var(--color-gold);
  }
  .oc-form__success-heading {
    margin-top: 0.75rem;
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    line-height: 1.2;
  }
  .oc-form__error {
    margin-top: 1.5rem;
    border: 1px solid rgba(139, 30, 43, 0.5);
    background: rgba(139, 30, 43, 0.12);
    padding: 1.25rem 1.5rem;
  }
</style>
