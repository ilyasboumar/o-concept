---
/**
 * BioSequence.astro — THE O CONCEPT
 * ------------------------------------------------------------------
 * Scroll-driven WebGL particle field. 12,000 points morph through
 * four formations as the section is pinned:
 *
 *   0 — Cell membrane   (spherical shell, breathing)
 *   1 — Molecular lattice (crystalline grid)
 *   2 — Double helix     (twin strands, rotating)
 *   3 — Dispersal bloom  (weightless upward drift)
 *
 * Champagne gold #c9a96e → teal #2dd4bf, additive glow on #0a0a0b.
 * Cursor parallax on the camera. No assets, no textures, ~0 payload.
 *
 * Requires: three, gsap + ScrollTrigger, lenis (all already installed)
 * ------------------------------------------------------------------
 */

interface Props {
  /** Particle count. 12000 desktop / auto-halved on weaker GPUs. */
  count?: number;
  /** Pin duration in viewport heights. */
  scrollLength?: number;
  /** Below this width WebGL is skipped and the CSS fallback shows. */
  minWidth?: number;
  labels?: string[];
  /** Base point size — lowered from the original 2.6 for a cleaner,
   *  less blurry field once thousands of points additively overlap. */
  uSize?: number;
}

const {
  count = 12000,
  scrollLength = 4,
  minWidth = 860,
  labels = [
    "Cellular integrity",
    "Molecular precision",
    "Genetic expression",
    "Restored vitality",
  ],
  uSize = 1.9,
} = Astro.props;
---

<section
  class="bio-seq relative bg-ink"
  data-particle-count={count}
  data-scroll-length={scrollLength}
  data-min-width={minWidth}
  data-point-size={uSize}
  style={`height: ${(scrollLength + 1) * 100}vh;`}
>
  <div class="bio-seq__pin sticky top-0 h-screen w-full overflow-hidden">
    <!-- CSS-only fallback: mobile + reduced-motion + no WebGL -->
    <div
      class="bio-seq__fallback absolute inset-0"
      style="background:
        radial-gradient(ellipse 60% 50% at 50% 45%, rgba(201,169,110,0.18), transparent 70%),
        radial-gradient(ellipse 40% 35% at 65% 60%, rgba(45,212,191,0.10), transparent 70%),
        #0a0a0b;"
    >
    </div>

    <canvas
      class="bio-seq__canvas absolute inset-0 h-full w-full opacity-0 transition-opacity duration-1000"
      aria-hidden="true"></canvas>

    <div
      class="pointer-events-none absolute inset-0"
      style="background: linear-gradient(to bottom, rgba(10,10,11,0.75) 0%, transparent 25%, transparent 70%, rgba(10,10,11,0.95) 100%);"
    >
    </div>

    <div class="wrap relative flex h-full items-end pb-24 md:items-center md:pb-0">
      <div class="max-w-md">
        <p class="eyebrow">The Science</p>
        <div class="bio-seq__labels relative mt-5 h-24 md:h-28">
          {
            labels.map((label, i) => (
              <h2
                class="bio-seq__label absolute inset-x-0 top-0 font-serif text-4xl leading-[1.1] text-cream md:text-5xl"
                data-index={i}
                style={i === 0 ? "" : "opacity:0"}
              >
                {label}
              </h2>
            ))
          }
        </div>
        <slot />
      </div>
    </div>

    <!-- progress rail -->
    <div class="absolute bottom-10 right-6 hidden h-32 w-px bg-cream/10 md:block">
      <div
        class="bio-seq__rail absolute inset-x-0 top-0 origin-top bg-gold"
        style="height:100%; transform:scaleY(0);"
      >
      </div>
    </div>
  </div>
</section>

<script>
  import * as THREE from "three";
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const VERT = /* glsl */ `
    attribute vec3 t0;
    attribute vec3 t1;
    attribute vec3 t2;
    attribute vec3 t3;
    attribute float aRand;
    attribute float aScale;

    uniform float uProgress;   // 0 .. 3
    uniform float uTime;
    uniform float uSize;
    uniform float uPixelRatio;

    varying float vRand;
    varying float vDepth;

    vec3 formation(float p) {
      if (p < 1.0)  return mix(t0, t1, smoothstep(0.0, 1.0, p));
      if (p < 2.0)  return mix(t1, t2, smoothstep(0.0, 1.0, p - 1.0));
      return mix(t2, t3, smoothstep(0.0, 1.0, p - 2.0));
    }

    void main() {
      vec3 pos = formation(uProgress);

      // organic drift so it never looks frozen
      float ph = aRand * 6.2831853;
      pos.x += sin(uTime * 0.35 + ph) * 0.09;
      pos.y += cos(uTime * 0.28 + ph * 1.7) * 0.09;
      pos.z += sin(uTime * 0.31 + ph * 2.3) * 0.09;

      vec4 mv = modelViewMatrix * vec4(pos, 1.0);
      gl_Position = projectionMatrix * mv;
      // capped so near-camera points can't balloon into a blurry blob
      gl_PointSize = min(uSize * aScale * uPixelRatio * (240.0 / -mv.z), 13.0 * uPixelRatio);

      vRand = aRand;
      vDepth = clamp((-mv.z - 4.0) / 18.0, 0.0, 1.0);
    }
  `;

  const FRAG = /* glsl */ `
    precision highp float;

    uniform float uProgress;
    varying float vRand;
    varying float vDepth;

    const vec3 GOLD = vec3(0.788, 0.663, 0.431);  // #c9a96e
    const vec3 TEAL = vec3(0.176, 0.831, 0.749);  // #2dd4bf

    void main() {
      float d = length(gl_PointCoord - vec2(0.5));
      if (d > 0.5) discard;

      // anti-aliased circular edge (hard discard alone leaves a jagged rim)
      float edge = 1.0 - smoothstep(0.40, 0.5, d);

      // small, sharp core + a tight halo — reads as a clean point, not a
      // diffuse smear, even with thousands of points additively overlapping
      float core = pow(max(0.0, 1.0 - d * 2.0), 7.0);
      float halo = pow(max(0.0, 1.0 - d * 2.0), 2.2) * 0.16;
      float a = (core + halo) * edge;

      // teal reads as the "science" accent — more of it mid-sequence
      float tealBias = smoothstep(0.4, 1.6, uProgress) * (1.0 - smoothstep(2.1, 3.0, uProgress));
      float mixAmt = clamp(vRand * 0.55 + tealBias * 0.6, 0.0, 1.0);
      vec3 col = mix(GOLD, TEAL, mixAmt);

      // fade distant points into the black
      a *= mix(1.0, 0.18, vDepth);

      gl_FragColor = vec4(col, a * 0.95);
    }
  `;

  function initBioSequence(section: HTMLElement) {
    const canvas = section.querySelector<HTMLCanvasElement>(".bio-seq__canvas");
    const fallback = section.querySelector<HTMLElement>(".bio-seq__fallback");
    const rail = section.querySelector<HTMLElement>(".bio-seq__rail");
    const labels = Array.from(
      section.querySelectorAll<HTMLElement>(".bio-seq__label"),
    );
    if (!canvas) return;

    const scrollLength = Number(section.dataset.scrollLength ?? 4);
    const minWidth = Number(section.dataset.minWidth ?? 860);
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (reduced || window.innerWidth < minWidth) {
      section.style.height = "100vh";
      return;
    }

    let renderer: THREE.WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({
        canvas,
        antialias: true,
        alpha: true,
        powerPreference: "high-performance",
      });
    } catch {
      section.style.height = "100vh";
      return; // no WebGL — CSS fallback stands
    }

    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    renderer.setPixelRatio(dpr);
    renderer.setSize(window.innerWidth, window.innerHeight, false);
    renderer.setClearColor(0x0a0a0b, 0);

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(
      52,
      window.innerWidth / window.innerHeight,
      0.1,
      100,
    );
    camera.position.set(0, 0, 13);

    // Scale down on low-end GPUs so the effect degrades instead of stuttering
    const baseCount = Number(section.dataset.particleCount ?? 12000);
    const COUNT =
      (navigator as any).hardwareConcurrency &&
      (navigator as any).hardwareConcurrency <= 4
        ? Math.floor(baseCount / 2)
        : baseCount;

    // ---- formations -------------------------------------------------
    const t0 = new Float32Array(COUNT * 3); // cell membrane
    const t1 = new Float32Array(COUNT * 3); // lattice
    const t2 = new Float32Array(COUNT * 3); // helix
    const t3 = new Float32Array(COUNT * 3); // bloom
    const rand = new Float32Array(COUNT);
    const scale = new Float32Array(COUNT);

    const LATTICE = Math.ceil(Math.cbrt(COUNT));

    for (let i = 0; i < COUNT; i++) {
      const i3 = i * 3;
      const r = Math.random();
      rand[i] = r;
      // tighter spread than before — a handful of oversized points were
      // ballooning into blurry blobs and washing out the whole field
      scale[i] = 0.55 + Math.pow(Math.random(), 2.4) * 0.85;

      // 0 — spherical shell with membrane thickness
      const u = Math.random() * 2 - 1;
      const th = Math.random() * Math.PI * 2;
      const s = Math.sqrt(1 - u * u);
      const rad = 4.2 + (Math.random() - 0.5) * 0.55;
      t0[i3] = s * Math.cos(th) * rad;
      t0[i3 + 1] = s * Math.sin(th) * rad;
      t0[i3 + 2] = u * rad;

      // 1 — crystalline lattice, jittered
      const gx = i % LATTICE;
      const gy = Math.floor(i / LATTICE) % LATTICE;
      const gz = Math.floor(i / (LATTICE * LATTICE));
      const step = 9 / LATTICE;
      t1[i3] = (gx - LATTICE / 2) * step + (Math.random() - 0.5) * 0.18;
      t1[i3 + 1] = (gy - LATTICE / 2) * step + (Math.random() - 0.5) * 0.18;
      t1[i3 + 2] = (gz - LATTICE / 2) * step + (Math.random() - 0.5) * 0.18;

      // 2 — double helix, 10% loose in the surrounding field
      if (r > 0.9) {
        t2[i3] = (Math.random() - 0.5) * 12;
        t2[i3 + 1] = (Math.random() - 0.5) * 12;
        t2[i3 + 2] = (Math.random() - 0.5) * 6;
      } else {
        const strand = i % 2 === 0 ? 0 : Math.PI;
        const tt = (i / COUNT) * Math.PI * 9;
        const hr = 2.1 + (Math.random() - 0.5) * 0.35;
        t2[i3] = Math.cos(tt + strand) * hr;
        t2[i3 + 1] = ((i / COUNT) * 14 - 7) + (Math.random() - 0.5) * 0.2;
        t2[i3 + 2] = Math.sin(tt + strand) * hr;
      }

      // 3 — weightless dispersal, biased upward
      const br = Math.pow(Math.random(), 0.45) * 9;
      const bu = Math.random() * 2 - 1;
      const bth = Math.random() * Math.PI * 2;
      const bs = Math.sqrt(1 - bu * bu);
      t3[i3] = bs * Math.cos(bth) * br;
      t3[i3 + 1] = bu * br * 0.55 + Math.random() * 3.5;
      t3[i3 + 2] = bs * Math.sin(bth) * br;
    }

    const geo = new THREE.BufferGeometry();
    geo.setAttribute("position", new THREE.BufferAttribute(t0.slice(), 3));
    geo.setAttribute("t0", new THREE.BufferAttribute(t0, 3));
    geo.setAttribute("t1", new THREE.BufferAttribute(t1, 3));
    geo.setAttribute("t2", new THREE.BufferAttribute(t2, 3));
    geo.setAttribute("t3", new THREE.BufferAttribute(t3, 3));
    geo.setAttribute("aRand", new THREE.BufferAttribute(rand, 1));
    geo.setAttribute("aScale", new THREE.BufferAttribute(scale, 1));
    geo.boundingSphere = new THREE.Sphere(new THREE.Vector3(), 20);

    const uniforms = {
      uProgress: { value: 0 },
      uTime: { value: 0 },
      uSize: { value: Number(section.dataset.pointSize ?? 1.9) },
      uPixelRatio: { value: dpr },
    };

    const mat = new THREE.ShaderMaterial({
      vertexShader: VERT,
      fragmentShader: FRAG,
      uniforms,
      transparent: true,
      depthWrite: false,
      blending: THREE.AdditiveBlending,
    });

    const points = new THREE.Points(geo, mat);
    scene.add(points);

    // ---- interaction ------------------------------------------------
    const pointer = { x: 0, y: 0, tx: 0, ty: 0 };
    window.addEventListener(
      "pointermove",
      (e) => {
        pointer.tx = (e.clientX / window.innerWidth - 0.5) * 2;
        pointer.ty = (e.clientY / window.innerHeight - 0.5) * 2;
      },
      { passive: true },
    );

    const state = { progress: 0 };
    let visible = false;

    ScrollTrigger.create({
      trigger: section,
      start: "top top",
      end: `+=${scrollLength * 100}%`,
      scrub: 0.6,
      onToggle: (self) => (visible = self.isActive),
      onUpdate: (self) => {
        state.progress = self.progress * 3;
        if (rail) rail.style.transform = `scaleY(${self.progress})`;

        // crossfade the headings across the four stages
        const stage = Math.min(3, Math.floor(self.progress * 3.999));
        labels.forEach((el, i) => {
          const target = i === stage ? 1 : 0;
          if (Number(el.dataset.shown ?? 0) !== target) {
            el.dataset.shown = String(target);
            gsap.to(el, {
              opacity: target,
              y: target ? 0 : 14,
              duration: 0.5,
              ease: "power2.out",
              overwrite: true,
            });
          }
        });
      },
    });

    const clock = new THREE.Clock();
    let raf = 0;

    function loop() {
      raf = requestAnimationFrame(loop);
      if (!visible && uniforms.uProgress.value === state.progress) return;

      uniforms.uTime.value = clock.getElapsedTime();
      uniforms.uProgress.value +=
        (state.progress - uniforms.uProgress.value) * 0.08;

      pointer.x += (pointer.tx - pointer.x) * 0.045;
      pointer.y += (pointer.ty - pointer.y) * 0.045;

      camera.position.x = pointer.x * 1.5;
      camera.position.y = -pointer.y * 1.0;
      camera.lookAt(0, 0, 0);

      // slow axial rotation, faster through the helix stage
      points.rotation.y += 0.0012 + uniforms.uProgress.value * 0.0009;

      renderer.render(scene, camera);
    }
    loop();

    canvas.style.opacity = "1";

    let rt: number;
    window.addEventListener("resize", () => {
      clearTimeout(rt);
      rt = window.setTimeout(() => {
        if (window.innerWidth < minWidth) {
          cancelAnimationFrame(raf);
          canvas.style.opacity = "0";
          if (fallback) fallback.style.opacity = "1";
          return;
        }
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight, false);
      }, 200);
    });
  }

  document
    .querySelectorAll<HTMLElement>(".bio-seq")
    .forEach(initBioSequence);
</script>
