---
/**
 * Interactive DNA helix — Three.js signature piece, mounted client-side by
 * scripts/three-fx.js (lazy chunk). The host div reserves its size before
 * scene init (no layout shift) and carries the config as data attributes.
 *
 * Props:
 *  - nodeCount   glowing points per strand (desktop)
 *  - opacity     host opacity (hero placement runs at 0.1–0.15)
 *  - interactive cursor eases helix tilt ±8° (window-level listener, so the
 *                canvas itself never intercepts pointer events)
 *  - height      optional CSS height (defaults to filling the parent)
 *  - mobile      'svg' = below lg show the static SVG only (hero);
 *                'reduced' = below lg run WebGL at ~40 nodes, no tracking
 *
 * prefers-reduced-motion renders a single static frame. If WebGL never
 * mounts, the inline SVG fallback below stays visible.
 */
interface Props {
  nodeCount?: number;
  opacity?: number;
  interactive?: boolean;
  height?: string;
  mobile?: 'svg' | 'reduced';
  /** 'ambient' = background presence; 'showpiece' = thicker construction,
   *  fake-bloom layer, ±14° tilt, cursor-proximity glow, touch drag-to-rotate */
  preset?: 'ambient' | 'showpiece';
  /** node count per strand below lg (showpiece runs ~55) */
  mobileNodes?: number;
  class?: string;
}
const {
  nodeCount = 70,
  opacity = 1,
  interactive = false,
  height,
  mobile = 'reduced',
  preset = 'ambient',
  mobileNodes = 40,
  class: className = '',
} = Astro.props;
---

<div
  class:list={['three-host pointer-events-none h-full w-full', className]}
  data-three="helix"
  data-node-count={nodeCount}
  data-mobile-nodes={mobileNodes}
  data-preset={preset}
  data-interactive={interactive ? '1' : undefined}
  data-mobile={mobile}
  style={`opacity:${opacity};${height ? `height:${height};` : ''}`}
  aria-hidden="true"
>
  <!-- static SVG helix fallback — same gold/teal language -->
  <svg
    class="three-fallback absolute inset-0 h-full w-full"
    viewBox="0 0 200 500"
    fill="none"
    preserveAspectRatio="xMidYMid meet"
    aria-hidden="true"
  >
    <path d="M55 0 C150 32 150 63 55 95 C-40 127 -40 158 55 190 C150 222 150 253 55 285 C-40 317 -40 348 55 380 C150 412 150 443 55 475 C31 483 21 491 24 500" stroke="#2DD4BF" stroke-width="1.1" opacity="0.8" />
    <path d="M145 0 C50 32 50 63 145 95 C240 127 240 158 145 190 C50 222 50 253 145 285 C240 317 240 348 145 380 C50 412 50 443 145 475 C169 483 179 491 176 500" stroke="#C9A96E" stroke-width="1" opacity="0.65" />
    {Array.from({ length: 12 }).map((_, i) => (
      <line x1="62" x2="138" y1={i * 42 + 10} y2={i * 42 + 10} stroke="#2DD4BF" stroke-width="0.55" opacity="0.4" />
    ))}
    {Array.from({ length: 12 }).map((_, i) => (
      <circle cx={i % 2 ? 58 : 142} cy={i * 42 + 10} r="2.2" fill={i % 2 ? '#2DD4BF' : '#C9A96E'} opacity="0.6" />
    ))}
  </svg>
</div>
