---
/**
 * Recognition band — a draggable, auto-scrolling stream of award badges,
 * short testimonials and press marks, anchored by a fixed intro cell of
 * Dr Wakil at the left edge. Drag/auto-scroll logic lives in main.js.
 *
 * Awards, patient quotes and press names are three arrays in
 * src/content/home/recognition.json, so each is add / remove / reorder in the
 * CMS. They are then interleaved — award · quote · video · press · award … —
 * which is why the stream reads as one curated ribbon rather than a wall of
 * badges followed by a wall of quotes. The interleave works off whatever
 * lengths the three arrays happen to be: delete every press name and the
 * remaining cells simply close up.
 *
 * Patient video testimonials stay in src/data/videos.ts — they are real
 * YouTube IDs tied to consented patients, not page copy. The CMS switch only
 * decides whether they join this stream.
 */
import { imageUrl } from '../lib/url';
import { videos } from '../data/videos';
import { recognition } from '../data/home';

const { doctor, awards, quotes, press } = recognition;
const vids = recognition.includeVideos === false ? [] : videos;

/* Interleave: badge · quote · video · press · … one elegant stream */
type Cell =
  | { kind: 'badge'; src: string; alt: string }
  | { kind: 'quote'; text: string; who: string }
  | { kind: 'press'; name: string }
  | { kind: 'video'; id: string; quote: string; attribution: string };

const stream: Cell[] = [];
const max = Math.max(awards.length, quotes.length, press.length, vids.length);
for (let i = 0; i < max; i++) {
  if (awards[i]) stream.push({ kind: 'badge', src: imageUrl(awards[i].image), alt: awards[i].alt || 'Award recognising Dr SW Clinics' });
  if (quotes[i]) stream.push({ kind: 'quote', text: quotes[i].text, who: quotes[i].who });
  if (vids[i]) stream.push({ kind: 'video', id: vids[i].id, quote: vids[i].quote, attribution: vids[i].attribution });
  if (press[i]) stream.push({ kind: 'press', name: press[i].name });
}
---
{stream.length > 0 && (

<section class="hairline-t hairline-b relative overflow-hidden bg-inkdeep py-14 md:py-16" aria-label="Awards, testimonials and press recognition">
  <div class="pointer-events-none absolute inset-0 glow-gold" aria-hidden="true"></div>

  <div class="relative flex flex-col gap-8 lg:flex-row lg:items-stretch lg:gap-0">
    {/* fixed intro cell — Dr Wakil anchors the stream */}
    <div class="relative z-10 flex shrink-0 items-center gap-5 border-gold/25 bg-inkdeep px-6 md:px-10 lg:w-[340px] lg:border-r">
      <div class="hairline h-20 w-20 shrink-0 overflow-hidden rounded-full p-1 md:h-24 md:w-24">
        <img
          src={imageUrl(doctor.image)}
          alt={doctor.alt || doctor.name}
          class="h-full w-full rounded-full object-cover object-top"
          loading="lazy"
          width="96"
          height="96"
        />
      </div>
      <div>
        <p class="font-serif text-xl leading-tight text-cream md:text-2xl">{doctor.name}</p>
        <p class="mt-1.5 text-[11px] font-semibold tracking-[0.17em] text-gold uppercase">{doctor.role}</p>
        <p class="mt-1 text-[11px] tracking-[0.13em] text-cream/62 uppercase">{doctor.note}</p>
      </div>
    </div>

    {/* draggable auto-scrolling stream */}
    <div class="recog-viewport min-w-0 flex-1" data-recog>
      <div class="recog-track py-1">
        {
          [0, 1].map((copy) => (
            <div class="flex" aria-hidden={copy === 1 ? 'true' : undefined}>
              {stream.map((cell) => (
                <div class:list={['recog-card', cell.kind === 'video' && '!p-0 overflow-hidden']} data-tilt>
                  {cell.kind === 'video' && (
                    <button
                      type="button"
                      class="video-facade recog-video group relative block h-full w-full overflow-hidden text-left"
                      data-video-facade
                      data-video-id={cell.id}
                      aria-label={`Play patient testimonial — ${cell.attribution}`}
                    >
                      <img
                        src={`https://i.ytimg.com/vi/${cell.id}/hqdefault.jpg`}
                        alt=""
                        class="absolute inset-0 h-full w-full object-cover opacity-60 transition-opacity duration-500 group-hover:opacity-80"
                        loading="lazy"
                        draggable="false"
                      />
                      <span class="absolute inset-0" style="background:linear-gradient(to top, rgba(7,7,8,0.94), rgba(7,7,8,0.2) 55%, rgba(7,7,8,0.4));" aria-hidden="true" />
                      <span class="recog-play" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4"><path d="M8 5v14l11-7z" /></svg>
                      </span>
                      <span class="absolute inset-x-4 bottom-4">
                        <span class="block text-[11px] font-semibold tracking-[0.18em] text-gold uppercase">Patient story · watch</span>
                        <span class="mt-1.5 line-clamp-2 font-serif text-[0.95rem] leading-snug text-cream italic">“{cell.quote}”</span>
                        <span class="mt-2 block text-[11px] font-semibold tracking-[0.16em] text-cream/62 uppercase">{cell.attribution}</span>
                      </span>
                    </button>
                  )}
                  {cell.kind === 'badge' && (
                    <div class="flex h-full min-h-[150px] items-center justify-center">
                      <div class="flex h-[120px] w-full items-center justify-center rounded-md bg-cream/95 p-4">
                        <img src={cell.src} alt={cell.alt} class="max-h-full max-w-full object-contain" loading="lazy" draggable="false" />
                      </div>
                    </div>
                  )}
                  {cell.kind === 'quote' && (
                    <blockquote class="flex h-full flex-col justify-between">
                      <p class="font-serif text-[1.05rem] leading-snug text-cream/90 italic">
                        <span class="mr-1 text-2xl leading-none text-gold" aria-hidden="true">“</span>
                        {cell.text}
                      </p>
                      <footer class="mt-4 text-[11px] font-semibold tracking-[0.16em] text-gold/80 uppercase">{cell.who}</footer>
                    </blockquote>
                  )}
                  {cell.kind === 'press' && (
                    <div class="flex h-full min-h-[150px] flex-col items-center justify-center gap-3">
                      <span class="text-[11px] font-semibold tracking-[0.2em] text-cream/62 uppercase">As seen in</span>
                      <span class="font-serif text-3xl text-cream/75">{cell.name}</span>
                    </div>
                  )}
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
)}

<style>
  .recog-video {
    aspect-ratio: auto; /* fill the card height instead of forcing 16:9 */
  }
  .recog-play {
    position: absolute;
    top: 42%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    height: 44px;
    width: 44px;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid rgba(201, 169, 110, 0.6);
    background: rgba(28, 30, 36, 0.5);
    color: var(--color-gold);
    backdrop-filter: blur(4px);
    transition: transform 0.4s ease, box-shadow 0.4s ease, border-color 0.4s ease;
  }
  .recog-video:hover .recog-play {
    border-color: var(--color-gold);
    box-shadow: 0 0 26px rgba(201, 169, 110, 0.35);
    transform: translate(-50%, -50%) scale(1.08);
  }
</style>
