---
/**
 * Membership tiers — Silver · Gold · Platinum.
 * Pricing is deliberately structured as "From £—/month · By application"
 * placeholders: when the client finalises numbers, replace each tier's
 * `price` string and nothing else needs to move.
 */
import { withBase } from '../lib/url';

const tiers = [
  {
    name: 'Silver',
    price: 'From £—',
    priceNote: 'per month · by application',
    tagline: 'The foundation: annual head-to-toe diagnostics, expertly maintained.',
    featured: false,
    benefits: [
      'Annual Endo Test diagnostic panel',
      'Quarterly review consultations',
      'Two maintenance ESWT sessions per year',
      'Member rate on all treatments',
      'Priority booking line',
    ],
  },
  {
    name: 'Gold',
    price: 'From £—',
    priceNote: 'per month · by application',
    tagline: 'Our most chosen path. Active treatment and optimisation, continuously managed.',
    featured: true,
    benefits: [
      'Everything in Silver',
      'Biannual full diagnostic panel',
      'Monthly treatment session credit',
      'Hormone & nutrition optimisation reviews',
      'Dedicated care coordinator',
      '48-hour priority appointments',
    ],
  },
  {
    name: 'Platinum',
    price: 'From £—',
    priceNote: 'per month · by application',
    tagline: 'Complete, personal oversight by Dr Wakil — with the Concierge experience.',
    featured: false,
    benefits: [
      'Everything in Gold',
      'Protocol reviews led personally by Dr Wakil',
      'The O Concept™ Concierge — door-to-door',
      'Same-day priority access',
      'At-home phlebotomy for diagnostics',
      'Partner assessment included',
      'Discreet direct line, seven days a week',
    ],
  },
];
---

<div class="grid grid-cols-1 gap-6 lg:grid-cols-3 lg:items-stretch" data-reveal-child>
  {
    tiers.map((tier) => (
      <div
        class:list={[
          'hairline relative flex flex-col bg-ink2 p-9 md:p-10',
          tier.featured && 'gold-glow lg:-my-5 lg:py-14',
        ]}
      >
        {tier.featured && (
          <span class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-gold px-4 py-1.5 text-[9px] font-bold tracking-[0.3em] text-ink uppercase">
            Most Chosen
          </span>
        )}
        <h3 class="font-serif text-3xl text-gold">{tier.name}</h3>
        <p class="mt-2 min-h-10 text-xs leading-relaxed text-cream/50">{tier.tagline}</p>
        <p class="mt-6 flex items-baseline gap-3">
          <span class="font-serif text-4xl text-cream">{tier.price}</span>
          <span class="text-[10px] font-semibold tracking-[0.22em] text-cream/45 uppercase">{tier.priceNote}</span>
        </p>
        <ul class="hairline-t mt-8 flex-1 space-y-4 pt-8 text-sm text-cream/70">
          {tier.benefits.map((benefit) => (
            <li class="flex items-start gap-3">
              <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-gold" aria-hidden="true" />
              {benefit}
            </li>
          ))}
        </ul>
        <a href={withBase('membership')} class:list={['btn mt-10', tier.featured ? 'btn-gold' : 'btn-ghost']} data-magnetic>
          Apply for {tier.name}
        </a>
      </div>
    ))
  }
</div>
