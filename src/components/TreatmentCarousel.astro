---
/**
 * All-treatments carousel — continuous slow marquee of every treatment for
 * the page's pathway ('all' on /treatments). Pauses on hover/touch, becomes
 * draggable with momentum, resumes 3s after interaction (logic in main.js).
 * Cards anchor-scroll to the matching treatment box in the grid below.
 * Reduced motion: static horizontally-scrollable row (CSS), no tilt.
 */
import { imageUrl } from '../lib/url';
import { treatments, PATHWAY_LABELS, type Pathway } from '../data/treatments';

interface Props {
  pathway: Pathway | 'all';
}
const { pathway } = Astro.props;

const list = pathway === 'all' ? treatments : treatments.filter((t) => t.pathway === pathway);
---

<section class="relative overflow-hidden bg-ink pb-20 md:pb-24" aria-label="Browse all treatments">
  <div class="wrap mb-8 flex items-baseline justify-between gap-6">
    <p class="eyebrow" data-reveal>Every treatment in the pathway</p>
    <p class="hidden text-[10px] tracking-[0.25em] text-cream/35 uppercase md:block" data-reveal>Drag to explore · Click to jump</p>
  </div>

  <div class="tx-viewport" data-tx-carousel>
    <div class="tx-track py-1">
      {
        [0, 1].map((copy) => (
          <div class="flex" aria-hidden={copy === 1 ? 'true' : undefined}>
            {list.map((t) => (
              <a href={`#${t.slug}`} class="tx-card group" data-tilt data-tilt-max="6" tabindex={copy === 1 ? -1 : undefined}>
                <span class="relative block aspect-[3/2] overflow-hidden">
                  <img
                    src={imageUrl(t.image)}
                    alt={t.imageAlt}
                    class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.05]"
                    loading="lazy"
                    draggable="false"
                  />
                  <span class="absolute inset-0 bg-gradient-to-t from-ink via-ink/20 to-ink/5" aria-hidden="true" />
                  <span class:list={['pathway-tag absolute top-3.5 left-4', t.pathway]}>{PATHWAY_LABELS[t.pathway]}</span>
                </span>
                <span class="flex flex-1 flex-col p-5">
                  <span class="font-serif text-xl leading-snug text-cream">{t.name}</span>
                  <span class="mt-3 flex-1">
                    <span class="condition-chip">{t.conditions[0].clinical}</span>
                  </span>
                  <span class="mt-4 inline-flex items-center gap-2 text-[9.5px] font-semibold tracking-[0.25em] text-gold uppercase">
                    View in grid <span class="transition-transform duration-500 group-hover:translate-x-1.5">→</span>
                  </span>
                </span>
              </a>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>
