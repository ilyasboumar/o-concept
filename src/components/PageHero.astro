---
interface Props {
  eyebrow: string;
  title: string;
  sub: string;
  theme?: 'gold' | 'rose' | 'teal';
}
const { eyebrow, title, sub, theme = 'gold' } = Astro.props;

const glows = {
  gold: 'radial-gradient(ellipse 75% 65% at 70% 0%, rgba(201,169,110,0.14), transparent 65%), radial-gradient(ellipse 55% 50% at 15% 100%, rgba(201,169,110,0.07), transparent 70%)',
  rose: 'radial-gradient(ellipse 75% 65% at 70% 0%, rgba(110,30,43,0.42), transparent 65%), radial-gradient(ellipse 55% 50% at 15% 100%, rgba(217,164,164,0.08), transparent 70%)',
  teal: 'radial-gradient(ellipse 75% 65% at 70% 0%, rgba(45,212,191,0.12), transparent 65%), radial-gradient(ellipse 55% 50% at 15% 100%, rgba(14,165,233,0.07), transparent 70%)',
};
const eyebrowColor = { gold: 'text-gold', rose: 'text-rose', teal: 'text-teal' }[theme];
const glow = glows[theme];
---

<section class="relative -mt-20 flex min-h-[54vh] items-end overflow-hidden bg-ink2 pt-40 pb-12 md:pb-16">
  <div class="pointer-events-none absolute inset-0" style={`background:${glow}`} aria-hidden="true"></div>
  {
    Astro.slots.has('bg') && (
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <slot name="bg" />
      </div>
    )
  }
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-ink/60 via-transparent to-ink" aria-hidden="true"></div>

  <div class="wrap relative">
    <p class:list={['text-[12px] font-semibold uppercase tracking-[0.2em]', eyebrowColor]} data-reveal>
      {eyebrow}
    </p>
    <h1 class="mt-6 max-w-4xl font-serif text-5xl leading-[1.04] text-cream md:text-7xl" data-reveal data-delay="0.1" set:html={title} />
    <p class="mt-6 max-w-xl text-base leading-relaxed text-cream/75 md:text-lg" data-reveal data-delay="0.2">{sub}</p>
    {
      Astro.slots.has('default') && (
        <div class="mt-8" data-reveal data-delay="0.3">
          <slot />
        </div>
      )
    }
  </div>
</section>
