---
/**
 * Confidential Self-Assessment shortcut — two placements:
 *
 *  - ≥1400px: the full vertical edge tab, sitting in the empty gutter
 *    outside the 1280px content column (narrower screens have no gutter,
 *    so the tab would cover page content there).
 *  - md–1400px: a compact floating pill at the bottom-left corner,
 *    mirroring the concierge bubble at the bottom-right — floats above
 *    content like a chat widget, never blocks reading.
 *
 * Both open the same quiz modal via [data-open-quiz].
 */
---

<!-- big screens — vertical edge tab in the gutter -->
<button
  data-open-quiz
  class="side-tab fixed top-1/2 left-0 z-[60] hidden -translate-y-1/2 cursor-pointer bg-ink2/85 px-2.5 py-6 text-[9.5px] font-semibold tracking-[0.3em] text-gold uppercase backdrop-blur transition-all duration-500 hover:bg-gold hover:text-ink min-[1400px]:block"
  aria-haspopup="dialog"
>
  <span class="side-tab-dot" aria-hidden="true"></span>
  Confidential Self-Assessment
</button>

<!-- smaller screens — floating pill, bottom-left -->
<button
  data-open-quiz
  class="side-pill fixed bottom-6 left-6 z-[60] hidden cursor-pointer items-center gap-2.5 rounded-full bg-ink2/90 px-5 py-3 text-[9.5px] font-semibold tracking-[0.25em] text-gold uppercase backdrop-blur transition-all duration-500 hover:bg-gold hover:text-ink md:flex min-[1400px]:hidden"
  aria-haspopup="dialog"
>
  <span class="side-tab-dot !m-0" aria-hidden="true"></span>
  Self-Assessment
</button>
