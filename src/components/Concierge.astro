---

<!-- Floating AI concierge — scripted prototype demo -->
<div class="fixed right-5 bottom-5 z-[115] md:right-8 md:bottom-8">
  <div
    id="concierge-panel"
    class="hairline absolute right-0 bottom-[4.5rem] flex h-[30rem] w-[calc(100vw-2.5rem)] max-w-sm flex-col bg-ink2 shadow-2xl shadow-black/60"
    role="dialog"
    aria-label="Discreet AI Concierge"
    aria-hidden="true"
  >
    <div class="hairline-b flex items-center justify-between px-5 py-4">
      <div>
        <p class="text-[10px] font-semibold tracking-[0.3em] text-gold uppercase">Discreet AI Concierge</p>
        <p class="mt-1 flex items-center gap-2 text-[10px] text-cream/45">
          <span class="h-1.5 w-1.5 rounded-full bg-gold"></span>
          Fully confidential · Clinically supervised
        </p>
      </div>
      <button data-concierge-close class="cursor-pointer text-lg font-light text-cream/50 transition-colors duration-300 hover:text-gold" aria-label="Close concierge">✕</button>
    </div>

    <div id="concierge-log" class="flex flex-1 flex-col gap-3 overflow-y-auto p-5" aria-live="polite"></div>

    <div class="hairline-t p-4">
      <div id="concierge-chips" class="mb-3 flex flex-wrap gap-2"></div>
      <form id="concierge-form" class="flex gap-2">
        <label for="concierge-input" class="sr-only">Type a message</label>
        <input id="concierge-input" class="field !py-2.5 text-xs" type="text" placeholder="Type a message…" autocomplete="off" />
        <button type="submit" class="btn btn-gold !px-4 !py-2.5" aria-label="Send">→</button>
      </form>
      <p class="mt-2 text-center text-[9px] tracking-[0.15em] text-cream/30 uppercase">Prototype demonstration — coming 2026</p>
    </div>
  </div>

  <button
    id="concierge-fab"
    class="hairline group flex h-14 w-14 cursor-pointer items-center justify-center rounded-full bg-ink2 transition-all duration-500 hover:border-gold"
    aria-label="Open the discreet AI concierge"
    aria-expanded="false"
  >
    <svg class="h-5 w-5 text-gold transition-transform duration-500 group-hover:scale-110" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
      <path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.6 8.6 0 0 1-3.9-.9L3 21l1.9-5.6a8.38 8.38 0 0 1-.9-3.9A8.5 8.5 0 0 1 12.5 3a8.38 8.38 0 0 1 8.5 8.5Z" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>
</div>
