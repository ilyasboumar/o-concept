---
/**
 * The persistent helix backdrop — mounted once, in Base.astro, on every page.
 *
 * A single fixed, full-viewport canvas that sits behind all content and above
 * the page background: one enormous horizontal DNA helix, cropped at both
 * edges, which transforms through five states as the visitor scrolls
 * (dormant → activation → separation → replication → renewed). The scene
 * itself lives in scripts/three-fx.js under data-three="helix-bg".
 *
 * The inline SVG below is the no-WebGL fallback: the same molecule, composed
 * in its dormant state. It is hidden the moment the canvas mounts.
 */

/* Fallback geometry — one dormant turn set, generated so the static frame and
   the shader agree on the same drawing. */
const W = 1600;
const H = 600;
const MID = H / 2;
const AMP = 188; // ≈63% of the frame height, peak to peak
const K = (6 * Math.PI * 2) / W; // six turns across the frame
const SAMPLES = 220;

const strand = (phase: number) =>
  Array.from({ length: SAMPLES + 1 }, (_, i) => {
    const x = (i / SAMPLES) * W;
    return `${x.toFixed(1)},${(MID + Math.cos(K * x + phase) * AMP).toFixed(1)}`;
  }).join(' ');

const rungs = Array.from({ length: 40 }, (_, i) => {
  const x = ((i + 0.5) / 40) * W;
  const c = Math.cos(K * x);
  return { x, y1: MID + c * AMP, y2: MID - c * AMP, near: Math.sin(K * x) > 0 };
});
---

<div class="helix-backdrop" data-three="helix-bg" aria-hidden="true">
  <svg
    class="three-fallback"
    viewBox={`0 0 ${W} ${H}`}
    preserveAspectRatio="xMidYMid slice"
    fill="none"
    aria-hidden="true"
  >
    <polyline points={strand(0)} stroke="#e3c992" stroke-width="2.3" opacity="0.9" vector-effect="non-scaling-stroke" />
    <polyline points={strand(Math.PI)} stroke="#e3c992" stroke-width="2.3" opacity="0.4" vector-effect="non-scaling-stroke" />
    {
      rungs.map((r) => (
        <line
          x1={r.x}
          x2={r.x}
          y1={r.y1}
          y2={r.y2}
          stroke="#f4f1ec"
          stroke-width="1.3"
          opacity={r.near ? 0.4 : 0.16}
          vector-effect="non-scaling-stroke"
        />
      ))
    }
    {
      rungs.flatMap((r) => [
        <circle cx={r.x} cy={r.y1} r="3" fill="#fdfaf3" opacity={r.near ? 0.95 : 0.35} />,
        <circle cx={r.x} cy={r.y2} r="3" fill="#fdfaf3" opacity={r.near ? 0.35 : 0.95} />,
      ])
    }
  </svg>
</div>
