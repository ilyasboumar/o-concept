---
/**
 * The O Concept™ Concierge — slim teaser. The full international journey
 * (VIP reception, transfers, world map, remote-first pathway) now lives
 * canonically on /international; this section frames it and links out.
 *
 * variant 'teaser'  = homepage — short, ends in a link to /international
 * variant 'full'    = membership page — Platinum-tier framing + link out
 */
import { withBase } from '../lib/url';

interface Props {
  variant?: 'full' | 'teaser';
}
const { variant = 'full' } = Astro.props;
---

<section class="hairline-t relative overflow-hidden bg-inkdeep" aria-labelledby="concierge-heading">
  <div class="relative py-24 md:py-32">
    <!-- cinematic private-jet background under the standard dark overlay -->
    <img
      src={withBase('images/concierge-jet-rolls.png')}
      alt=""
      class="absolute inset-0 h-full w-full object-cover"
      style="object-position: 66% 40%;"
      loading="lazy"
      aria-hidden="true"
    />
    <div
      class="pointer-events-none absolute inset-0"
      style="background:
        linear-gradient(90deg, rgba(7,7,8,0.94) 0%, rgba(7,7,8,0.78) 45%, rgba(7,7,8,0.5) 100%),
        linear-gradient(rgba(7,7,8,0.55), rgba(7,7,8,0.85));"
      aria-hidden="true"
    >
    </div>

    <div class="wrap relative">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">{variant === 'full' ? 'The Platinum experience' : 'International patients'}</p>
        <h2 id="concierge-heading" class="mt-5 font-serif text-4xl leading-tight text-cream md:text-6xl">
          The O Concept<sup class="text-[0.45em] text-gold">™</sup> Concierge
        </h2>
        <p class="mt-7 font-serif text-2xl leading-snug text-cream/90 italic md:text-3xl">
          From airstrip to clinic and back — complete discretion, door-to-door.
        </p>
        <p class="mt-6 max-w-xl text-[16px] leading-[1.9] text-cream/75">
          {
            variant === 'full'
              ? 'Included with Platinum membership: VIP airport reception, transfers between hotel and clinic throughout your stay, accommodation arranged, and treatment completed within your day — premium hospitality, entirely private.'
              : 'VIP cars at the airport, transfers throughout your stay, accommodation arranged, and treatment completed within your day. Patients travel from around the world to 77 Harley Street — we make the journey effortless.'
          }
        </p>
      </div>

      {
        variant === 'full' && (
          <ul class="mt-10 flex max-w-2xl flex-wrap gap-3" data-reveal-child>
            {['VIP airport reception', 'Hotel–clinic transfers', 'Accommodation arranged', 'Complete discretion'].map((item) => (
              <li class="hairline bg-ink/70 px-5 py-3 text-[11px] font-semibold tracking-[0.14em] text-gold/85 uppercase backdrop-blur-sm">
                {item}
              </li>
            ))}
          </ul>
        )
      }

      <div class="mt-11" data-reveal>
        <a
          href={withBase('international')}
          class:list={[variant === 'full' ? 'btn btn-gold' : 'inline-flex items-center gap-3 text-[12px] font-semibold tracking-[0.16em] text-gold uppercase transition-colors duration-400 hover:text-goldlight']}
          data-magnetic={variant === 'full' ? true : undefined}
        >
          {variant === 'full' ? 'Explore the International Service' : 'Discover our International service'}
          {variant === 'teaser' && <span aria-hidden="true">→</span>}
        </a>
      </div>
    </div>
  </div>
</section>
