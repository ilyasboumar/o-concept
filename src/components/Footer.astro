---
import { site } from '../data/site';
import { withBase } from '../lib/url';

const year = new Date().getFullYear();
const treatmentsNav = [
  { label: 'For Him', href: withBase('for-him') },
  { label: 'For Her', href: withBase('for-her') },
  { label: 'Longevity', href: withBase('longevity') },
  { label: 'All Treatments', href: withBase('treatments') },
];
const practiceNav = [
  { label: 'Membership', href: withBase('membership') },
  { label: 'International', href: withBase('international') },
  { label: 'About Dr Wakil', href: withBase('about-dr-wakil') },
  { label: 'Training & IAAGSW', href: withBase('training') },
  { label: 'Shop', href: withBase('shop') },
];

/* Social links — set href to the clinic's real profiles when available. */
const socials = [
  {
    name: 'Instagram',
    href: '#',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-[18px] w-[18px]"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>',
  },
  {
    name: 'LinkedIn',
    href: '#',
    icon: '<svg viewBox="0 0 24 24" fill="currentColor" class="h-[18px] w-[18px]"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.4c0-1.29-.02-2.95-1.8-2.95-1.8 0-2.08 1.4-2.08 2.85V21H9z"/></svg>',
  },
  {
    name: 'YouTube',
    href: '#',
    icon: '<svg viewBox="0 0 24 24" fill="currentColor" class="h-[18px] w-[18px]"><path d="M23 12s0-3.2-.4-4.7a2.5 2.5 0 0 0-1.76-1.77C19.34 5.1 12 5.1 12 5.1s-7.34 0-8.84.43A2.5 2.5 0 0 0 1.4 7.3C1 8.8 1 12 1 12s0 3.2.4 4.7a2.5 2.5 0 0 0 1.76 1.77c1.5.43 8.84.43 8.84.43s7.34 0 8.84-.43a2.5 2.5 0 0 0 1.76-1.77C23 15.2 23 12 23 12zM9.75 15.02v-6l5.2 3z"/></svg>',
  },
];
---

<footer class="hairline-t bg-inkdeep">
  <div class="wrap grid grid-cols-1 gap-14 py-20 md:grid-cols-12">
    <div class="md:col-span-4">
      <p class="font-serif text-3xl text-cream">The O Concept<sup class="text-[0.5em] text-gold">™</sup></p>
      <p class="mt-1 text-[11px] font-semibold tracking-[0.22em] text-gold/85 uppercase">by Dr SW Clinics</p>
      <p class="mt-8 max-w-sm text-sm leading-relaxed text-cream/75">
        The world&rsquo;s most awarded sexual rejuvenation protocol — regenerative, evidence-led and entirely
        confidential, delivered from Harley Street.
      </p>
      <div class="mt-8 flex gap-4" aria-label="Social media">
        {
          socials.map((s) => (
            <a
              href={s.href}
              aria-label={s.name}
              class="hairline flex h-10 w-10 items-center justify-center text-gold/85 transition-all duration-400 hover:border-gold hover:text-gold"
            >
              <Fragment set:html={s.icon} />
            </a>
          ))
        }
      </div>
    </div>

    <div class="md:col-span-2">
      <p class="eyebrow mb-7">Treatments</p>
      <ul class="space-y-4">
        {
          treatmentsNav.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-cream/75 transition-colors duration-400 hover:text-gold">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="md:col-span-3">
      <p class="eyebrow mb-7">Practice</p>
      <ul class="space-y-4">
        {
          practiceNav.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-cream/75 transition-colors duration-400 hover:text-gold">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="md:col-span-3">
      <p class="eyebrow mb-7">Contact</p>
      <address class="space-y-4 text-sm text-cream/75 not-italic">
        <p>77 Harley Street<br />London W1G 8QN</p>
        <p class="text-xs text-cream/62">Clinics in London, Dubai and Egypt — headquartered at 77 Harley Street.</p>
        <p><a href={site.phone.href} class="transition-colors duration-400 hover:text-gold">{site.phone.display}</a></p>
        <p><a href={`mailto:${site.email}`} class="transition-colors duration-400 hover:text-gold">{site.email}</a></p>
      </address>
    </div>
  </div>

  <div class="hairline-t">
    <div class="wrap flex flex-col gap-3 py-7 text-[11px] tracking-[0.12em] text-cream/62 md:flex-row md:items-center md:justify-between">
      <p>© {year} Dr SW Clinics. The O Concept™ is a registered trademark of Dr SW Clinics.</p>
      <p>GMC Registered Physicians · CQC Registered Clinic · Harley Street, London</p>
    </div>
  </div>
</footer>
