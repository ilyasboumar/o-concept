---
import { site } from '../data/site';
// Shell for the Confidential Self-Assessment — rendered client-side by initQuiz() in main.js.
// A no-JS fallback message is replaced as soon as the script runs.
---

<div class="quiz-app" data-quiz>
  <noscript>
    <p class="p-8 text-sm text-cream/75">
      The self-assessment requires JavaScript. Please call <a href={site.phone.href} class="text-gold">{site.phone.display}</a>
      to speak with our team confidentially.
    </p>
  </noscript>
</div>
