---
/**
 * "Perfused living microvasculature" — the hero background.
 *
 * TWO layers, hard-separated by the colour rule (biology = warm gold PRP,
 * instrument = restrained champagne):
 *   1. A WebGL shader plane (data-three="tissue", mounted by three-fx.js)
 *      that owns the GOLD biology — a branching capillary tree perfused
 *      with platelet-rich plasma, pulsing at a resting heart rate, growing
 *      new vessels toward the cursor (the injection site) and regenerating
 *      as you scroll. It is literally The O Concept's mechanism of action.
 *   2. A crisp, screen-space CHAMPAGNE instrument overlay (this file) —
 *      graticule, reticle corners, calibration scale, readout. Pale and
 *      low-opacity so it frames the gold biology without competing.
 *
 * Distinct from DnaHelix and CellField. Reduced-motion: the shader freezes
 * to a still frame and the instrument shows statically (no boot animation).
 * No-WebGL: the warm CSS-gradient fallback below stands in.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

/* calibration scale — long tick every 5th, a few incremental labels */
const ticks = Array.from({ length: 21 }, (_, i) => ({
  major: i % 5 === 0,
  label: i % 5 === 0 ? String(100 - i * 5) : null,
}));
---

<div class:list={['tissue-stage absolute inset-0', className]} data-tissue aria-hidden="true">
  <!-- gold biology — WebGL shader plane -->
  <div class="three-host pointer-events-none h-full w-full" data-three="tissue">
    <!-- no-WebGL / pre-mount fallback — warm perfused tissue -->
    <div
      class="three-fallback absolute inset-0"
      style="background:
        radial-gradient(ellipse 55% 50% at 60% 42%, rgba(201,169,110,0.20), transparent 60%),
        radial-gradient(ellipse 48% 44% at 30% 74%, rgba(110,30,43,0.18), transparent 64%),
        radial-gradient(ellipse 90% 80% at 50% 50%, transparent 38%, #0a0a0b 96%),
        #0a0a0b;"
    >
    </div>
  </div>

  <!-- champagne instrument furniture — crisp, screen-space, restrained -->
  <div class="tissue-instrument">
    <div class="ti-graticule"></div>
    <span class="ti-corner ti-tl"></span>
    <span class="ti-corner ti-tr"></span>
    <span class="ti-corner ti-bl"></span>
    <span class="ti-corner ti-br"></span>

    <div class="ti-readout">
      <span class="ti-dot"></span>PRP&nbsp;·&nbsp;PERFUSION&nbsp;&nbsp;|&nbsp;&nbsp;MICROVASCULAR DENSITY 98.7%
    </div>

    <div class="ti-scale">
      {
        ticks.map((t) => (
          <span class="ti-tick-row">
            {t.label && <em class="ti-label">{t.label}</em>}
            <i class:list={['ti-tick', t.major && 'ti-tick-major']} />
          </span>
        ))
      }
      <span class="ti-unit">µm</span>
    </div>
  </div>
</div>

<style>
  .tissue-instrument {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  /* ultra-fine measurement graticule — pale champagne, very low opacity */
  .ti-graticule {
    position: absolute;
    inset: 0;
    opacity: 0.05;
    background-image:
      repeating-linear-gradient(0deg, rgba(244, 241, 236, 0.9) 0 1px, transparent 1px 46px),
      repeating-linear-gradient(90deg, rgba(244, 241, 236, 0.9) 0 1px, transparent 1px 46px);
    -webkit-mask-image: radial-gradient(ellipse 82% 76% at 50% 46%, #000, transparent 84%);
    mask-image: radial-gradient(ellipse 82% 76% at 50% 46%, #000, transparent 84%);
  }

  /* reticle corner brackets */
  .ti-corner {
    position: absolute;
    width: 26px;
    height: 26px;
    border: 1px solid rgba(244, 241, 236, 0.42);
  }
  .ti-tl { top: 20px; left: 20px; border-right: 0; border-bottom: 0; }
  .ti-tr { top: 20px; right: 20px; border-left: 0; border-bottom: 0; }
  .ti-bl { bottom: 20px; left: 20px; border-right: 0; border-top: 0; }
  .ti-br { bottom: 20px; right: 20px; border-left: 0; border-top: 0; }

  /* readout cluster */
  .ti-readout {
    position: absolute;
    top: 104px;
    right: 26px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans);
    font-size: 8.5px;
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: rgba(244, 241, 236, 0.5);
    white-space: nowrap;
  }
  .ti-dot {
    width: 5px;
    height: 5px;
    border-radius: 9999px;
    background: var(--color-gold);
    box-shadow: 0 0 8px rgba(201, 169, 110, 0.8);
    animation: tiPulse 1s ease-in-out infinite;
  }

  /* calibration scale down the right edge */
  .ti-scale {
    position: absolute;
    right: 18px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    opacity: 0.5;
  }
  .ti-tick-row {
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .ti-label {
    font-family: var(--font-sans);
    font-size: 7.5px;
    font-style: normal;
    letter-spacing: 0.1em;
    color: rgba(244, 241, 236, 0.7);
  }
  .ti-tick {
    display: block;
    width: 7px;
    height: 1px;
    background: rgba(244, 241, 236, 0.65);
  }
  .ti-tick-major {
    width: 13px;
  }
  .ti-unit {
    margin-top: 3px;
    font-family: var(--font-sans);
    font-size: 7px;
    letter-spacing: 0.14em;
    color: rgba(244, 241, 236, 0.55);
  }

  /* the readout dot pulses at the resting heart rate (~60bpm) */
  @keyframes tiPulse {
    0%, 100% { opacity: 0.4; transform: scale(1); }
    12% { opacity: 1; transform: scale(1.35); }
    40% { opacity: 0.4; transform: scale(1); }
  }

  /* boot: the instrument powers on — graticule draws in first, then the
     furniture. Only while the stage is in its booting state. */
  .tissue-booting .ti-graticule {
    animation: tiGrid 0.5s ease 0.05s both;
  }
  .tissue-booting .ti-corner,
  .tissue-booting .ti-readout,
  .tissue-booting .ti-scale {
    animation: tiFurniture 0.6s ease 0.28s both;
  }
  @keyframes tiGrid {
    from { opacity: 0; transform: scale(1.05); }
    to { opacity: 0.05; transform: none; }
  }
  @keyframes tiFurniture {
    from { opacity: 0; }
  }

  /* small screens: keep graticule + reticle, drop the finer furniture */
  @media (max-width: 640px) {
    .ti-scale,
    .ti-readout {
      display: none;
    }
    .ti-corner {
      width: 18px;
      height: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ti-dot { animation: none; }
    .tissue-booting .ti-graticule,
    .tissue-booting .ti-corner,
    .tissue-booting .ti-readout,
    .tissue-booting .ti-scale {
      animation: none;
    }
  }
</style>
