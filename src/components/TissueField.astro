---
/**
 * Hero helix instrument — the WebGL host + its crisp champagne instrument
 * furniture. The shader (three-fx.js, data-three="tissue") renders a DNA
 * double helix as a hairline technical drawing in the negative space
 * between the headline and the portrait; this file supplies the pixel-crisp,
 * screen-space instrument frame (reticle brackets, calibration scale,
 * micro-readout) and the transcription read-head bracket.
 *
 * Distinct from the glowing DnaHelix in the science section. Reduced-motion:
 * static helix + static instrument. No-WebGL: clean near-black fallback.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

/* calibration scale — long tick every 5th, a few incremental labels (bp) */
const ticks = Array.from({ length: 21 }, (_, i) => ({
  major: i % 5 === 0,
  label: i % 5 === 0 ? String((20 - i) * 12) : null,
}));
---

<div class:list={['tissue-stage absolute inset-0', className]} data-tissue aria-hidden="true">
  <!-- helix — WebGL hairline instrument -->
  <div class="three-host pointer-events-none h-full w-full" data-three="tissue">
    <!-- no-WebGL / pre-mount fallback — clean near-black -->
    <div
      class="three-fallback absolute inset-0"
      style="background:
        radial-gradient(ellipse 30% 62% at 60% 50%, rgba(227,201,146,0.06), transparent 70%),
        #0a0a0b;"
    >
    </div>
  </div>

  <!-- champagne instrument furniture — crisp, screen-space, restrained -->
  <div class="tissue-instrument">
    <span class="ti-corner ti-tl"></span>
    <span class="ti-corner ti-tr"></span>
    <span class="ti-corner ti-bl"></span>
    <span class="ti-corner ti-br"></span>

    <div class="ti-readout">
      <span class="ti-dot"></span>TRANSCRIPTION&nbsp;·&nbsp;ACTIVE&nbsp;&nbsp;|&nbsp;&nbsp;PDGF · VEGF · TGF-β
    </div>

    <div class="ti-scale">
      {
        ticks.map((t) => (
          <span class="ti-tick-row">
            {t.label && <em class="ti-label">{t.label}</em>}
            <i class:list={['ti-tick', t.major && 'ti-tick-major']} />
          </span>
        ))
      }
      <span class="ti-unit">bp</span>
    </div>

    <!-- transcription read-head bracket — positioned by three-fx.js -->
    <div class="ti-readhead" data-readhead>
      <span class="rh-l"></span>
      <span class="rh-r"></span>
    </div>
  </div>
</div>

<style>
  .tissue-instrument {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  /* reticle corner brackets */
  .ti-corner {
    position: absolute;
    width: 24px;
    height: 24px;
    border: 1px solid rgba(244, 241, 236, 0.34);
  }
  .ti-tl { top: 22px; left: 22px; border-right: 0; border-bottom: 0; }
  .ti-tr { top: 22px; right: 22px; border-left: 0; border-bottom: 0; }
  .ti-bl { bottom: 22px; left: 22px; border-right: 0; border-top: 0; }
  .ti-br { bottom: 22px; right: 22px; border-left: 0; border-top: 0; }

  /* readout cluster */
  .ti-readout {
    position: absolute;
    top: 104px;
    right: 26px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans);
    font-size: 8.5px;
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: rgba(244, 241, 236, 0.5);
    white-space: nowrap;
  }
  .ti-dot {
    width: 5px;
    height: 5px;
    border-radius: 9999px;
    background: var(--color-goldlight);
    box-shadow: 0 0 8px rgba(227, 201, 146, 0.8);
    animation: tiPulse 3.2s ease-in-out infinite;
  }

  /* calibration scale down the right edge */
  .ti-scale {
    position: absolute;
    right: 20px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    opacity: 0.5;
  }
  .ti-tick-row { display: flex; align-items: center; gap: 7px; }
  .ti-label {
    font-family: var(--font-sans);
    font-size: 7.5px;
    font-style: normal;
    letter-spacing: 0.1em;
    color: rgba(244, 241, 236, 0.7);
  }
  .ti-tick { display: block; width: 7px; height: 1px; background: rgba(244, 241, 236, 0.6); }
  .ti-tick-major { width: 13px; }
  .ti-unit {
    margin-top: 3px;
    font-family: var(--font-sans);
    font-size: 7px;
    letter-spacing: 0.14em;
    color: rgba(244, 241, 236, 0.55);
  }

  /* transcription read-head bracket — a bracket, never a ring */
  .ti-readhead {
    position: absolute;
    top: -22px;
    left: 56%;
    width: 92px;
    height: 44px;
    opacity: 0;
    transition: opacity 0.35s ease;
    will-change: transform;
  }
  .ti-readhead .rh-l,
  .ti-readhead .rh-r {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 8px;
    border: 1px solid rgba(227, 201, 146, 0.85);
  }
  .ti-readhead .rh-l { left: 0; border-right: 0; }
  .ti-readhead .rh-r { right: 0; border-left: 0; }

  @keyframes tiPulse {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 1; }
  }

  /* boot: the instrument frame powers on */
  .tissue-booting .ti-corner,
  .tissue-booting .ti-readout,
  .tissue-booting .ti-scale {
    animation: tiFurniture 0.7s ease 0.25s both;
  }
  @keyframes tiFurniture {
    from { opacity: 0; }
  }

  @media (max-width: 640px) {
    .ti-scale, .ti-readout { display: none; }
    .ti-corner { width: 18px; height: 18px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ti-dot { animation: none; }
    .tissue-booting .ti-corner,
    .tissue-booting .ti-readout,
    .tissue-booting .ti-scale { animation: none; }
  }
</style>
