---
/**
 * "Find Your Treatment" — the diagnostic console. Start from the CONDITION,
 * get routed to the TREATMENT.
 *
 * Conditions are indexed under body systems (data: conditionsBySystem) and
 * presented behind HUD-style tabs — a flat chip wall does not scale to a
 * catalogue of 100+ protocols. Each condition chip carries the clinical
 * term AND the plain-language phrase patients actually type.
 *
 * Free-text search (top) matches across everything regardless of the
 * active system. Matching runs client-side in main.js against
 * src/data/treatments.ts. Instant, nothing stored.
 */
import { withBase } from '../lib/url';
import { conditionsBySystem, treatments } from '../data/treatments';

const groups = conditionsBySystem();
const txCount = treatments.length;
const condCount = groups.reduce((n, g) => n + g.conditions.length, 0);
---

<section id="finder" class="hairline-teal-t relative overflow-hidden bg-ink2 py-24 md:py-32" aria-labelledby="finder-heading">
  <div class="pointer-events-none absolute inset-0 glow-teal" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute inset-0"
    style="background: radial-gradient(ellipse 45% 40% at 85% 90%, rgba(201,169,110,0.05), transparent 65%);"
    aria-hidden="true"
  >
  </div>
  <div class="grid-overlay" aria-hidden="true"></div>

  <div class="wrap relative">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="eyebrow-teal">Start from what you feel</p>
      <h2 id="finder-heading" class="mt-5 font-serif text-4xl leading-tight text-cream md:text-5xl">
        Find your treatment.
      </h2>
      <p class="mt-6 text-[15px] leading-relaxed text-cream/60">
        Describe your concern in your own words — or explore by system below. We&rsquo;ll show you the treatments that
        address it, instantly and privately. Nothing you type is stored or sent.
      </p>
      <!-- diagnostic readout -->
      <p class="mt-5 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-[9.5px] font-semibold tracking-[0.3em] text-teal/70 uppercase" aria-hidden="true">
        <span>{condCount} conditions indexed</span>
        <span class="h-[3px] w-[3px] rounded-full bg-teal/50"></span>
        <span>{txCount} signature protocols</span>
        <span class="h-[3px] w-[3px] rounded-full bg-teal/50"></span>
        <span>3 pathways</span>
      </p>
    </div>

    <div class="mx-auto mt-12 max-w-3xl" data-reveal data-delay="0.15">
      <label for="finder-input" class="sr-only">Describe your concern</label>
      <div class="relative">
        <input
          id="finder-input"
          class="field !border-teal/25 !px-6 !py-5 text-base focus:!border-teal"
          type="text"
          placeholder="Try “difficulty keeping an erection”, “dryness”, “low energy”, “leaking”…"
          autocomplete="off"
        />
        <span class="pointer-events-none absolute top-1/2 right-6 -translate-y-1/2 text-teal/60" aria-hidden="true">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" stroke-linecap="round" />
          </svg>
        </span>
      </div>
    </div>

    <!-- system tabs — the console selector -->
    <div class="mt-10 flex flex-wrap justify-center gap-2" data-finder-systems role="tablist" aria-label="Condition systems" data-reveal data-delay="0.2">
      {
        groups.map((g, i) => (
          <button type="button" class:list={['sys-tab', i === 0 && 'active']} data-system={g.id} role="tab" aria-selected={i === 0 ? 'true' : 'false'}>
            {g.label}
            <span class="sys-count" aria-hidden="true">{g.conditions.length}</span>
          </button>
        ))
      }
    </div>

    <!-- condition panels, one per system -->
    <div class="mx-auto mt-7 max-w-5xl" data-finder-chips>
      {
        groups.map((g, i) => (
          <div
            class:list={['sys-panel grid grid-cols-1 gap-2.5 sm:grid-cols-2 lg:grid-cols-3', i !== 0 && 'hidden']}
            data-system-panel={g.id}
            role="tabpanel"
          >
            {g.conditions.map((c) => (
              <button type="button" class="chip cond-chip" data-condition={c.clinical}>
                <span class="cond-name">{c.clinical}</span>
                <span class="cond-plain">“{c.plain}”</span>
              </button>
            ))}
          </div>
        ))
      }
    </div>

    <p class="mt-8 text-center text-[10px] font-semibold tracking-[0.25em] text-cream/40 uppercase" data-finder-catalogue data-reveal>
      Part of a catalogue of 100+ protocols —
      <a href={withBase('treatments')} class="text-teal transition-colors duration-300 hover:text-cream">browse the full treatment index →</a>
    </p>

    <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3" data-finder-results aria-live="polite">
      <!-- matching treatment cards are rendered here by main.js -->
    </div>
    <p class="mt-10 hidden text-center text-sm text-cream/50" data-finder-empty>
      No direct match — but that does not mean no answer. <a href="#begin" class="text-teal underline underline-offset-4">Book a confidential consultation</a> and we&rsquo;ll take it from there.
    </p>
  </div>
</section>
