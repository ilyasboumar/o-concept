---
/**
 * Longevity teaser — homepage. The stem-cell particle field (CellField,
 * Three.js) drifts behind the content at low opacity.
 */
import { withBase } from '../lib/url';
import CellField from './CellField.astro';

const pillars = [
  'Bio-hacking & supplementation',
  'Hormone optimisation',
  'IV nutritional therapy',
  'Regenerative stem-cell medicine',
  'Expert dietician programmes',
  'Kinetic body-movement therapy',
];
---

<section class="hairline-teal-t relative overflow-hidden bg-inkdeep py-28 md:py-40" aria-labelledby="longevity-teaser-heading">
  <!-- stem-cell particle field — always behind content -->
  <div class="absolute inset-0" aria-hidden="true">
    <CellField count={200} opacity={0.5} size={0.38} />
  </div>
  <div class="pointer-events-none absolute inset-0" style="background: radial-gradient(ellipse 70% 60% at 50% 50%, transparent 30%, #16181d 95%);" aria-hidden="true"></div>

  <div class="wrap relative">
    <div class="max-w-3xl" data-reveal>
      <p class="eyebrow-teal">The third pathway</p>
      <h2 id="longevity-teaser-heading" class="mt-5 font-serif text-5xl leading-[1.05] text-cream md:text-7xl">
        Longevity is a <span class="bg-gradient-to-r from-teal to-tealdeep bg-clip-text text-transparent italic">medical discipline.</span>
      </h2>
      <p class="mt-7 max-w-xl text-base leading-relaxed text-cream/75">
        Dr Wakil&rsquo;s life-optimisation and regenerative programme treats ageing the way we treat everything else:
        measure it, understand it, and intervene at the cause — cells, hormones, metabolism, movement.
      </p>
    </div>

    <ul class="mt-12 flex max-w-3xl flex-wrap gap-3" data-reveal-child>
      {
        pillars.map((p) => (
          <li class="hairline-teal bg-ink/60 px-5 py-3 text-[12px] font-medium tracking-[0.14em] text-cream/75 uppercase backdrop-blur-sm">
            {p}
          </li>
        ))
      }
    </ul>

    <div class="mt-12" data-reveal>
      <a href={withBase('longevity')} class="btn btn-teal" data-magnetic>Explore the Longevity Programme</a>
    </div>
  </div>
</section>
