---
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/500.css';
import '@fontsource/manrope/600.css';
import '@fontsource/manrope/700.css';
import '../styles/global.css';

import { withBase } from '../lib/url';
import AwardsStrip from '../components/AwardsStrip.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WelcomePopup from '../components/WelcomePopup.astro';
import QuizModal from '../components/QuizModal.astro';
import Concierge from '../components/Concierge.astro';
import SideTab from '../components/SideTab.astro';

interface Props {
  title: string;
  description: string;
  /** Optional extra JSON-LD objects (FAQPage, MedicalProcedure, …) injected per page */
  schema?: object[];
}

const { title, description, schema = [] } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;

/* Global structured data — Dr Wakil (Physician) + the clinic (MedicalClinic).
   Emitted on every page so search engines and LLM answer engines associate
   the practice, the address and the awards with every treatment query. */
const globalSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalClinic',
    name: 'Dr SW Clinics — The O Concept™',
    description:
      'The world’s most awarded sexual rejuvenation and regenerative clinic. Home of The O Concept™, created by Dr Sherif Wakil.',
    url: Astro.site ? new URL(withBase(), Astro.site).href : undefined,
    telephone: '+44 20 3006 8459',
    email: 'info@drswclinics.com',
    address: {
      '@type': 'PostalAddress',
      streetAddress: '77 Harley Street',
      addressLocality: 'London',
      postalCode: 'W1G 8QN',
      addressCountry: 'GB',
    },
    medicalSpecialty: ['Sexual rejuvenation medicine', 'Regenerative medicine', 'Longevity medicine'],
    award: [
      'Global Excellence Awards 2025 — The O Concept™ Protocol',
      '2024 World’s Best Sexual Rejuvenation Clinic',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Physician',
    name: 'Dr Sherif Wakil',
    honorificPrefix: 'Dr',
    jobTitle: 'Founder & Medical Director, Dr SW Clinics',
    description:
      'Creator of The O Concept™ — the world’s most awarded sexual rejuvenation and regenerative protocol, with more than 25,000 cases worldwide. The first physician to bring the O-Shot® and P-Shot® to the UK. President & Founder of the IAAGSW. Founder of Andropause Recognition Day (1st June). Clinics in London, Dubai and Egypt — headquartered at 77 Harley Street.',
    workLocation: {
      '@type': 'Place',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '77 Harley Street',
        addressLocality: 'London',
        postalCode: 'W1G 8QN',
        addressCountry: 'GB',
      },
    },
    award: [
      'Global Excellence Awards 2025 — The O Concept™ Protocol',
      '2024 World’s Best Sexual Rejuvenation Clinic',
      'President & Founder, International Association of Aesthetic Gynaecology and Sexual Well-being (IAAGSW)',
    ],
    knowsAbout: [
      'Sexual rejuvenation',
      'Andropause',
      'Regenerative medicine',
      'Hormone optimisation',
      'Aesthetic gynaecology',
    ],
  },
];
---

<!doctype html>
<html lang="en-GB" class="grain">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#0A0A0B" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="sitemap" href={withBase('sitemap-index.xml')} />
    {
      [...globalSchema, ...schema].map((obj) => (
        <script type="application/ld+json" set:html={JSON.stringify(obj)} />
      ))
    }
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="min-h-screen">
    <AwardsStrip />
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <SideTab />
    <Concierge />
    <QuizModal />
    <WelcomePopup />

    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
