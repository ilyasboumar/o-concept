---
/**
 * Training & IAAGSW.
 *
 * Every word, photograph, list and fact comes from src/content/pages/training.json,
 * and the application form from src/content/forms/training-application.json —
 * so the fellowship's steps, the IAAGSW facts panel and the questions asked of
 * applicants are all the clinic's to change.
 *
 * "Teaching & speaking" below is the shared block (teaching.json), and the
 * curriculum list is hidden here because this page covers it in full.
 */
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FinalCTA from '../components/FinalCTA.astro';
import TeachingRecord from '../components/TeachingRecord.astro';
import Form from '../components/Form.astro';
import Copy from '../components/Copy.astro';
import { imageUrl } from '../lib/url';
import { trainingVideo } from '../data/videos';
import { trainingPage as t } from '../data/pages';
import { shown } from '../data/home';
import { autoRowStyle } from '../lib/layout';

const heroTitle = t.hero.heading.replace(/\*(.+?)\*/g, "<em class='text-gold'>$1</em>");
---

<Base
  title="Training & IAAGSW — Learn The O Concept™ from its Creator | Dr Sherif Wakil"
  description="The O Concept™ Training Fellowship: masterclasses, hands-on Harley Street training and certification for medical professionals — taught by Dr Sherif Wakil, creator of the protocol and President & Founder of the IAAGSW."
>
  <PageHero eyebrow={t.hero.eyebrow} title={heroTitle} sub={t.hero.sub}>
    <!-- authority hook — in the first viewport, not two scrolls down -->
    <ul class="flex flex-wrap gap-3" aria-label="Training credentials">
      {
        t.hero.chips.map((item) => (
          <li class="hairline bg-ink/60 px-5 py-3 text-[11px] font-semibold tracking-[0.14em] text-gold/85 uppercase backdrop-blur-sm">
            {item}
          </li>
        ))
      }
    </ul>
  </PageHero>

  <!-- cinematic band — real training photography, directly under the hero -->
  <section class="relative overflow-hidden" aria-label="The O Concept™ training in session">
    <img
      src={imageUrl(t.banner.image)}
      alt={t.banner.alt}
      class="h-[46vh] w-full object-cover md:h-[56vh]"
      data-parallax="-5"
    />
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink via-ink/25 to-ink/30" aria-hidden="true"></div>
    <div class="absolute right-0 bottom-8 left-0 md:bottom-10">
      <div class="wrap">
        <p class="eyebrow !text-[11px]" data-reveal>{t.banner.eyebrow}</p>
        <p class="mt-2 max-w-lg font-serif text-2xl leading-snug text-cream md:text-3xl" data-reveal data-delay="0.1">
          <Copy text={t.banner.caption} em="text-gold" italic />
        </p>
      </div>
    </div>
  </section>

  <!-- positioning -->
  <section class="relative bg-ink py-24 md:py-32">
    <div class="pointer-events-none absolute inset-0 glow-gold" aria-hidden="true"></div>
    <div class="wrap relative grid grid-cols-1 gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-7" data-reveal>
        <p class="eyebrow">{t.positioning.eyebrow}</p>
        <h2 class="mt-5 font-serif text-4xl leading-tight text-cream md:text-5xl">
          <Copy text={t.positioning.heading} em="text-gold" italic sup="text-[0.45em] text-gold" />
        </h2>
        <div class="mt-8 space-y-6 text-[16px] leading-[1.9] text-cream/75">
          {t.positioning.paragraphs.map((para) => (
            <p>
              <Copy text={para} em="text-gold" />
            </p>
          ))}
        </div>
        <ul class="mt-9 space-y-3" data-reveal-child>
          {t.positioning.audience.map((a) => (
            <li class="flex items-center gap-3 text-sm text-cream/75">
              <span class="h-px w-6 shrink-0 bg-gold" aria-hidden="true" />
              {a}
            </li>
          ))}
        </ul>
      </div>
      <div class="lg:col-span-5" data-reveal data-delay="0.15">
        <figure class="hairline p-2">
          <div class="overflow-hidden">
            <img
              src={imageUrl(t.positioning.photo.image)}
              alt={t.positioning.photo.alt}
              class="aspect-[4/5] w-full scale-[1.06] object-cover"
              loading="lazy"
              data-parallax="-4"
            />
          </div>
          <figcaption class="px-2 pt-3 pb-1 text-[11px] font-semibold tracking-[0.18em] text-cream/62 uppercase">
            {t.positioning.photo.caption}
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- fellowship -->
  <section class="hairline-t relative bg-ink2 py-24 md:py-32">
    <div class="wrap">
      <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="max-w-2xl lg:col-span-7" data-reveal>
          <p class="eyebrow">{t.fellowship.eyebrow}</p>
          <h2 class="mt-5 font-serif text-4xl leading-tight text-cream md:text-5xl">
            <Copy text={t.fellowship.heading} em="text-gold" italic sup="text-[0.45em] text-gold" />
          </h2>
          <p class="mt-6 text-[16px] leading-relaxed text-cream/75">{t.fellowship.intro}</p>
        </div>
        <figure class="hairline p-2 lg:col-span-5" data-reveal data-delay="0.15">
          <div class="overflow-hidden">
            <img
              src={imageUrl(t.fellowship.photo.image)}
              alt={t.fellowship.photo.alt}
              class="aspect-[3/2] w-full object-cover"
              loading="lazy"
            />
          </div>
          <figcaption class="px-2 pt-3 pb-1 text-[11px] font-semibold tracking-[0.18em] text-cream/62 uppercase">
            {t.fellowship.photo.caption}
          </figcaption>
        </figure>
      </div>

      <div class="auto-row mt-16" style={autoRowStyle(t.fellowship.steps.length)} data-reveal-child>
        {t.fellowship.steps.map((f, i) => (
          <div class="hairline flex flex-col bg-ink p-9" data-tilt>
            <span class="font-serif text-4xl text-gold">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-5 font-serif text-2xl text-cream">{f.title}</h3>
            <p class="mt-4 text-sm leading-[1.85] text-cream/75">
              <Copy text={f.text} em="text-gold" />
            </p>
          </div>
        ))}
      </div>
      {t.fellowship.note && (
        <p class="mt-10 text-[11px] tracking-[0.16em] text-cream/62 uppercase" data-reveal>{t.fellowship.note}</p>
      )}
    </div>
  </section>

  <!-- IAAGSW -->
  <section class="hairline-teal-t relative overflow-hidden bg-ink py-24 md:py-32">
    <div class="pointer-events-none absolute inset-0 glow-teal" aria-hidden="true"></div>
    <div class="wrap relative grid grid-cols-1 gap-14 lg:grid-cols-12">
      <div class="lg:col-span-6" data-reveal>
        <p class="eyebrow-teal">{t.iaagsw.eyebrow}</p>
        <h2 class="mt-5 font-serif text-4xl leading-tight text-cream md:text-5xl">{t.iaagsw.heading}</h2>
        <p class="mt-4 font-serif text-2xl leading-snug text-cream/90 italic">{t.iaagsw.tagline}</p>
        <div class="mt-7 space-y-6 text-[16px] leading-[1.9] text-cream/75">
          {t.iaagsw.paragraphs.map((para) => (
            <p>
              <Copy text={para} em="text-teal" />
            </p>
          ))}
        </div>
      </div>
      <div class="flex flex-col justify-center gap-6 lg:col-span-6" data-reveal data-delay="0.15">
        <!-- credibility image — the first world congress -->
        <figure class="hairline-teal bg-ink p-2">
          <div class="overflow-hidden">
            <img
              src={imageUrl(t.iaagsw.photo.image)}
              alt={t.iaagsw.photo.alt}
              class="aspect-[16/9] w-full object-cover"
              loading="lazy"
            />
          </div>
          <figcaption class="px-2 pt-3 pb-1 text-[11px] font-semibold tracking-[0.18em] text-cream/62 uppercase">
            {t.iaagsw.photo.caption}
          </figcaption>
        </figure>

        {/* each cell carries its own hairline: the container's background used to
            show through the 1px gaps, which meant removing a fact left a
            coloured rectangle where the cell had been */}
        <div class="auto-row" style={`${autoRowStyle(t.iaagsw.facts.length, 2)}; --row-gap:1px`}>
          {
            t.iaagsw.facts.map((cell) => (
              <div class="hairline-teal bg-ink p-8">
                <p class="text-[11px] font-semibold tracking-[0.17em] text-teal/80 uppercase">{cell.k}</p>
                <p class="mt-3 font-serif text-xl leading-snug text-cream">{cell.v}</p>
              </div>
            ))
          }
        </div>
        <div>
          <a href={t.iaagsw.link.href} target="_blank" rel="noopener" class="btn btn-teal" data-magnetic>
            {t.iaagsw.link.text}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- What delegates say -->
  <section class="hairline-t relative bg-ink2 py-24 md:py-32">
    <div class="pointer-events-none absolute inset-0 glow-gold" aria-hidden="true"></div>
    <div class="wrap relative grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5" data-reveal>
        <p class="eyebrow">{t.delegates.eyebrow}</p>
        <h2 class="mt-5 font-serif text-4xl leading-tight text-cream md:text-5xl">
          <Copy text={t.delegates.heading} em="text-gold" italic />
        </h2>
        <blockquote class="mt-8">
          <p class="font-serif text-2xl leading-snug text-cream/90 italic">
            <span class="mr-1 font-serif text-4xl leading-none text-gold" aria-hidden="true">“</span>
            {trainingVideo.quote}
          </p>
          <footer class="mt-5 text-[11px] font-semibold tracking-[0.17em] text-gold/80 uppercase">{trainingVideo.attribution}</footer>
        </blockquote>
      </div>
      <div class="lg:col-span-7" data-reveal data-delay="0.15">
        <div
          class="video-facade group"
          data-video-facade
          data-video-id={trainingVideo.id}
          role="button"
          tabindex="0"
          aria-label={`Play video: ${trainingVideo.title}`}
        >
          <img
            src={`https://i.ytimg.com/vi/${trainingVideo.id}/hqdefault.jpg`}
            alt=""
            class="absolute inset-0 h-full w-full object-cover opacity-80"
            loading="lazy"
          />
          <span class="video-play" aria-hidden="true">
            <svg class="ml-1 h-5 w-5 text-gold" viewBox="0 0 24 24" fill="currentColor">
              <path d="M8 5.5v13l11-6.5-11-6.5Z" />
            </svg>
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- practitioner CTA -->
  <section class="hairline-t relative overflow-hidden bg-inkdeep py-28 md:py-36">
    <div
      class="pointer-events-none absolute inset-0"
      style="background: radial-gradient(ellipse 70% 60% at 50% 110%, rgba(201,169,110,0.13), transparent 70%);"
      aria-hidden="true"
    >
    </div>
    <div class="wrap relative">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow" data-reveal>{t.apply.eyebrow}</p>
        <h2 class="mt-6 font-serif text-5xl leading-[1.05] text-cream md:text-6xl" data-reveal data-delay="0.1">
          <Copy text={t.apply.heading} em="text-gold" italic sup="text-[0.4em] text-gold" />
        </h2>
        <p class="mx-auto mt-7 max-w-xl text-base leading-relaxed text-cream/75" data-reveal data-delay="0.2">
          {t.apply.sub}
        </p>
      </div>

      {/* the application itself — every question of it edited in the CMS.
          It used to be a mailto link, and a broken one: the address was written
          inside a quoted attribute, so it never interpolated and the button
          opened a blank email addressed to the literal text. */}
      <div class="hairline mx-auto mt-14 max-w-3xl bg-ink2 p-8 md:p-12" data-reveal data-delay="0.3">
        <Form form="training-application" compact />
      </div>
    </div>
  </section>

  <TeachingRecord showProgrammes={false} />

  <FinalCTA heading={t.finalCta.heading} sub={t.finalCta.sub} />
</Base>
