---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Journey from '../components/Journey.astro';
import FinalCTA from '../components/FinalCTA.astro';
import AndropauseSection from '../components/AndropauseSection.astro';
import FeaturedSpotlight from '../components/FeaturedSpotlight.astro';
import TreatmentCarousel from '../components/TreatmentCarousel.astro';
import { imageUrl } from '../lib/url';
import { treatments } from '../data/treatments';

const himTreatments = [
  ...treatments.filter((t) => t.pathway === 'him'),
  ...treatments.filter((t) => t.slug === 'endo-test'),
];

const faqs = [
  {
    q: 'Why can’t I get or keep an erection like I used to?',
    a: 'Most erectile dysfunction is vascular, hormonal or neurological — a physical change that can be measured. Blood flow declines, testosterone falls, tissue quality changes. These are treatable causes: The O Concept™ for Him combines diagnostics (Endo Test), regenerative medicine (P-Shot®), shockwave therapy (ESWT) and hormonal optimisation to treat them at source, without surgery.',
  },
  {
    q: 'Is treatment for erectile dysfunction painful, and is there downtime?',
    a: 'The protocol is non-surgical and minimally invasive. The P-Shot® uses numbing cream and a fine needle; ESWT shockwave feels like light tapping; the O Concept™ Chair is done fully clothed. Most men return to their normal day immediately after each session.',
  },
  {
    q: 'What is andropause — and could it explain my low energy and weight gain?',
    a: 'Andropause (the "male menopause") is the gradual decline in testosterone from around age 40, causing fatigue, low mood, weight gain around the middle, low drive and brain fog. It is diagnosed with a full hormonal panel and treated with physician-led optimisation. Dr Wakil founded Andropause Recognition Day (1st June) to bring this condition into the open.',
  },
  {
    q: 'Will anyone know I’m being treated?',
    a: 'No. Consultations are private and unhurried, correspondence is unmarked, invoices are discreetly worded, and private appointment times are available on request. Discretion is not a courtesy here; it is policy.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const procedureSchema = himTreatments.map((t) => ({
  '@context': 'https://schema.org',
  '@type': 'MedicalProcedure',
  name: t.name,
  description: t.desc,
  procedureType: 'https://schema.org/NoninvasiveProcedure',
  relevantSpecialty: 'Male sexual rejuvenation medicine',
}));
---

<Base
  title="Erectile Dysfunction & Male Sexual Rejuvenation Treatment — The O Concept™ for Him | Harley Street"
  description="Difficulty getting or keeping an erection? Low drive, low energy after 40? Non-surgical treatment for erectile dysfunction, Peyronie's and andropause — P-Shot®, ESWT shockwave, Bocox™ and hormone optimisation by Dr Sherif Wakil, 77 Harley Street."
  schema={[faqSchema, ...procedureSchema]}
>
  <PageHero
    eyebrow="The O Concept™ for Him"
    title="For the concerns men <em class='text-gold'>rarely discuss.</em>"
    sub="Erectile function, performance, drive. These are medical matters with medical answers — and addressing them early is the strongest move a man can make."
  />

  <FeaturedSpotlight pageKey="for-him" />
  <TreatmentCarousel pathway="him" />

  <section class="relative bg-ink py-24 md:py-32">
    <div class="pointer-events-none absolute inset-0 glow-gold" aria-hidden="true"></div>
    <div class="wrap relative">
      <div class="grid gap-12 lg:grid-cols-12" data-reveal>
        <div class="lg:col-span-5">
          <p class="eyebrow">Cause, not symptom</p>
          <h2 class="mt-5 font-serif text-4xl leading-tight text-cream">Function is physiology. Physiology can be treated.</h2>
        </div>
        <div class="space-y-6 text-[15px] leading-[1.9] text-cream/65 lg:col-span-7">
          <p>
            Most male sexual dysfunction is vascular, hormonal or neurological — measurable, and in most cases,
            treatable without surgery or a lifetime of tablets. The O Concept™ for Him begins with a full diagnostic
            picture, then rebuilds function using regenerative and energy-based medicine.
          </p>
          <p>
            Every consultation is private, unhurried and free of judgement. Many of our patients tell us the hardest
            step was the phone call; everything after it was straightforward.
          </p>
        </div>
      </div>

      <div class="mt-20 grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-reveal-child>
        {
          himTreatments.map((t) => (
            <div id={t.slug} class="hairline group flex flex-col overflow-hidden bg-ink2 transition-colors duration-500 hover:border-gold/50" data-tilt>
              <div class="relative aspect-[3/2] overflow-hidden">
                <img
                  src={imageUrl(t.image)}
                  alt={t.imageAlt}
                  class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.05]"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-ink2 via-ink/20 to-ink/5" aria-hidden="true"></div>
              </div>
              <div class="flex flex-1 flex-col p-8 pt-6">
              <span class="text-[9px] font-bold tracking-[0.3em] text-gold/70 uppercase">{t.tag}</span>
              <h3 class="mt-4 font-serif text-2xl text-cream">{t.name}</h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-cream/55">{t.desc}</p>
              <div class="mt-6 flex flex-wrap gap-1.5">
                {t.conditions.slice(0, 3).map((c) => (
                  <span class="condition-chip" title={c.plain}>{c.clinical}</span>
                ))}
              </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Andropause — folded in, as the client requested -->
  <AndropauseSection />

  <!-- FAQ -->
  <section class="hairline-t bg-ink py-24 md:py-32">
    <div class="wrap grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-4" data-reveal>
        <p class="eyebrow">Asked quietly, often</p>
        <h2 class="mt-5 font-serif text-4xl leading-tight text-cream">The questions men actually search.</h2>
        <p class="mt-6 text-sm leading-relaxed text-cream/55">
          Anything else, in complete confidence:
          <a href="tel:+442030068459" class="text-gold">+44 (0)20 3006 8459</a>.
        </p>
      </div>
      <div class="space-y-4 lg:col-span-8" data-reveal-child>
        {
          faqs.map((faq) => (
            <details class="faq hairline bg-ink2 px-7">
              <summary class="flex items-center justify-between gap-6 py-6">
                <span class="font-serif text-xl text-cream">{faq.q}</span>
                <span class="faq-icon shrink-0 text-xl font-light text-gold" aria-hidden="true">＋</span>
              </summary>
              <p class="hairline-t pt-5 pb-7 text-sm leading-[1.85] text-cream/60">{faq.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <Journey />
  <FinalCTA heading="One call. Complete discretion." sub="Speak to our team confidentially, or begin with the two-minute confidential self-assessment." />
</Base>
