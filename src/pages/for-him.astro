---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Journey from '../components/Journey.astro';
import FinalCTA from '../components/FinalCTA.astro';

const treatments = [
  {
    name: 'P-Shot®',
    tag: 'Regenerative',
    desc: 'Autologous platelet-rich plasma to regenerate vascular and erectile tissue — introduced to the UK by Dr Wakil.',
  },
  {
    name: 'O Concept™ ESWT',
    tag: 'Energy-based',
    desc: 'Low-intensity extracorporeal shockwave therapy, stimulating new blood-vessel growth at the root cause.',
  },
  {
    name: 'Bocox™',
    tag: 'Injectable',
    desc: 'A targeted botulinum protocol improving blood flow and spontaneous function, with results lasting months.',
  },
  {
    name: 'Scrotox',
    tag: 'Refinement',
    desc: 'A discreet refinement treatment for comfort, appearance and confidence — brief, and virtually painless.',
  },
  {
    name: 'Endo Test',
    tag: 'Diagnostics',
    desc: 'Our comprehensive hormonal and metabolic panel — the evidence base on which every protocol is built.',
  },
  {
    name: 'O Concept™ Chair',
    tag: 'Non-invasive',
    desc: 'High-intensity electromagnetic pelvic-floor strengthening. Fully clothed, in a course of short sessions.',
  },
];
---

<Base
  title="The O Concept™ for Him — Male Sexual Rejuvenation | Harley Street"
  description="Regenerative treatment for the concerns men rarely discuss — P-Shot®, ESWT, Bocox™ and hormonal optimisation, delivered confidentially on Harley Street."
>
  <PageHero
    eyebrow="The O Concept™ for Him"
    title="For the concerns men <em class='text-gold'>rarely discuss.</em>"
    sub="Erectile function, performance, drive. These are medical matters with medical answers — and addressing them early is the strongest move a man can make."
  />

  <section class="bg-ink py-24 md:py-32">
    <div class="wrap">
      <div class="grid gap-12 lg:grid-cols-12" data-reveal>
        <div class="lg:col-span-5">
          <p class="eyebrow">Cause, not symptom</p>
          <h2 class="mt-5 font-serif text-4xl leading-tight text-cream">Function is physiology. Physiology can be treated.</h2>
        </div>
        <div class="space-y-6 text-[15px] leading-[1.9] text-cream/65 lg:col-span-7">
          <p>
            Most male sexual dysfunction is vascular, hormonal or neurological — measurable, and in most cases,
            treatable without surgery or a lifetime of tablets. The O Concept™ for Him begins with a full diagnostic
            picture, then rebuilds function using regenerative and energy-based medicine.
          </p>
          <p>
            Every consultation is private, unhurried and free of judgement. Many of our patients tell us the hardest
            step was the phone call; everything after it was straightforward.
          </p>
        </div>
      </div>

      <div class="mt-20 grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-reveal-child>
        {
          treatments.map((t) => (
            <div class="hairline group flex flex-col bg-ink2 p-8 transition-colors duration-500 hover:border-gold/50">
              <span class="text-[9px] font-bold tracking-[0.3em] text-gold/70 uppercase">{t.tag}</span>
              <h3 class="mt-4 font-serif text-2xl text-cream">{t.name}</h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-cream/55">{t.desc}</p>
              <a href="#" class="mt-7 inline-flex items-center gap-3 text-[10px] font-semibold tracking-[0.25em] text-gold uppercase">
                Learn more <span class="transition-transform duration-500 group-hover:translate-x-1.5">→</span>
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Journey />
  <FinalCTA heading="One call. Complete discretion." sub="Speak to our team confidentially, or begin with the two-minute AI assessment." />
</Base>
