---
/**
 * The landing page — an assembly of switchable, content-driven sections.
 *
 * There is deliberately no copy and no markup of its own on this page. Every
 * word, photograph, award, pathway card, science step and membership tier lives
 * in src/content/home/*.json, which is what the clinic owner edits; each section
 * below renders unless he has switched it off, and his writing survives being
 * switched off.
 *
 * That is the point of the structure: the order of the page is a studio
 * decision, and everything inside it is his. A change of mind about what the
 * page says — or what is on it at all — never needs a developer.
 */
import Base from '../layouts/Base.astro';
import OPortal from '../components/OPortal.astro';
import RecognitionBand from '../components/RecognitionBand.astro';
import Positioning from '../components/Positioning.astro';
import ScienceSplit from '../components/ScienceSplit.astro';
import PathwayCards from '../components/PathwayCards.astro';
import ConditionFinder from '../components/ConditionFinder.astro';
import MembershipSection from '../components/MembershipSection.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Reassurance from '../components/Reassurance.astro';
import { recognition, positioning, science, pathways, finder, membership, shown } from '../data/home';
---

<Base
  title="The O Concept™ — Sexual Rejuvenation & Longevity, Harley Street | Dr Sherif Wakil"
  description="Created by Dr Sherif Wakil: the world's most awarded sexual rejuvenation and regenerative protocol. Treatment for erectile dysfunction, low libido, vaginal laxity, incontinence, menopause and andropause — confidentially, at 77 Harley Street, London."
>
  <!-- 1 · DNA-O PORTAL — landing hero (always on: a page without it has no top) -->
  <OPortal />

  <!-- 2 · RECOGNITION — awards · testimonials · press -->
  {shown(recognition) && <RecognitionBand />}

  <!-- 3 · POSITIONING — cases, protocol, the stat row -->
  {shown(positioning) && <Positioning />}

  <!-- 4 · THE SCIENCE — split-scroll, one panel per step -->
  {shown(science) && <ScienceSplit />}

  <!-- 5 · THREE PATHWAYS -->
  {shown(pathways) && <PathwayCards />}

  <!-- 6 · FIND YOUR TREATMENT — condition finder -->
  {shown(finder) && <ConditionFinder />}

  <!-- 7 · MEMBERSHIP — tiers + packages strip -->
  {shown(membership) && <MembershipSection />}

  <!-- 8 · REASSURANCE + FINAL CTA -->
  <Reassurance variant="welcome" surface="ink2" accent="gold" />

  <FinalCTA />
</Base>
