---
import { withBase } from '../lib/url';
import Base from '../layouts/Base.astro';
import QuizUI from '../components/QuizUI.astro';
import MembershipTiers from '../components/MembershipTiers.astro';
import TreatmentPackages from '../components/TreatmentPackages.astro';
import Journey from '../components/Journey.astro';
import FinalCTA from '../components/FinalCTA.astro';
import RecognitionBand from '../components/RecognitionBand.astro';
import ScienceSplit from '../components/ScienceSplit.astro';
import ConditionFinder from '../components/ConditionFinder.astro';
import AndropauseSection from '../components/AndropauseSection.astro';
import LongevityTeaser from '../components/LongevityTeaser.astro';
import VideoTestimonials from '../components/VideoTestimonials.astro';
import ConciergeSection from '../components/ConciergeSection.astro';
import ScienceInterlude from '../components/ScienceInterlude.astro';

const authorityBar = [
  'Global Excellence Awards 2025 — The O Concept™ Protocol',
  '2024 World’s Best Sexual Rejuvenation Clinic',
  'Creator of The O Concept™',
  '25,000+ cases worldwide',
  'President & Founder, IAAGSW',
  'As seen on Channel 4',
];

/* Real multidisciplinary team — a market leader flanked by a world-class bench */
const team = [
  {
    name: 'Dr Sherif Wakil',
    role: 'Founder & Medical Director',
    img: 'https://drswclinics.com/wp-content/uploads/2023/07/DSC02197-scaled.jpg',
    bio: 'Creator of The O Concept™; the first physician to bring the O-Shot® and P-Shot® to the UK. 25,000+ cases worldwide.',
  },
  {
    name: 'Dr Davood Fallahdar',
    role: 'Plastic & Reconstructive Surgeon',
    img: withBase('images/team-fallahdar.jpg'),
    bio: 'Honours graduate in Medicine and Surgery (Milan); on the UK GMC specialist register for Plastic Surgery since 2000; former Consultant at Addenbrooke’s Hospital, Cambridge.',
  },
  {
    name: 'Dr Ralph Rogers',
    role: 'Consultant, Regenerative Orthopaedics & Sports Medicine',
    img: withBase('images/team-rogers.jpg'),
    bio: 'Internationally trained consultant treating chronic pain with innovative regenerative medicine.',
  },
  {
    name: 'Dr Fouad Ghaly',
    role: 'Regenerative Medicine Specialist',
    img: withBase('images/team-ghaly.jpg'),
    bio: 'Board Certified, American Board of Regenerative Medicine; founder of the Ghaly Center for Regenerative Medicine; expert in PRP and bio-identical hormone therapy.',
  },
  {
    name: 'Mr Myutan Kulendran',
    role: 'Upper GI & Weight Loss Surgeon',
    img: withBase('images/team-kulendran.jpg'),
    bio: 'St George’s Hospital London; PhD in weight loss; FRCS (Gen).',
  },
];

const testimonials = [
  {
    quote:
      'After two years of avoiding the conversation entirely, one consultation changed everything. The protocol was explained with such clarity and dignity that the decision made itself. Six months on, I feel like myself again.',
    who: 'Mr A., 54, London',
  },
  {
    quote:
      'What struck me was the discretion — from the first phone call to the follow-up. Nothing was rushed, nothing was assumed. The results have quietly transformed my confidence, and my marriage.',
    who: 'Mrs L., 47, Surrey',
  },
  {
    quote:
      'We came as a couple, each with our own concerns. Dr Wakil treated the cause, not the symptom, for both of us. It is the finest medical care either of us has ever received.',
    who: 'Mr & Mrs D., Kensington',
  },
];
---

<Base
  title="The O Concept™ — Sexual Rejuvenation & Longevity, Harley Street | Dr Sherif Wakil"
  description="Created by Dr Sherif Wakil: the world's most awarded sexual rejuvenation and regenerative protocol. Treatment for erectile dysfunction, low libido, vaginal laxity, incontinence, menopause and andropause — confidentially, at 77 Harley Street, London."
>
  <!-- ============ HERO — Dr Wakil-centric, instant market-leader read ============ -->
  <section class="relative -mt-20 flex min-h-screen flex-col justify-center overflow-hidden bg-ink">
    <!-- subtle gold particle drift — the helix now lives in its own showpiece section below -->
    <div class="absolute inset-0" aria-hidden="true">
      <span class="particle" style="top:24%; left:14%; animation-delay:0s"></span>
      <span class="particle" style="top:64%; left:8%; animation-delay:-4s"></span>
      <span class="particle" style="top:36%; left:74%; animation-delay:-8s"></span>
      <span class="particle" style="top:74%; left:60%; animation-delay:-2s"></span>
      <span class="particle" style="top:16%; left:48%; animation-delay:-11s"></span>
      <span class="particle" style="top:82%; left:34%; animation-delay:-6s"></span>
    </div>

    <!-- holographic blueprint grid — fades out radially -->
    <div class="grid-overlay" aria-hidden="true"></div>

    <!-- colour lift — teal science glow + gold brand glow -->
    <div
      class="pointer-events-none absolute inset-0"
      style="background:
        radial-gradient(ellipse 50% 55% at 82% 40%, rgba(45,212,191,0.08), transparent 62%),
        radial-gradient(ellipse 55% 45% at 10% 85%, rgba(201,169,110,0.09), transparent 65%),
        radial-gradient(ellipse 40% 30% at 50% 0%, rgba(14,165,233,0.05), transparent 60%);"
      aria-hidden="true"
    >
    </div>
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-ink/60 via-transparent to-ink" aria-hidden="true"></div>

    <div class="wrap relative grid grid-cols-1 items-center gap-10 pt-24 pb-14 md:pt-28 lg:grid-cols-12 lg:gap-10">
      <!-- headline block -->
      <div class="lg:col-span-7">
        <p class="eyebrow" data-reveal>The O Concept™ · 77 Harley Street, London</p>
        <h1 class="mt-5 font-serif text-[2.6rem] leading-[1.05] font-medium tracking-tight text-cream sm:text-6xl md:text-6xl xl:text-[4.7rem]">
          <span class="hw-line"><span class="hw">We don&rsquo;t follow</span></span>
          <span class="hw-line"><span class="hw">protocols.</span></span>
          <span class="hw-line"><span class="hw shimmer-label italic">We create them.</span></span>
        </h1>
        <p class="mt-6 max-w-xl text-base leading-relaxed text-cream/70 md:text-lg" data-reveal data-delay="0.7">
          Dr Sherif Wakil — creator of The&nbsp;O&nbsp;Concept<sup class="text-[0.55em] text-gold">™</sup>. The
          world&rsquo;s most awarded sexual rejuvenation and regenerative protocol. Harley Street, London.
        </p>

        <!-- authority bar -->
        <ul class="mt-6 flex max-w-2xl flex-wrap items-center gap-x-3 gap-y-1.5" data-reveal data-delay="0.85" aria-label="Credentials">
          {
            authorityBar.map((item, i) => (
              <>
                {i > 0 && <span class="h-[3px] w-[3px] shrink-0 rounded-full bg-teal/60" aria-hidden="true" />}
                <li class="text-[10px] font-semibold tracking-[0.18em] text-cream/60 uppercase">{item}</li>
              </>
            ))
          }
        </ul>

        <div class="mt-8 flex flex-col gap-4 sm:flex-row" data-reveal data-delay="1">
          <a href="#begin" class="btn btn-gold" data-magnetic>Book a Confidential Consultation</a>
          <a href="#finder" class="btn btn-teal" data-magnetic>Find Your Treatment</a>
        </div>
      </div>

      <!-- portrait block -->
      <div class="relative lg:col-span-5" data-reveal data-delay="0.4">
        <figure class="hairline relative mx-auto max-w-sm p-2 lg:max-w-none">
          <div class="overflow-hidden">
            <img
              src="https://drswclinics.com/wp-content/uploads/2023/07/DSC02197-scaled.jpg"
              alt="Dr Sherif Wakil — creator of The O Concept™, at 77 Harley Street"
              class="aspect-[4/5] w-full object-cover object-top"
              fetchpriority="high"
              data-parallax="-4"
            />
          </div>
          <figcaption class="flex items-baseline justify-between px-2 pt-3 pb-1">
            <span class="text-[9px] font-semibold tracking-[0.3em] text-cream/45 uppercase">Dr Sherif Wakil</span>
            <span class="text-[9px] font-semibold tracking-[0.3em] text-gold/80 uppercase">The Originator</span>
          </figcaption>
        </figure>
        <!-- floating flagship-award chip -->
        <div class="gold-glow absolute -bottom-5 left-1/2 flex w-max max-w-[92%] -translate-x-1/2 items-center gap-4 bg-ink px-5 py-3.5 lg:-left-10 lg:translate-x-0">
          <img
            src={withBase('images/award-2025-global-excellence.png')}
            alt="Global Excellence Awards 2025 winner's badge — The O Concept™ Protocol"
            class="h-14 w-auto shrink-0 rounded-sm bg-cream/95 p-1"
            loading="lazy"
          />
          <div class="text-left">
            <p class="font-serif text-lg leading-none text-gold">Global Excellence Awards 2025</p>
            <p class="mt-1.5 text-[8.5px] font-semibold tracking-[0.24em] text-cream/70 uppercase">The O Concept™ Protocol</p>
          </div>
        </div>
      </div>
    </div>

    <div class="absolute bottom-6 left-1/2 flex -translate-x-1/2 flex-col items-center gap-3" data-reveal data-delay="1.4" aria-hidden="true">
      <span class="text-[9px] font-semibold tracking-[0.45em] text-cream/40 uppercase">Scroll</span>
      <span class="relative block h-12 w-px overflow-hidden bg-cream/10">
        <span class="scroll-cue-dot absolute top-0 left-0 block h-2 w-px bg-gold"></span>
      </span>
    </div>
  </section>

  <!-- ============ RECOGNITION — awards · testimonials · press, plastered up top ============ -->
  <RecognitionBand />

  <!-- ============ INTRO / POSITIONING ============ -->
  <section class="relative bg-ink py-24 md:py-32">
    <div class="pointer-events-none absolute inset-0 glow-gold" aria-hidden="true"></div>
    <div class="wrap relative">
      <div class="grid grid-cols-1 gap-14 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-6" data-reveal>
          <blockquote class="font-serif text-4xl leading-[1.15] text-cream md:text-5xl">
            More than <span class="text-gold">25,000 cases worldwide.</span> The doctor who brought the O&#8209;Shot<sup class="text-[0.45em]">®</sup>
            and P&#8209;Shot<sup class="text-[0.45em]">®</sup> to the UK.
          </blockquote>
          <div class="mt-12 flex flex-wrap items-end gap-8">
            <figure class="hairline max-w-[260px] flex-1 p-2">
              <div class="overflow-hidden">
                <img
                  src="https://drswclinics.com/wp-content/uploads/2025/02/image00026-1.jpg"
                  alt="The clinic at 77 Harley Street, London"
                  class="aspect-[4/5] w-full scale-[1.08] object-cover"
                  loading="lazy"
                  data-parallax="-4"
                />
              </div>
              <figcaption class="px-2 pt-3 pb-1 text-[9px] font-semibold tracking-[0.3em] text-cream/40 uppercase">
                77 Harley Street
              </figcaption>
            </figure>
            <div class="hairline shrink-0 rounded-md bg-cream/95 p-3">
              <img
                src="https://drswclinics.com/wp-content/uploads/2023/07/E4-photo-e1688490158998.png"
                alt="Dr Sherif Wakil featured on Channel 4"
                class="h-24 w-auto object-contain"
                loading="lazy"
              />
            </div>
          </div>
        </div>
        <div class="lg:col-span-6" data-reveal data-delay="0.15">
          <p class="eyebrow mb-7">A protocol, not a procedure</p>
          <div class="space-y-6 text-[15px] leading-[1.9] text-cream/65">
            <p>
              The O Concept™ is a holistic, multi-modality programme of sexual rejuvenation and regenerative medicine —
              the culmination of two decades of clinical practice by Dr Sherif Wakil. It combines platelet-rich plasma
              therapy, low-intensity shockwave, hormonal optimisation and advanced energy-based devices into a single,
              coherent protocol.
            </p>
            <p>
              Where others treat a symptom, we diagnose a system. Every programme begins with comprehensive
              diagnostics — the Endo Test — so that treatment addresses cause, not consequence. The result is
              restoration of function, sensation and confidence that is measured, maintained and entirely private.
            </p>
          </div>
        </div>
      </div>

      <dl class="hairline-t mt-20 grid grid-cols-2 gap-x-8 gap-y-12 pt-16 lg:grid-cols-4" data-reveal-child>
        <div class="flex flex-col">
          <dt class="order-2 text-[10px] font-semibold tracking-[0.3em] text-cream/45 uppercase">Cases worldwide</dt>
          <dd class="order-1 mb-3 font-serif text-5xl text-gold md:text-6xl" data-count="25000" data-suffix="+">25,000+</dd>
        </div>
        <div class="flex flex-col">
          <dt class="order-2 text-[10px] font-semibold tracking-[0.3em] text-cream/45 uppercase">Years of clinical practice</dt>
          <dd class="order-1 mb-3 font-serif text-5xl text-gold md:text-6xl" data-count="20" data-suffix="+">20+</dd>
        </div>
        <div class="flex flex-col">
          <dt class="order-2 text-[10px] font-semibold tracking-[0.3em] text-cream/45 uppercase">To bring the O-Shot® &amp; P-Shot® to the UK</dt>
          <dd class="order-1 mb-3 font-serif text-5xl text-gold md:text-6xl"><span data-count="1" data-suffix="st">1st</span></dd>
        </div>
        <div class="flex flex-col">
          <dt class="order-2 text-[10px] font-semibold tracking-[0.3em] text-cream/45 uppercase">Global Excellence Awards — The O Concept™ Protocol</dt>
          <dd class="order-1 mb-3 font-serif text-5xl text-gold md:text-6xl" data-count="2025" data-plain>2025</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ============ SCIENCE INTERLUDE — the 3D showpiece ============ -->
  <ScienceInterlude />

  <!-- ============ THE SCIENCE — split-scroll pinned section ============ -->
  <ScienceSplit />

  <!-- ============ THREE PATHWAYS ============ -->
  <section id="pathways" class="hairline-t relative bg-ink">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">Three pathways, one philosophy</p>
        <h2 class="mt-5 font-serif text-4xl leading-tight text-cream md:text-5xl">For him. For her. For the long run.</h2>
      </div>

      <div class="mt-16 flex flex-col gap-5 md:h-[560px] md:flex-row" data-reveal>
        <!-- FOR HIM -->
        <a
          href={withBase('for-him')}
          class="pathway group hairline relative flex min-h-[380px] flex-col justify-end overflow-hidden p-9 md:p-11"
          style="background:
            radial-gradient(ellipse 90% 70% at 80% 0%, rgba(201,169,110,0.16), transparent 60%),
            linear-gradient(160deg, #16161c, #0a0a0b 70%);"
        >
          <p class="text-[10px] font-semibold tracking-[0.4em] text-gold uppercase">For Him</p>
          <h3 class="mt-4 font-serif text-3xl text-cream md:min-h-[2.3em] md:max-w-[280px] md:text-4xl">O Concept<sup class="text-[0.45em] text-gold">™</sup> for Him</h3>
          <p class="mt-4 max-w-sm text-sm leading-relaxed text-cream/60 md:min-h-[4.9em] md:max-w-[280px]">
            Function, performance and vitality — restored through regenerative medicine, not resignation.
          </p>
          <div class="pathway-more mt-6">
            <ul class="space-y-2.5 text-sm whitespace-nowrap text-cream/75">
              <li class="flex items-center gap-3"><span class="h-px w-5 bg-gold"></span>P-Shot® — platelet-rich plasma therapy</li>
              <li class="flex items-center gap-3"><span class="h-px w-5 bg-gold"></span>Bocox™ &amp; ESWT shockwave therapy</li>
              <li class="flex items-center gap-3"><span class="h-px w-5 bg-gold"></span>Endo Test hormonal diagnostics</li>
            </ul>
          </div>
          <span class="mt-7 inline-flex items-center gap-3 text-[11px] font-semibold tracking-[0.25em] text-gold uppercase">
            Explore the pathway <span class="transition-transform duration-500 group-hover:translate-x-2">→</span>
          </span>
        </a>

        <!-- FOR HER -->
        <a
          href={withBase('for-her')}
          class="pathway group relative flex min-h-[380px] flex-col justify-end overflow-hidden border border-rose/25 p-9 md:p-11"
          style="background:
            radial-gradient(ellipse 90% 70% at 20% 0%, rgba(110,30,43,0.4), transparent 62%),
            radial-gradient(ellipse 60% 45% at 85% 100%, rgba(217,164,164,0.08), transparent 65%),
            linear-gradient(200deg, #16161c, #0a0a0b 70%);"
        >
          <p class="text-[10px] font-semibold tracking-[0.4em] text-rose uppercase">For Her</p>
          <h3 class="mt-4 font-serif text-3xl text-cream md:min-h-[2.3em] md:max-w-[280px] md:text-4xl">O Concept<sup class="text-[0.45em] text-rose">™</sup> for Her</h3>
          <p class="mt-4 max-w-sm text-sm leading-relaxed text-cream/60 md:min-h-[4.9em] md:max-w-[280px]">
            Comfort, sensation and confidence — supported gently, at every stage of life.
          </p>
          <div class="pathway-more mt-6">
            <ul class="space-y-2.5 text-sm whitespace-nowrap text-cream/75">
              <li class="flex items-center gap-3"><span class="h-px w-5 bg-rose"></span>O-Shot® — platelet-rich plasma therapy</li>
              <li class="flex items-center gap-3"><span class="h-px w-5 bg-rose"></span>Ultra Femme 360 &amp; CO2RE Intima</li>
              <li class="flex items-center gap-3"><span class="h-px w-5 bg-rose"></span>O Concept™ Chair for Her</li>
            </ul>
          </div>
          <span class="mt-7 inline-flex items-center gap-3 text-[11px] font-semibold tracking-[0.25em] text-rose uppercase">
            Explore the pathway <span class="transition-transform duration-500 group-hover:translate-x-2">→</span>
          </span>
        </a>

        <!-- LONGEVITY -->
        <a
          href={withBase('longevity')}
          class="pathway hairline-teal group relative flex min-h-[380px] flex-col justify-end overflow-hidden p-9 md:p-11"
          style="background:
            radial-gradient(ellipse 90% 70% at 50% 0%, rgba(45,212,191,0.13), transparent 62%),
            radial-gradient(ellipse 60% 45% at 15% 100%, rgba(14,165,233,0.07), transparent 65%),
            linear-gradient(180deg, #16161c, #0a0a0b 70%);"
        >
          <p class="text-[10px] font-semibold tracking-[0.4em] text-teal uppercase">Longevity</p>
          <h3 class="mt-4 font-serif text-3xl text-cream md:min-h-[2.3em] md:max-w-[280px] md:text-4xl">O Concept<sup class="text-[0.45em] text-teal">™</sup> Longevity</h3>
          <p class="mt-4 max-w-sm text-sm leading-relaxed text-cream/60 md:min-h-[4.9em] md:max-w-[280px]">
            Life optimisation and regenerative medicine — energy, hormones, metabolism and healthy years.
          </p>
          <div class="pathway-more mt-6">
            <ul class="space-y-2.5 text-sm whitespace-nowrap text-cream/75">
              <li class="flex items-center gap-3"><span class="h-px w-5 bg-teal"></span>Hormone optimisation &amp; IV nutrition</li>
              <li class="flex items-center gap-3"><span class="h-px w-5 bg-teal"></span>Stem cells &amp; regenerative medicine</li>
              <li class="flex items-center gap-3"><span class="h-px w-5 bg-teal"></span>Dietician, coaching &amp; movement therapy</li>
            </ul>
          </div>
          <span class="mt-7 inline-flex items-center gap-3 text-[11px] font-semibold tracking-[0.25em] text-teal uppercase">
            Explore the pathway <span class="transition-transform duration-500 group-hover:translate-x-2">→</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ LONGEVITY TEASER — particle field ============ -->
  <LongevityTeaser />

  <!-- ============ FIND YOUR TREATMENT — condition finder ============ -->
  <ConditionFinder />

  <!-- ============ ANDROPAUSE LEADERSHIP ============ -->
  <AndropauseSection />

  <!-- ============ IN HIS WORDS — video testimonials ============ -->
  <VideoTestimonials />

  <!-- ============ CLINICIAN-LED DIGITAL CARE ============ -->
  <section class="hairline-t relative overflow-hidden bg-ink2 py-24 md:py-32">
    <div class="pointer-events-none absolute inset-0 glow-teal" aria-hidden="true"></div>
    <div class="wrap relative">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow-teal">Intelligent care</p>
        <h2 class="mt-5 font-serif text-4xl leading-tight text-cream md:text-5xl">
          Technology in service of <span class="text-gold italic">doctors.</span> Never replacing them.
        </h2>
        <p class="mt-6 text-[15px] leading-relaxed text-cream/60">
          A preview of the clinician-led digital layer we are building around The O Concept™ — discreet triage that
          routes you to humans, and a private dashboard for your protocol. Every recommendation is made by Dr
          Wakil&rsquo;s clinical team.
        </p>
      </div>

      <!-- Confidential Self-Assessment — working embedded quiz -->
      <div class="hairline mt-16 grid grid-cols-1 overflow-hidden bg-ink lg:grid-cols-2" data-reveal>
        <div class="flex flex-col justify-center p-9 md:p-14">
          <span class="mb-6 inline-block w-fit border border-gold/40 px-3 py-1 text-[9px] font-bold tracking-[0.3em] text-gold uppercase">Prototype</span>
          <h3 class="font-serif text-3xl text-cream md:text-4xl">Confidential Self-Assessment</h3>
          <p class="mt-5 text-sm leading-[1.85] text-cream/60">
            Answer a few discreet questions. Your responses are reviewed by our clinical team, and Dr Wakil&rsquo;s
            team will recommend your pathway — matched to the concerns you would rather not explain twice. Nothing is
            stored, and nothing is booked without you.
          </p>
          <p class="mt-6 text-[10px] font-semibold tracking-[0.25em] text-cream/35 uppercase">Confidential · Reviewed by clinicians · No account required</p>
        </div>
        <div class="hairline-t border-gold/15 bg-white/[0.015] p-9 md:border-t-0 md:border-l md:p-14">
          <QuizUI />
        </div>
      </div>

      <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2" data-reveal-child>
        <!-- Discreet triage that routes to humans -->
        <div class="hairline flex flex-col bg-ink p-9 md:p-12" data-tilt>
          <span class="mb-6 inline-block w-fit border border-teal/40 px-3 py-1 text-[9px] font-bold tracking-[0.3em] text-teal uppercase">Coming 2026</span>
          <h3 class="font-serif text-3xl text-cream">Discreet Patient Concierge</h3>
          <p class="mt-5 text-sm leading-[1.85] text-cream/60">
            A private first conversation, any hour of the day. Smart triage takes your question and routes it to the
            right human — a nurse, a coordinator, or Dr Wakil&rsquo;s team — never pushy, always confidential. Try the
            scripted demonstration via the icon at the bottom right of your screen.
          </p>
          <div class="hairline mt-8 space-y-3 bg-white/[0.015] p-5">
            <div class="chat-msg from-user">Is my enquiry confidential?</div>
            <div class="chat-msg from-ai">Completely. Discreet communication, unmarked correspondence, private appointment times on request.</div>
          </div>
        </div>

        <!-- Personalised Protocol Dashboard -->
        <div class="hairline flex flex-col bg-ink p-9 md:p-12" data-tilt>
          <span class="mb-6 inline-block w-fit border border-teal/40 px-3 py-1 text-[9px] font-bold tracking-[0.3em] text-teal uppercase">Coming 2026</span>
          <h3 class="font-serif text-3xl text-cream">Personalised Protocol Dashboard</h3>
          <p class="mt-5 text-sm leading-[1.85] text-cream/60">
            Members will follow their protocol, biomarkers and upcoming sessions in one private view — reviewed at
            every step by the clinical team, so progress you see is progress a doctor has verified.
          </p>
          <!-- static dashboard mock -->
          <div class="hairline mt-8 bg-white/[0.015] p-6">
            <div class="flex items-center gap-6">
              <svg viewBox="0 0 96 96" class="h-24 w-24 shrink-0" role="img" aria-label="Protocol progress: 68 percent">
                <circle cx="48" cy="48" r="40" fill="none" stroke="rgba(244,241,236,0.08)" stroke-width="5" />
                <circle cx="48" cy="48" r="40" fill="none" stroke="#2DD4BF" stroke-width="5" stroke-linecap="round" stroke-dasharray="251.3" stroke-dashoffset="80.4" transform="rotate(-90 48 48)" />
