---
import Base from '../layouts/Base.astro';
import QuizUI from '../components/QuizUI.astro';
import MembershipTiers from '../components/MembershipTiers.astro';
import Journey from '../components/Journey.astro';
import FinalCTA from '../components/FinalCTA.astro';

const press = ['Channel 4', 'The Times', 'Daily Mail', 'Tatler', 'Harper’s Bazaar', 'GQ', 'Sky News'];

const team = [
  {
    name: 'Dr Sherif Wakil',
    role: 'Founder & Medical Director',
    img: 'https://drswclinics.com/wp-content/uploads/2023/07/DSC02197-scaled.jpg',
  },
  {
    name: 'Dr Amira Hassan',
    role: 'Intimate Health Physician',
    img: 'https://placehold.co/640x800/101014/C9A96E?text=Clinician+Portrait&font=playfair-display',
  },
  {
    name: 'Rachel Whitmore',
    role: 'Lead Clinical Nurse',
    img: 'https://placehold.co/640x800/101014/C9A96E?text=Clinician+Portrait&font=playfair-display',
  },
  {
    name: 'James Carter',
    role: 'Patient Care Director',
    img: 'https://placehold.co/640x800/101014/C9A96E?text=Team+Portrait&font=playfair-display',
  },
];

const testimonials = [
  {
    quote:
      'After two years of avoiding the conversation entirely, one consultation changed everything. The protocol was explained with such clarity and dignity that the decision made itself. Six months on, I feel like myself again.',
    who: 'Mr A., 54, London',
  },
  {
    quote:
      'What struck me was the discretion — from the first phone call to the follow-up. Nothing was rushed, nothing was assumed. The results have quietly transformed my confidence, and my marriage.',
    who: 'Mrs L., 47, Surrey',
  },
  {
    quote:
      'We came as a couple, each with our own concerns. Dr Wakil treated the cause, not the symptom, for both of us. It is the finest medical care either of us has ever received.',
    who: 'Mr & Mrs D., Kensington',
  },
];
---

<Base
  title="The O Concept™ — Sexual Rejuvenation, Harley Street | Dr SW Clinics"
  description="The world's most awarded sexual rejuvenation protocol. Pioneered on Harley Street by Dr Sherif Wakil — regenerative, evidence-led, entirely confidential."
>
  <!-- ============ HERO ============ -->
  <section class="relative -mt-20 flex min-h-screen flex-col justify-center overflow-hidden bg-ink">
    <!-- rotating clinic photography, slow-panning, under a dark editorial overlay -->
    <div class="absolute inset-0" aria-hidden="true">
      <div class="hero-pan absolute -inset-[6%]">
        <img
          src="https://drswclinics.com/wp-content/uploads/2025/02/image00026-1.jpg"
          alt="Dr SW Clinics — the clinic at 77 Harley Street, London"
          class="hero-slide active"
          fetchpriority="high"
        />
        <img
          src="https://drswclinics.com/wp-content/uploads/2024/12/Homepage-10.jpg"
          alt="Treatment suite at Dr SW Clinics"
          class="hero-slide"
          loading="lazy"
        />
        <img
          src="https://drswclinics.com/wp-content/uploads/2024/12/Homepage-5.jpg"
          alt="Consultation room at Dr SW Clinics"
          class="hero-slide"
          loading="lazy"
        />
        <img
          src="https://drswclinics.com/wp-content/uploads/2024/12/Homepage-8.jpg"
          alt="Clinic interior at Dr SW Clinics, Harley Street"
          class="hero-slide"
          loading="lazy"
        />
        <img
          src="https://drswclinics.com/wp-content/uploads/2024/12/Homepage-9-e1733484520778.jpg"
          alt="Clinical technology at Dr SW Clinics"
          class="hero-slide"
          loading="lazy"
        />
        <img
          src="https://drswclinics.com/wp-content/uploads/2022/09/Homepage-2.jpg"
          alt="Dr SW Clinics reception, Harley Street"
          class="hero-slide"
          loading="lazy"
        />
      </div>
      <div class="absolute inset-0" style="background: linear-gradient(rgba(10,10,11,0.4), rgba(10,10,11,0.85));"></div>
      <!-- faint rotating gold line-work -->
      <svg class="hero-ring absolute top-1/2 left-1/2 h-[130vmin] w-[130vmin] -translate-x-1/2 -translate-y-1/2 opacity-[0.1]" viewBox="0 0 800 800" fill="none">
        <circle cx="400" cy="400" r="330" stroke="#C9A96E" stroke-width="0.6" stroke-dasharray="2 14" />
        <circle cx="400" cy="400" r="255" stroke="#C9A96E" stroke-width="0.5" opacity="0.6" />
        <circle cx="400" cy="400" r="180" stroke="#C9A96E" stroke-width="0.4" stroke-dasharray="1 10" opacity="0.5" />
        <path d="M70 400 H730" stroke="#C9A96E" stroke-width="0.3" opacity="0.35" />
        <path d="M400 70 V730" stroke="#C9A96E" stroke-width="0.3" opacity="0.35" />
      </svg>
      <!-- drifting gold particles -->
      <span class="particle" style="top:28%; left:18%; animation-delay:0s"></span>
      <span class="particle" style="top:62%; left:12%; animation-delay:-4s"></span>
      <span class="particle" style="top:38%; left:78%; animation-delay:-8s"></span>
      <span class="particle" style="top:70%; left:64%; animation-delay:-2s"></span>
      <span class="particle" style="top:18%; left:52%; animation-delay:-11s"></span>
      <span class="particle" style="top:82%; left:38%; animation-delay:-6s"></span>
      <div class="absolute inset-0 bg-gradient-to-b from-ink/40 via-transparent to-ink"></div>
    </div>

    <div class="wrap relative pt-36 pb-28 text-center">
      <p class="eyebrow" data-reveal>The O Concept™ — Harley Street</p>
      <h1 class="mx-auto mt-8 max-w-5xl font-serif text-[3.4rem] leading-[1.02] font-medium tracking-tight text-cream sm:text-7xl md:text-8xl lg:text-[7.5rem]">
        <span class="hw-line"><span class="hw">Rejuvenation</span></span>
        <span class="hw-line"><span class="hw">Starts&nbsp;</span><span class="hw text-gold italic">Within.</span></span>
      </h1>
      <p class="mx-auto mt-9 max-w-xl text-base leading-relaxed text-cream/65 md:text-lg" data-reveal data-delay="0.7">
        The world&rsquo;s most awarded sexual rejuvenation protocol. Pioneered on Harley Street by Dr&nbsp;Sherif&nbsp;Wakil.
      </p>
      <div class="mt-12 flex flex-col items-center justify-center gap-5 sm:flex-row" data-reveal data-delay="0.9">
        <button data-open-quiz class="btn btn-gold">Take the AI Assessment</button>
        <a href="#pathways" class="btn btn-ghost">Explore the Protocol</a>
      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 flex -translate-x-1/2 flex-col items-center gap-3" data-reveal data-delay="1.4" aria-hidden="true">
      <span class="text-[9px] font-semibold tracking-[0.45em] text-cream/40 uppercase">Scroll</span>
      <span class="relative block h-12 w-px overflow-hidden bg-cream/10">
        <span class="scroll-cue-dot absolute top-0 left-0 block h-2 w-px bg-gold"></span>
      </span>
    </div>
  </section>

  <!-- ============ MEDIA TICKER ============ -->
  <section class="hairline-t hairline-b bg-[#070708] py-10">
    <p class="mb-7 text-center text-[10px] font-semibold tracking-[0.45em] text-cream/40 uppercase">As featured in</p>
    <div class="marquee" aria-label="Press features">
      <div class="marquee-track">
        {[0, 1].map((copy) => (
          <ul class="flex" aria-hidden={copy === 1 ? 'true' : undefined}>
            {press.map((name) => (
              <li class="marquee-item">{name}</li>
            ))}
          </ul>
        ))}
      </div>
    </div>

    <!-- press proof point -->
    <div class="wrap mt-12 flex flex-col items-center justify-center gap-6 md:flex-row md:gap-10" data-reveal>
      <div class="hairline shrink-0 rounded-md bg-cream/95 p-3">
        <img
          src="https://drswclinics.com/wp-content/uploads/2023/07/E4-photo-e1688490158998.png"
          alt="Dr Sherif Wakil featured on Channel 4"
          class="h-24 w-auto object-contain md:h-28"
          loading="lazy"
        />
      </div>
      <p class="max-w-xs text-center text-xs leading-relaxed text-cream/50 md:text-left">
        Dr Wakil&rsquo;s pioneering work is regularly featured on <span class="text-gold">Channel 4</span> and across
        the national press.
      </p>
    </div>
  </section>

  <!-- ============ INTRO / POSITIONING ============ -->
  <section id="science" class="bg-ink py-24 md:py-32">
    <div class="wrap">
      <div class="grid gap-14 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-6" data-reveal>
          <blockquote class="font-serif text-4xl leading-[1.15] text-cream md:text-5xl">
            More than <span class="text-gold">19,000 procedures.</span> The doctor who brought the O&#8209;Shot<sup class="text-[0.45em]">®</sup>
            and P&#8209;Shot<sup class="text-[0.45em]">®</sup> to the UK.
          </blockquote>
          <figure class="hairline mt-12 max-w-sm p-2">
            <div class="overflow-hidden">
              <img
                src="https://drswclinics.com/wp-content/uploads/2024/09/AK-MIN.jpg"
                alt="Dr Sherif Wakil at Dr SW Clinics, Harley Street"
                class="aspect-[4/5] w-full scale-[1.08] object-cover"
                loading="lazy"
                data-parallax="-4"
              />
            </div>
            <figcaption class="px-2 pt-3 pb-1 text-[9px] font-semibold tracking-[0.3em] text-cream/40 uppercase">
              Dr Sherif Wakil · Founder &amp; Medical Director
            </figcaption>
          </figure>
        </div>
        <div class="lg:col-span-6" data-reveal data-delay="0.15">
          <p class="eyebrow mb-7">A protocol, not a procedure</p>
          <div class="space-y-6 text-[15px] leading-[1.9] text-cream/65">
            <p>
              The O Concept™ is a holistic, multi-modality programme of sexual rejuvenation — the culmination of two
              decades of clinical practice by Dr Sherif Wakil. It combines platelet-rich plasma therapy, low-intensity
              shockwave, hormonal optimisation and advanced energy-based devices into a single, coherent protocol.
            </p>
            <p>
              Where others treat a symptom, we diagnose a system. Every programme begins with comprehensive
              diagnostics — the Endo Test — so that treatment addresses cause, not consequence. The result is
              restoration of function, sensation and confidence that is measured, maintained and entirely private.
            </p>
          </div>
        </div>
      </div>

      <dl class="hairline-t mt-20 grid grid-cols-2 gap-x-8 gap-y-12 pt-16 lg:grid-cols-4" data-reveal-child>
        <div class="flex flex-col">
          <dt class="order-2 text-[10px] font-semibold tracking-[0.3em] text-cream/45 uppercase">Procedures performed</dt>
          <dd class="order-1 mb-3 font-serif text-5xl text-gold md:text-6xl" data-count="19000" data-suffix="+">19,000+</dd>
        </div>
        <div class="flex flex-col">
          <dt class="order-2 text-[10px] font-semibold tracking-[0.3em] text-cream/45 uppercase">Years of clinical practice</dt>
          <dd class="order-1 mb-3 font-serif text-5xl text-gold md:text-6xl" data-count="20" data-suffix="+">20+</dd>
        </div>
        <div class="flex flex-col">
          <dt class="order-2 text-[10px] font-semibold tracking-[0.3em] text-cream/45 uppercase">To bring the O-Shot® &amp; P-Shot® to the UK</dt>
          <dd class="order-1 mb-3 font-serif text-5xl text-gold md:text-6xl"><span data-count="1" data-suffix="st">1st</span></dd>
        </div>
        <div class="flex flex-col">
          <dt class="order-2 text-[10px] font-semibold tracking-[0.3em] text-cream/45 uppercase">World’s Best Sexual Rejuvenation Clinic</dt>
          <dd class="order-1 mb-3 font-serif text-5xl text-gold md:text-6xl" data-count="2024" data-plain>2024</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ============ THE TWO PATHWAYS ============ -->
  <section id="pathways" class="hairline-t bg-ink">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">Two pathways, one philosophy</p>
        <h2 class="mt-5 font-serif text-4xl leading-tight text-cream md:text-5xl">Designed for him. Designed for her.</h2>
      </div>

      <div class="mt-16 flex flex-col gap-5 md:h-[560px] md:flex-row" data-reveal>
        <!-- FOR HIM -->
        <a
          href="/for-him"
          class="pathway group hairline relative flex min-h-[380px] flex-col justify-end overflow-hidden p-9 md:p-12"
          style="background:
            radial-gradient(ellipse 90% 70% at 80% 0%, rgba(201,169,110,0.16), transparent 60%),
            linear-gradient(160deg, #16161c, #0a0a0b 70%);"
        >
          <p class="text-[10px] font-semibold tracking-[0.4em] text-gold uppercase">For Him</p>
          <h3 class="mt-4 font-serif text-4xl text-cream md:text-5xl">O Concept<sup class="text-[0.45em] text-gold">™</sup> for Him</h3>
          <p class="mt-4 max-w-sm text-sm leading-relaxed text-cream/60">
            Function, performance and vitality — restored through regenerative medicine, not resignation.
          </p>
          <div class="pathway-more mt-7">
            <ul class="space-y-2.5 text-sm text-cream/75">
              <li class="flex items-center gap-3"><span class="h-px w-5 bg-gold"></span>P-Shot® — platelet-rich plasma therapy</li>
              <li class="flex items-center gap-3"><span class="h-px w-5 bg-gold"></span>Bocox™ &amp; ESWT shockwave therapy</li>
              <li class="flex items-center gap-3"><span class="h-px w-5 bg-gold"></span>Endo Test hormonal diagnostics</li>
            </ul>
          </div>
          <span class="mt-8 inline-flex items-center gap-3 text-[11px] font-semibold tracking-[0.25em] text-gold uppercase">
            Explore the pathway <span class="transition-transform duration-500 group-hover:translate-x-2">→</span>
          </span>
        </a>

        <!-- FOR HER -->
        <a
          href="/for-her"
          class="pathway group relative flex min-h-[380px] flex-col justify-end overflow-hidden border border-rose/25 p-9 md:p-12"
          style="background:
            radial-gradient(ellipse 90% 70% at 20% 0%, rgba(110,30,43,0.4), transparent 62%),
            radial-gradient(ellipse 60% 45% at 85% 100%, rgba(217,164,164,0.08), transparent 65%),
            linear-gradient(200deg, #16161c, #0a0a0b 70%);"
        >
          <p class="text-[10px] font-semibold tracking-[0.4em] text-rose uppercase">For Her</p>
          <h3 class="mt-4 font-serif text-4xl text-cream md:text-5xl">O Concept<sup class="text-[0.45em] text-rose">™</sup> for Her</h3>
          <p class="mt-4 max-w-sm text-sm leading-relaxed text-cream/60">
            Comfort, sensation and confidence — supported gently, at every stage of life.
          </p>
          <div class="pathway-more mt-7">
            <ul class="space-y-2.5 text-sm text-cream/75">
              <li class="flex items-center gap-3"><span class="h-px w-5 bg-rose"></span>O-Shot® — platelet-rich plasma therapy</li>
              <li class="flex items-center gap-3"><span class="h-px w-5 bg-rose"></span>Ultra Femme 360 &amp; CO2RE Intima</li>
              <li class="flex items-center gap-3"><span class="h-px w-5 bg-rose"></span>O Concept™ Chair for Her</li>
            </ul>
          </div>
          <span class="mt-8 inline-flex items-center gap-3 text-[11px] font-semibold tracking-[0.25em] text-rose uppercase">
            Explore the pathway <span class="transition-transform duration-500 group-hover:translate-x-2">→</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ INTELLIGENT CARE — AI FEATURES ============ -->
  <section class="hairline-t relative overflow-hidden bg-ink2 py-24 md:py-32">
    <div
      class="pointer-events-none absolute inset-0"
      style="background: radial-gradient(ellipse 60% 45% at 50% 0%, rgba(201,169,110,0.07), transparent 65%);"
      aria-hidden="true"
    >
    </div>
    <div class="wrap relative">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">Intelligent care</p>
        <h2 class="mt-5 font-serif text-4xl leading-tight text-cream md:text-5xl">
          Precision medicine, <span class="text-gold italic">quietly assisted</span> by AI.
        </h2>
        <p class="mt-6 text-[15px] leading-relaxed text-cream/60">
          A preview of the intelligent layer we are building around The O Concept™ — triage, matching and monitoring,
          always under clinical supervision and always confidential.
        </p>
      </div>

      <!-- AI Treatment Match — working embedded quiz -->
      <div class="hairline mt-16 grid overflow-hidden bg-ink lg:grid-cols-2" data-reveal>
        <div class="flex flex-col justify-center p-9 md:p-14">
          <span class="mb-6 inline-block w-fit border border-gold/40 px-3 py-1 text-[9px] font-bold tracking-[0.3em] text-gold uppercase">Prototype</span>
          <h3 class="font-serif text-3xl text-cream md:text-4xl">AI Treatment Match</h3>
          <p class="mt-5 text-sm leading-[1.85] text-cream/60">
            Four questions. Two minutes. A clinically framed starting point — matched to the concerns you would
            rather not explain twice. Your answers are never stored, and every recommendation is reviewed by our
            medical team before anything is booked.
          </p>
          <p class="mt-6 text-[10px] font-semibold tracking-[0.25em] text-cream/35 uppercase">Confidential · No account required</p>
        </div>
        <div class="hairline-t border-gold/15 bg-white/[0.015] p-9 md:border-t-0 md:border-l md:p-14">
          <QuizUI />
        </div>
      </div>

      <div class="mt-6 grid gap-6 lg:grid-cols-2" data-reveal-child>
        <!-- Discreet AI Concierge -->
        <div class="hairline flex flex-col bg-ink p-9 md:p-12">
          <span class="mb-6 inline-block w-fit border border-gold/40 px-3 py-1 text-[9px] font-bold tracking-[0.3em] text-gold uppercase">Coming 2026</span>
          <h3 class="font-serif text-3xl text-cream">Discreet AI Concierge</h3>
          <p class="mt-5 text-sm leading-[1.85] text-cream/60">
            A private first conversation, any hour of the day. The concierge answers questions, triages concerns and
            offers appointment times — fully confidential, clinically supervised, and never pushy. Try the scripted
            demonstration now via the icon at the bottom right of your screen.
          </p>
          <div class="hairline mt-8 space-y-3 bg-white/[0.015] p-5">
            <div class="chat-msg from-user">Is my enquiry confidential?</div>
            <div class="chat-msg from-ai">Completely. Discreet communication, unmarked correspondence, private appointment times on request.</div>
          </div>
        </div>

        <!-- Personalised Protocol Dashboard -->
        <div class="hairline flex flex-col bg-ink p-9 md:p-12">
          <span class="mb-6 inline-block w-fit border border-gold/40 px-3 py-1 text-[9px] font-bold tracking-[0.3em] text-gold uppercase">Coming 2026</span>
          <h3 class="font-serif text-3xl text-cream">Personalised Protocol Dashboard</h3>
          <p class="mt-5 text-sm leading-[1.85] text-cream/60">
            Members will follow their protocol, biomarkers and upcoming sessions in one private view — progress you
            can see, between visits you barely need to plan.
          </p>
          <!-- static dashboard mock -->
          <div class="hairline mt-8 bg-white/[0.015] p-6">
            <div class="flex items-center gap-6">
              <svg viewBox="0 0 96 96" class="h-24 w-24 shrink-0" role="img" aria-label="Protocol progress: 68 percent">
                <circle cx="48" cy="48" r="40" fill="none" stroke="rgba(244,241,236,0.08)" stroke-width="5" />
                <circle cx="48" cy="48" r="40" fill="none" stroke="#C9A96E" stroke-width="5" stroke-linecap="round" stroke-dasharray="251.3" stroke-dashoffset="80.4" transform="rotate(-90 48 48)" />
                <text x="48" y="46" text-anchor="middle" fill="#F4F1EC" font-size="19" font-family="Cormorant Garamond, serif">68%</text>
                <text x="48" y="61" text-anchor="middle" fill="rgba(244,241,236,0.4)" font-size="7.5" letter-spacing="1">PROTOCOL</text>
              </svg>
              <div class="min-w-0 flex-1">
                <p class="text-[9px] font-semibold tracking-[0.25em] text-cream/40 uppercase">Upcoming sessions</p>
                <ul class="mt-3 space-y-2.5 text-xs text-cream/75">
                  <li class="flex justify-between gap-4"><span>ESWT — Session 4 of 6</span><span class="shrink-0 text-gold">Tue 14 · 09:40</span></li>
                  <li class="flex justify-between gap-4"><span>Review with Dr Wakil</span><span class="shrink-0 text-gold">Fri 31 · 16:15</span></li>
                </ul>
              </div>
            </div>
            <div class="hairline-t mt-6 pt-5">
              <div class="flex items-baseline justify-between">
                <p class="text-[9px] font-semibold tracking-[0.25em] text-cream/40 uppercase">Free testosterone · 6-month trend</p>
                <p class="text-xs text-gold">▲ 31%</p>
              </div>
              <svg viewBox="0 0 260 48" class="mt-3 h-12 w-full" preserveAspectRatio="none" role="img" aria-label="Biomarker trend, rising over six months">
                <polyline points="0,40 40,37 80,38 120,30 160,24 200,18 260,10" fill="none" stroke="#C9A96E" stroke-width="1.5" />
                <circle cx="260" cy="10" r="3" fill="#C9A96E" />
              </svg>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ MEMBERSHIP ============ -->
  <section class="hairline-t bg-ink py-24 md:py-36">
    <div class="wrap">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <p class="eyebrow">Membership</p>
        <h2 class="mt-5 font-serif text-4xl leading-tight text-cream md:text-5xl">Continuity of care. Priority access.<br />One number to call.</h2>
        <p class="mt-6 text-[15px] leading-relaxed text-cream/60">
          Rejuvenation is not an event; it is a discipline. Our memberships keep your results — and your diagnostics —
          quietly maintained all year.
        </p>
      </div>
      <div class="mt-20 lg:mt-24">
        <MembershipTiers />
      </div>
      <p class="mt-14 text-center text-[10px] tracking-[0.25em] text-cream/35 uppercase" data-reveal>
        Illustrative pricing for prototype purposes · 0% finance available
      </p>
    </div>
  </section>

  <!-- ============ TEAM ============ -->
  <section class="hairline-t bg-ink2 py-24 md:py-32">
    <div class="wrap">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">The clinical team</p>
        <h2 class="mt-5 font-serif text-4xl leading-tight text-cream md:text-5xl">The people behind the protocol.</h2>
      </div>

      <figure class="relative mt-14 overflow-hidden" data-reveal>
        <img
          src="https://placehold.co/1600x760/101014/C9A96E?text=The+Dr+SW+Clinics+Team+—+77+Harley+Street&font=playfair-display"
          alt="The Dr SW Clinics clinical team at 77 Harley Street"
          class="h-[420px] w-full object-cover md:h-[520px]"
          width="1600"
          height="760"
          loading="lazy"
          data-parallax="-6"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-ink via-transparent to-transparent" aria-hidden="true"></div>
        <figcaption class="absolute bottom-8 left-8 max-w-md md:bottom-12 md:left-12">
          <p class="eyebrow !text-[9px]">77 Harley Street, London</p>
          <p class="mt-3 font-serif text-2xl leading-snug text-cream md:text-3xl">
            Specialists in a field most clinics won&rsquo;t even name.
          </p>
        </figcaption>
      </figure>

      <div class="mt-6 grid grid-cols-2 gap-6 lg:grid-cols-4" data-reveal-child>
        {
          team.map((member) => (
            <div class="group">
              <div class="overflow-hidden">
                <img
                  src={member.img}
                  alt={`Portrait of ${member.name}, ${member.role}`}
                  class="aspect-[4/5] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
                  width="640"
                  height="800"
                  loading="lazy"
                />
              </div>
              <h3 class="mt-5 font-serif text-xl text-cream">{member.name}</h3>
              <p class="mt-1 text-[10px] font-semibold tracking-[0.25em] text-gold/80 uppercase">{member.role}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ TESTIMONIALS ============ -->
  <section id="testimonials" class="hairline-t bg-ink py-24 md:py-32">
    <div class="wrap">
      <div class="mx-auto max-w-3xl text-center" data-reveal>
        <p class="eyebrow">In their words</p>
        <div class="mt-12 grid" aria-live="polite">
          {
            testimonials.map((t, i) => (
              <blockquote class:list={['t-slide px-2', i === 0 && 'active']}>
                <span class="font-serif text-7xl leading-none text-gold" aria-hidden="true">“</span>
                <p class="mt-2 font-serif text-2xl leading-[1.5] text-cream/90 italic md:text-[1.75rem]">{t.quote}</p>
                <footer class="mt-8 text-[11px] font-semibold tracking-[0.3em] text-gold uppercase">{t.who}</footer>
              </blockquote>
            ))
          }
        </div>

        <div class="mt-12 flex items-center justify-center gap-6">
          <button class="t-prev cursor-pointer p-2 text-lg text-cream/50 transition-colors duration-300 hover:text-gold" aria-label="Previous testimonial">←</button>
          <div class="flex gap-2">
            {testimonials.map((_, i) => (
              <button class:list={['t-dot', i === 0 && 'active']} aria-label={`Go to testimonial ${i + 1}`} />
            ))}
          </div>
          <button class="t-next cursor-pointer p-2 text-lg text-cream/50 transition-colors duration-300 hover:text-gold" aria-label="Next testimonial">→</button>
        </div>
        <p class="mt-10 text-[10px] tracking-[0.25em] text-cream/35 uppercase">Patient identities protected</p>
      </div>
    </div>
  </section>

  <!-- ============ PATIENT JOURNEY ============ -->
  <Journey />

  <!-- ============ FINAL CTA ============ -->
  <FinalCTA />
</Base>
