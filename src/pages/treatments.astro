---
import { site } from '../data/site';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FinalCTA from '../components/FinalCTA.astro';
import FeaturedSpotlight from '../components/FeaturedSpotlight.astro';
import TreatmentGrid from '../components/TreatmentGrid.astro';
import { treatments } from '../data/treatments';
import Reassurance from '../components/Reassurance.astro';

const procedureSchema = treatments.map((t) => ({
  '@context': 'https://schema.org',
  '@type': 'MedicalProcedure',
  name: t.name,
  description: t.desc,
  procedureType: 'https://schema.org/NoninvasiveProcedure',
  bodyLocation: t.pathway === 'her' ? 'Female intimate health' : t.pathway === 'him' ? 'Male sexual health' : 'Whole body',
}));

const faqs = [
  {
    q: 'How do I know which treatment I need?',
    a: 'You don’t need to — that is our job. Start from your concern using the condition finder, take the confidential self-assessment, or simply book a consultation. Every protocol begins with the Endo Test diagnostic panel, so the treatment plan is chosen from evidence, not guesswork.',
  },
  {
    q: 'Are these treatments surgical? Is there downtime?',
    a: 'The O Concept™ is built on non-surgical, minimally invasive medicine — injectables using your own blood products, energy-based devices, and electromagnetic therapies. Most treatments involve little or no downtime; many patients return to their day immediately.',
  },
  {
    q: 'Can I combine treatments, or pay for a package?',
    a: 'Yes — in fact, the protocol is designed to combine modalities, because causes are rarely singular. Single treatments and bundled packages are both available, with 0% finance, and no membership is required.',
  },
  {
    q: 'Who performs the treatments?',
    a: 'Dr Sherif Wakil and his world-class clinical team, headquartered at 77 Harley Street with clinics in London, Dubai and Egypt. Dr Wakil created The O Concept™, brought the O-Shot® and P-Shot® to the UK, and has more than 25,000 cases worldwide — doctors from around the world train with him in these exact techniques.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="Treatments A–Z — P-Shot®, O-Shot®, ESWT, Longevity | The O Concept™, Harley Street"
  description="Every treatment in The O Concept™ and the conditions each one addresses — erectile dysfunction, vaginal laxity, incontinence, low libido, menopause and andropause symptoms. Non-surgical, evidence-led, confidential. 77 Harley Street, London."
  schema={[faqSchema, ...procedureSchema]}
>
  <PageHero
    eyebrow="Treatments"
    title="Every treatment. <em class='text-teal'>Every condition it answers.</em>"
    sub="The complete O Concept™ toolkit — regenerative, energy-based, hormonal and longevity medicine. Start from the treatment, or start from what you feel; both roads lead to the same door."
  />

  <FeaturedSpotlight pageKey="treatments" />

  <section class="relative bg-ink py-20 md:py-28">
    <div class="pointer-events-none absolute inset-0 glow-teal" aria-hidden="true"></div>
    <div class="wrap relative">
      <div class="mb-12 max-w-2xl" data-reveal>
        <p class="eyebrow">The catalogue</p>
        <h2 class="mt-5 font-serif text-4xl leading-tight text-cream">
          Sixteen protocols, grouped by who they serve.
        </h2>
        <p class="mt-6 text-sm leading-relaxed text-cream/75">
          Open any treatment to see the concerns it answers — described the way patients describe them,
          not the way textbooks do.
        </p>
      </div>

      <TreatmentGrid filters grouped />
    </div>
  </section>

  <!-- FAQ -->
  <section class="hairline-t bg-ink2 py-24 md:py-32">
    <div class="wrap grid grid-cols-1 gap-14 lg:grid-cols-12">
      <div class="lg:col-span-4" data-reveal>
        <p class="eyebrow">Before you ask</p>
        <h2 class="mt-5 font-serif text-4xl leading-tight text-cream">The questions everyone has.</h2>
        <p class="mt-6 text-sm leading-relaxed text-cream/75">
          Anything else, in complete confidence:
          <a href={site.phone.href} class="text-gold">{site.phone.display}</a>.
        </p>
      </div>
      <div class="space-y-4 lg:col-span-8" data-reveal-child>
        {
          faqs.map((faq) => (
            <details class="faq hairline bg-ink px-7">
              <summary class="flex items-center justify-between gap-6 py-6">
                <span class="font-serif text-xl text-cream">{faq.q}</span>
                <span class="faq-icon shrink-0 text-xl font-light text-gold" aria-hidden="true">＋</span>
              </summary>
              <p class="hairline-t pt-5 pb-7 text-sm leading-[1.85] text-cream/75">{faq.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <Reassurance variant="guidance" surface="ink2" accent="teal" />

  <FinalCTA
    heading="Not sure where to start?"
    sub="Start with the condition, not the brochure. The self-assessment takes two minutes — and a consultation answers everything else."
  />
</Base>
