---
/**
 * /membership — every word on it editable.
 *
 * Copy: src/content/pages/membership.json. Tiers and the packages panel come
 * from the membership section content, shared with the home page, so a price
 * changed once is changed in both places.
 *
 * The comparison table's columns are the tiers themselves: their names and
 * prices are read, never retyped, and each row's values line up with them in
 * order. Add a tier and the table grows a column of honest dashes until it is
 * filled in — it cannot end up describing tiers that no longer exist.
 */
import Base from '../layouts/Base.astro';
import MembershipTiers from '../components/MembershipTiers.astro';
import TreatmentPackages from '../components/TreatmentPackages.astro';
import ConciergeSection from '../components/ConciergeSection.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Copy from '../components/Copy.astro';
import { membership, shown } from '../data/home';
import { membershipPage as m } from '../data/pages';

const tiers = membership.tiers;
const rows = m.comparison.rows.map((row) => ({
  feature: row.feature,
  /* pad or trim each row to the number of tiers actually on offer */
  cells: tiers.map((_, i) => row.values?.[i] ?? '—'),
}));

const faqSchema = m.faqs.items.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: m.faqs.items.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
---

<Base
  title="Membership — Silver, Gold & Platinum | The O Concept™, Harley Street"
  description="Silver, Gold and Platinum: head-to-toe health memberships with comprehensive diagnostics, priority access and ongoing optimisation — plus open-to-everyone treatment packages with 0% finance. Dr SW Clinics, 77 Harley Street."
  schema={faqSchema ? [faqSchema] : []}
>
  <!-- ============ HERO + TIERS — one opening section, the hook ============ -->
  <section class="relative -mt-20 overflow-hidden bg-ink2 pt-28 pb-20 md:pt-32 md:pb-24">
    <div
      class="pointer-events-none absolute inset-0"
      style="background:
        radial-gradient(ellipse 75% 65% at 70% 0%, rgba(201,169,110,0.14), transparent 65%),
        radial-gradient(ellipse 55% 50% at 15% 100%, rgba(201,169,110,0.07), transparent 70%);"
      aria-hidden="true"
    >
    </div>

    <div class="wrap relative">
      <p class="eyebrow" data-reveal>{m.hero.eyebrow}</p>
      <h1 class="mt-5 max-w-4xl font-serif text-5xl leading-[1.04] text-cream md:text-6xl" data-reveal data-delay="0.1">
        <Copy text={m.hero.heading} em="text-gold" italic sup="text-[0.4em] text-gold" />
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-cream/75 md:text-lg" data-reveal data-delay="0.2">
        {m.hero.sub}
      </p>

      <!-- the tiers share the opening screen with the title -->
      {
        tiers.length > 0 && (
          <div class="mt-12 lg:mt-14">
            <MembershipTiers />
          </div>
        )
      }
      {
        m.hero.note && (
          <p class="mt-12 text-center text-[11px] tracking-[0.16em] text-cream/62 uppercase" data-reveal>
            {m.hero.note}
          </p>
        )
      }
    </div>
  </section>

  <!-- open-to-everyone packages -->
  {
    shown(m.packages) && shown(membership.packages) && (
      <section class="relative bg-ink py-20 md:py-24">
        <div class="pointer-events-none absolute inset-0 glow-gold" aria-hidden="true" />
        <div class="wrap relative">
          <TreatmentPackages />
        </div>
      </section>
    )
  }

  <!-- Comparison table -->
  {
    shown(m.comparison) && rows.length > 0 && tiers.length > 0 && (
      <section class="hairline-t bg-ink2 py-24 md:py-32">
        <div class="wrap">
          <div class="max-w-2xl" data-reveal>
            <p class="eyebrow">{m.comparison.eyebrow}</p>
            <h2 class="mt-5 font-serif text-4xl leading-tight text-cream md:text-5xl">
              <Copy text={m.comparison.heading} em="text-gold" italic sup="text-[0.45em] text-gold" />
            </h2>
          </div>

          <div class="hairline mt-14 overflow-x-auto bg-ink" data-reveal>
            <table class="w-full min-w-[720px] text-left text-sm">
              <thead>
                <tr class="hairline-b">
                  <th class="px-6 py-5 text-[11px] font-semibold tracking-[0.18em] text-cream/62 uppercase">
                    {m.comparison.featureLabel}
                  </th>
                  {tiers.map((tier) => (
                    <th
                      class:list={[
                        'px-6 py-5 font-serif text-lg font-medium',
                        tier.highlight ? 'bg-gold/[0.06] text-gold' : 'text-cream',
                      ]}
                    >
                      <Copy text={tier.name} sup="text-[0.45em]" />
                      {tier.price && (
                        <span class:list={['ml-2 text-xs', tier.highlight ? 'text-gold/85' : 'text-cream/62']}>
                          {tier.price}
                        </span>
                      )}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {rows.map((row) => (
                  <tr class="border-b border-cream/[0.06] last:border-0">
                    <td class="px-6 py-4 text-cream/75">
                      <Copy text={row.feature} />
                    </td>
                    {row.cells.map((cell, i) => (
                      <td
                        class:list={[
                          'px-6 py-4',
                          tiers[i].highlight ? 'bg-gold/[0.06] text-cream/90' : 'text-cream/75',
                        ]}
                      >
                        {cell}
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {m.comparison.note && (
            <p class="mt-8 text-[11px] tracking-[0.16em] text-cream/62 uppercase" data-reveal>
              {m.comparison.note}
            </p>
          )}
        </div>
      </section>
    )
  }

  <!-- The Platinum experience — concierge -->
  {shown(m.concierge) && <ConciergeSection variant="full" />}

  <!-- FAQ -->
  {
    shown(m.faqs) && m.faqs.items.length > 0 && (
      <section class="hairline-t bg-ink py-24 md:py-32">
        <div class="wrap grid grid-cols-1 gap-14 lg:grid-cols-12">
          <div class="lg:col-span-4" data-reveal>
            <p class="eyebrow">{m.faqs.eyebrow}</p>
            <h2 class="mt-5 font-serif text-4xl leading-tight text-cream">
              <Copy text={m.faqs.heading} em="text-gold" italic sup="text-[0.45em] text-gold" />
            </h2>
          </div>
          <div class="space-y-4 lg:col-span-8" data-reveal-child>
            {m.faqs.items.map((faq) => (
              <details class="faq hairline bg-ink2 px-7">
                <summary class="flex items-center justify-between gap-6 py-6">
                  <span class="font-serif text-xl text-cream">{faq.q}</span>
                  <span class="faq-icon shrink-0 text-xl font-light text-gold" aria-hidden="true">
                    ＋
                  </span>
                </summary>
                <p class="hairline-t pt-5 pb-7 text-sm leading-[1.85] text-cream/75">{faq.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <FinalCTA heading={m.finalCta.heading} sub={m.finalCta.sub} />
</Base>
