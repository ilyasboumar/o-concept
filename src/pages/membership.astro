---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import MembershipTiers from '../components/MembershipTiers.astro';
import TreatmentPackages from '../components/TreatmentPackages.astro';
import ConciergeSection from '../components/ConciergeSection.astro';
import FinalCTA from '../components/FinalCTA.astro';

/* Membership pricing is by application — table shows structure, numbers drop in later */
const comparison = [
  { feature: 'Endo Test diagnostic panel', silver: 'Annual', gold: 'Biannual', platinum: 'Quarterly' },
  { feature: 'Review consultations', silver: 'Quarterly', gold: 'Monthly', platinum: 'On demand' },
  { feature: 'Treatment session credits', silver: '—', gold: '1 per month', platinum: '2 per month' },
  { feature: 'Maintenance ESWT sessions', silver: '2 per year', gold: '4 per year', platinum: 'As prescribed' },
  { feature: 'Hormone & nutrition optimisation reviews', silver: '—', gold: '✓', platinum: '✓' },
  { feature: 'Member rate on treatments', silver: '✓', gold: '✓✓', platinum: '✓✓✓' },
  { feature: 'Priority appointments', silver: 'Priority line', gold: '48 hours', platinum: 'Same day' },
  { feature: 'Dedicated care coordinator', silver: '—', gold: '✓', platinum: '✓' },
  { feature: 'Reviews led personally by Dr Wakil', silver: '—', gold: '—', platinum: '✓' },
  { feature: 'The O Concept™ Concierge — door-to-door', silver: '—', gold: '—', platinum: '✓' },
  { feature: 'At-home phlebotomy', silver: '—', gold: '—', platinum: '✓' },
  { feature: 'Partner assessment included', silver: '—', gold: '—', platinum: '✓' },
  { feature: 'Discreet direct line, 7 days', silver: '—', gold: '—', platinum: '✓' },
];

const faqs = [
  {
    q: 'Is my membership — and everything discussed — confidential?',
    a: 'Entirely. Your records are held under strict medical confidentiality, correspondence is unmarked, invoices are discreetly worded, and private entrance appointments are available on request. Nothing is ever shared without your explicit written consent.',
  },
  {
    q: 'What does "by application" mean?',
    a: 'Membership places are limited so the clinical team can genuinely know every member. You apply, we hold a brief confidential conversation about your goals and diagnostics, and Dr Wakil’s team confirms the tier that fits. Pricing is confirmed at application.',
  },
  {
    q: 'Do I need a membership to be treated?',
    a: 'No. The O Concept™ is open to everyone — single treatments and bundled packages are available to all patients, with 0% finance, and the standard of care is identical. Membership adds continuity: scheduled diagnostics, priority access and ongoing optimisation.',
  },
  {
    q: 'Do you offer finance?',
    a: 'Yes. 0% finance is available on all treatment plans, subject to status, and memberships are billed monthly with no long-term lock-in. Our patient care team will structure whatever arrangement suits you best.',
  },
  {
    q: 'Can I pause or cancel my membership?',
    a: 'Of course. Memberships run month to month after an initial three-month term. You may pause for up to three months a year — travel, work, life — and cancellation requires only 30 days’ notice, in writing or by phone.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="Membership — Silver, Gold & Platinum | The O Concept™, Harley Street"
  description="Silver, Gold and Platinum: head-to-toe health memberships with comprehensive diagnostics, priority access and ongoing optimisation — plus open-to-everyone treatment packages with 0% finance. Dr SW Clinics, 77 Harley Street."
  schema={[faqSchema]}
>
  <PageHero
    eyebrow="Membership"
    title="Care that <em class='text-gold'>continues.</em>"
    sub="Silver, Gold and Platinum — three tiers of head-to-toe health investment: comprehensive diagnostics, priority access, and optimisation that never stands still. Each by application."
  />

  <section class="relative bg-ink py-24 md:py-32">
    <div class="pointer-events-none absolute inset-0 glow-gold" aria-hidden="true"></div>
    <div class="wrap relative">
      <MembershipTiers />
      <p class="mt-12 text-center text-[10px] tracking-[0.25em] text-cream/35 uppercase" data-reveal>
        Pricing confirmed at application · No joining fees · Prototype placeholders shown
      </p>

      <!-- open-to-everyone packages -->
      <div class="mt-20">
        <TreatmentPackages />
      </div>
    </div>
  </section>

  <!-- Comparison table -->
  <section class="hairline-t bg-ink2 py-24 md:py-32">
    <div class="wrap">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">Compare in detail</p>
        <h2 class="mt-5 font-serif text-4xl leading-tight text-cream md:text-5xl">Every benefit, side by side.</h2>
      </div>

      <div class="hairline mt-14 overflow-x-auto bg-ink" data-reveal>
        <table class="w-full min-w-[720px] text-left text-sm">
          <thead>
            <tr class="hairline-b">
              <th class="px-6 py-5 text-[10px] font-semibold tracking-[0.3em] text-cream/45 uppercase">Benefit</th>
              <th class="px-6 py-5 font-serif text-lg font-medium text-cream">Silver <span class="ml-2 text-xs text-cream/40">From £— pm</span></th>
              <th class="bg-gold/[0.06] px-6 py-5 font-serif text-lg font-medium text-gold">Gold <span class="ml-2 text-xs text-gold/60">From £— pm</span></th>
              <th class="px-6 py-5 font-serif text-lg font-medium text-cream">Platinum <span class="ml-2 text-xs text-cream/40">From £— pm</span></th>
            </tr>
          </thead>
          <tbody>
            {
              comparison.map((row) => (
                <tr class="border-b border-cream/[0.06] last:border-0">
                  <td class="px-6 py-4 text-cream/70">{row.feature}</td>
                  <td class="px-6 py-4 text-cream/55">{row.silver}</td>
                  <td class="bg-gold/[0.06] px-6 py-4 text-cream/85">{row.gold}</td>
                  <td class="px-6 py-4 text-cream/55">{row.platinum}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-8 text-[10px] tracking-[0.25em] text-cream/35 uppercase" data-reveal>
        All membership pricing by application — placeholder structure shown
      </p>
    </div>
  </section>

  <!-- The Platinum experience — concierge -->
  <ConciergeSection variant="full" />

  <!-- FAQ -->
  <section class="hairline-t bg-ink py-24 md:py-32">
    <div class="wrap grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-4" data-reveal>
        <p class="eyebrow">Questions, answered</p>
        <h2 class="mt-5 font-serif text-4xl leading-tight text-cream">Asked quietly, often.</h2>
        <p class="mt-6 text-sm leading-relaxed text-cream/55">
          Anything we haven&rsquo;t covered, our patient care team will answer in complete confidence on
          <a href="tel:+442030068459" class="text-gold">+44 (0)20 3006 8459</a>.
        </p>
      </div>
      <div class="space-y-4 lg:col-span-8" data-reveal-child>
        {
          faqs.map((faq) => (
            <details class="faq hairline bg-ink2 px-7">
              <summary class="flex items-center justify-between gap-6 py-6">
                <span class="font-serif text-xl text-cream">{faq.q}</span>
                <span class="faq-icon shrink-0 text-xl font-light text-gold" aria-hidden="true">＋</span>
              </summary>
              <p class="hairline-t pt-5 pb-7 text-sm leading-[1.85] text-cream/60">{faq.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <FinalCTA heading="Apply, quietly." sub="Begin with a consultation and Endo Test — the right tier will make itself obvious." />
</Base>
