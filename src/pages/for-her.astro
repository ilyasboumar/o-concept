---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Journey from '../components/Journey.astro';
import FinalCTA from '../components/FinalCTA.astro';

const treatments = [
  {
    name: 'O-Shot®',
    tag: 'Regenerative',
    desc: 'Platelet-rich plasma therapy for sensation, natural lubrication and urinary confidence — brought to the UK by Dr Wakil.',
  },
  {
    name: 'ThermiVa',
    tag: 'Radiofrequency',
    desc: 'Gentle radiofrequency for tissue laxity and comfort, with no downtime and no anaesthetic required.',
  },
  {
    name: 'CO2RE Intima',
    tag: 'Laser',
    desc: 'Fractional CO2 laser restoring mucosal health — particularly valued after childbirth and through menopause.',
  },
  {
    name: 'Ultra Femme 360',
    tag: 'Radiofrequency',
    desc: 'Complete 360° radiofrequency rejuvenation, internal and external, in a course of comfortable eight-minute sessions.',
  },
  {
    name: 'Clitoxin™',
    tag: 'Signature',
    desc: 'A pioneering protocol developed by Dr Wakil to enhance sensation and ease of arousal — precise and discreet.',
  },
  {
    name: 'O Concept™ Chair for Her',
    tag: 'Non-invasive',
    desc: 'Electromagnetic pelvic-floor strengthening for continence and sensation. Fully clothed, entirely comfortable.',
  },
  {
    name: 'DAFNE',
    tag: 'Signature',
    desc: 'Dr Wakil’s signature multi-layer rejuvenation of the external intimate area — tone, volume and skin quality.',
  },
];
---

<Base
  title="The O Concept™ for Her — Female Intimate Health | Harley Street"
  description="Restorative intimate health for women — O-Shot®, Ultra Femme 360, CO2RE Intima and more, delivered gently and confidentially on Harley Street."
>
  <PageHero
    theme="rose"
    eyebrow="The O Concept™ for Her"
    title="Your story <em class='text-rose'>matters here.</em>"
    sub="Childbirth, menopause, time — a woman's body carries every chapter. Comfort, sensation and confidence are not luxuries to be endured without; they can be gently, medically restored."
  />

  <section class="bg-ink py-24 md:py-32">
    <div class="wrap">
      <div class="grid gap-12 lg:grid-cols-12" data-reveal>
        <div class="lg:col-span-5">
          <p class="text-[11px] font-semibold tracking-[0.35em] text-rose uppercase">Heard, first</p>
          <h2 class="mt-5 font-serif text-4xl leading-tight text-cream">Medicine that listens before it treats.</h2>
        </div>
        <div class="space-y-6 text-[15px] leading-[1.9] text-cream/65 lg:col-span-7">
          <p>
            So many women are told their symptoms are simply "part of life" — dryness, discomfort, changes in
            sensation, moments of leakage that quietly reorganise a whole day. They are not character traits. They
            are treatable clinical conditions.
          </p>
          <p>
            The O Concept™ for Her combines regenerative injectables, radiofrequency, laser and pelvic-floor
            technologies into one gentle, evidence-led programme — designed by a physician who has devoted twenty
            years to this field, and delivered by a team who understand what it takes to walk through our door.
          </p>
        </div>
      </div>

      <div class="mt-20 grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-reveal-child>
        {
          treatments.map((t) => (
            <div class="group flex flex-col border border-rose/20 bg-ink2 p-8 transition-colors duration-500 hover:border-rose/60">
              <span class="text-[9px] font-bold tracking-[0.3em] text-rose/80 uppercase">{t.tag}</span>
              <h3 class="mt-4 font-serif text-2xl text-cream">{t.name}</h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-cream/55">{t.desc}</p>
              <a href="#" class="mt-7 inline-flex items-center gap-3 text-[10px] font-semibold tracking-[0.25em] text-rose uppercase">
                Learn more <span class="transition-transform duration-500 group-hover:translate-x-1.5">→</span>
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Journey />
  <FinalCTA heading="Gently, and in your own time." sub="A confidential conversation with a female member of our care team is always available on request." />
</Base>
