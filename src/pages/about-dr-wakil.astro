---
/**
 * About Dr Sherif Wakil.
 *
 * Every word, photograph, credential, milestone and award badge on this page
 * comes from src/content/pages/about.json, and the clinical team from the same
 * file. Teaching & speaking is shared with the Training page and lives in
 * teaching.json; the curriculum and the congress list stay one file per entry
 * in their own collections, so adding a lecture is adding a file.
 *
 * Each block has a show switch, and every list is an array: add a credential,
 * reorder the milestones, remove a team member who has moved on.
 */
import Base from '../layouts/Base.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Reassurance from '../components/Reassurance.astro';
import TeachingRecord from '../components/TeachingRecord.astro';
import Team from '../components/Team.astro';
import Copy from '../components/Copy.astro';
import AwardRing from '../components/AwardRing.astro';
import { imageUrl } from '../lib/url';
import { aboutPage as a } from '../data/pages';
import { shown } from '../data/home';

---

<Base
  title="About Dr Sherif Wakil — Founder, The O Concept™ | Dr SW Clinics"
  description="Dr Sherif El Wakil: founder of Dr SW Clinics on Harley Street, pioneer of sexual rejuvenation medicine in the UK, creator of The O Concept™ and founder of the IAAGSW."
>
  <!-- ============ HERO — name + portrait + ALL awards in an interactive 3D ring ============ -->
  <section class="relative -mt-20 overflow-hidden bg-ink2 pt-28 pb-10 md:pt-32 md:pb-12">
    <div
      class="pointer-events-none absolute inset-0"
      style="background:
        radial-gradient(ellipse 75% 65% at 30% 0%, rgba(201,169,110,0.13), transparent 65%),
        radial-gradient(ellipse 45% 40% at 85% 90%, rgba(45,212,191,0.05), transparent 70%);"
      aria-hidden="true"
    >
    </div>

    <div class="wrap relative grid grid-cols-1 items-center gap-8 lg:grid-cols-12 lg:gap-12">
      <div class="min-w-0 lg:col-span-8">
        <p class="eyebrow" data-reveal>{a.hero.eyebrow}</p>
        <h1 class="mt-5 font-serif text-5xl leading-[1.03] text-cream sm:text-6xl md:text-7xl" data-reveal data-delay="0.1">
          <Copy text={a.hero.heading} em="text-gold" italic sup="text-[0.4em] text-gold" />
        </h1>
        <p class="mt-5 max-w-xl font-serif text-xl leading-snug text-cream/90 text-balance sm:text-2xl md:text-[1.65rem]" data-reveal data-delay="0.2">
          <Copy text={a.hero.tagline} em="text-gold" italic sup="text-[0.5em] text-gold" />
        </p>
      </div>

      <div class="lg:col-span-4" data-reveal data-delay="0.15">
        <figure class="hairline mx-auto max-w-[15rem] p-2 lg:mx-0 lg:ml-auto">
          <div class="overflow-hidden">
            <img
              src={imageUrl(a.hero.portrait.image)}
              alt={a.hero.portrait.alt}
              class="aspect-[4/5] w-full object-cover object-[42%_top]"
              fetchpriority="high"
            />
          </div>
          <figcaption class="px-2 pt-3 pb-1 text-[11px] tracking-[0.16em] text-cream/62 uppercase">
            {a.hero.portrait.caption}
          </figcaption>
        </figure>
      </div>
    </div>

    <!-- every award, in one interactive 3D ring — drag to spin, arrows to rotate -->
    <AwardRing />
  </section>

  <!-- ============ BIO ============ -->
  {
    shown(a.physician) && (
      <section class="bg-ink py-24 md:py-32">
        <div class="wrap grid grid-cols-1 gap-14 lg:grid-cols-12 lg:gap-20">
          <div class="lg:col-span-7" data-reveal>
            <p class="eyebrow">{a.physician.eyebrow}</p>
            <h2 class="mt-5 font-serif text-4xl leading-tight text-cream md:text-5xl">
              <Copy text={a.physician.heading} em="text-gold" italic sup="text-[0.45em] text-gold" />
            </h2>
            <div class="mt-8 space-y-6 text-[16px] leading-[1.9] text-cream/75">
              {a.physician.paragraphs.map((para) => (
                <p>
                  <Copy text={para} em="text-gold" />
                </p>
              ))}
            </div>
          </div>

          <div class="lg:col-span-5" data-reveal data-delay="0.15">
            <div class="hairline p-2">
              <div class="overflow-hidden">
                <img
                  src={imageUrl(a.physician.photo.image)}
                  alt={a.physician.photo.alt}
                  class="aspect-[4/5] w-full object-cover object-[68%_center]"
                  loading="lazy"
                />
              </div>
            </div>
            {a.physician.photo.caption && (
              <p class="mt-4 text-[11px] tracking-[0.16em] text-cream/62 uppercase">{a.physician.photo.caption}</p>
            )}
          </div>
        </div>

        {/* credentials strip */}
        {shown(a.credentials) && a.credentials.items.length > 0 && (
          <div class="wrap mt-20">
            <p class="eyebrow" data-reveal>{a.credentials.eyebrow}</p>
            <ul class="mt-8 flex flex-wrap gap-3" data-reveal-child>
              {a.credentials.items.map((credential) => (
                <li class="hairline px-5 py-3 text-[12px] font-medium tracking-[0.14em] text-cream/75 uppercase">
                  {credential}
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>
    )
  }

  <!-- ============ MILESTONES ============ -->
  {shown(a.milestones) && a.milestones.items.length > 0 && (
  <section class="hairline-t bg-ink2 py-24 md:py-32">
    <div class="wrap">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">{a.milestones.eyebrow}</p>
        <h2 class="mt-5 font-serif text-4xl leading-tight text-cream md:text-5xl">
          <Copy text={a.milestones.heading} em="text-gold" italic sup="text-[0.45em] text-gold" />
        </h2>
      </div>

      <div class="relative mt-16 pl-8 md:pl-12">
        <div class="absolute top-1 left-[5px] h-full w-px bg-cream/10 md:left-[7px]" aria-hidden="true"></div>
        <div class="absolute top-1 left-[5px] h-full w-px bg-gold md:left-[7px]" data-line-draw-y aria-hidden="true"></div>
        <ol class="space-y-12" data-reveal-child>
          {
            a.milestones.items.map((m) => (
              <li class="relative">
                <span class="absolute top-1.5 -left-8 block h-[11px] w-[11px] rounded-full border border-gold bg-ink md:-left-12 md:h-[15px] md:w-[15px]" aria-hidden="true" />
                <p class="font-serif text-3xl text-gold">
                  <Copy text={m.mark} sup="text-[0.45em]" />
                </p>
                <p class="mt-2 max-w-2xl text-[16px] leading-relaxed text-cream/75">
                  <Copy text={m.text} em="text-gold" />
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>
  )}

  <!-- (The former static award wall was removed — the hero's 3D ring is now the
       single, complete awards presentation; milestones above carry the depth.) -->

  <!-- ============ OUR PROMISE ============ -->
  {shown(a.promise) && (
  <section class="hairline-t relative overflow-hidden bg-ink2 py-24 md:py-32">
    <div class="pointer-events-none absolute inset-0 glow-gold" aria-hidden="true"></div>
    <div class="wrap relative grid grid-cols-1 items-center gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-5" data-reveal>
        <figure class="hairline p-2">
          <div class="overflow-hidden">
            <img
              src={imageUrl(a.promise.photo.image)}
              alt={a.promise.photo.alt}
              class="aspect-[4/5] w-full object-cover"
              loading="lazy"
              data-parallax="-4"
            />
          </div>
          {a.promise.photo.caption && (
            <figcaption class="px-2 pt-3 pb-1 text-[11px] font-semibold tracking-[0.18em] text-cream/62 uppercase">
              {a.promise.photo.caption}
            </figcaption>
          )}
        </figure>
      </div>
      <div class="lg:col-span-7">
        <p class="eyebrow" data-reveal>{a.promise.eyebrow}</p>
        <h2 class="mt-5 font-serif text-4xl leading-tight text-cream md:text-5xl" data-reveal data-delay="0.1">
          <Copy text={a.promise.heading} em="text-gold" italic sup="text-[0.45em] text-gold" />
        </h2>
        <div class="mt-7 space-y-5 text-[16px] leading-[1.9] text-cream/75" data-reveal data-delay="0.2">
          {a.promise.paragraphs.map((para) => (
            <p>
              <Copy text={para} em="text-gold" />
            </p>
          ))}
        </div>
        <ul class="mt-8 flex flex-wrap gap-3" data-reveal-child>
          {
            a.promise.chips.map((item) => (
              <li class="hairline px-5 py-3 text-[11px] font-semibold tracking-[0.13em] text-gold/85 uppercase">{item}</li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
  )}

  {shown(a.team) && <Team />}

  <TeachingRecord />

  <Reassurance variant="authority" surface="ink2" accent="gold" />

  <FinalCTA heading={a.finalCta.heading} sub={a.finalCta.sub} />
</Base>
